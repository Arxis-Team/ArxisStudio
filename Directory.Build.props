<Project>

    <!--
        Общие настройки проектов студии. Всё в этом репозитории — net10.0:
        это приложение и его модули, а не публикуемые библиотеки.
        Субмодули в external/ живут по своим правилам и сюда не заглядывают.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <!-- Сборка проходит с 0 предупреждений; аудит NuGet выведен из-под правила. -->
    <PropertyGroup>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    </PropertyGroup>

    <PropertyGroup>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!--
        Кем и когда собрано. Заставка, «О программе» и журнал берут это отсюда,
        а не из строк в разметке: строка, переписываемая руками в трёх местах,
        разъезжается на первом же релизе.

        Релиз — то, чем версию называет человек (2026.1); сборка — чем её
        называет загрузчик (0.1.1). Это разные числа, и путать их нельзя:
        релиз меняется раз в квартал, сборка — каждой правкой.
    -->
    <PropertyGroup>
        <ArxisRelease>2026.1</ArxisRelease>
        <Version>0.1.1</Version>
        <Company>Arxis</Company>
        <Product>ArxisStudio</Product>
        <Copyright>© 2026 Arxis</Copyright>

        <!--
            Версия сборки не двигается — никогда. Плагин собирается против
            ArxisStudio.Sdk и запоминает его имя вместе с версией; сдвинув её,
            студия перестаёт быть тем, на что он ссылался, и каждый уже
            установленный плагин падает при загрузке с «Could not load file or
            assembly». Проверено дорогой ценой: сдвиг на 0.1.1 уронил плагин у
            человека, который просто обновил студию.

            Меняется то, что версией называют люди: FileVersion и
            InformationalVersion идут от Version выше, и заставка берёт их. Для
            совместимости у плагинов есть своя мера — sdk.min в манифесте.
        -->
        <AssemblyVersion>1.0.0.0</AssemblyVersion>

        <!--
            Версия файла задаётся явно, а не оставляется по умолчанию: без этой
            строки она идёт следом за версией сборки, то есть за закреплённой
            единицей, — и заставка показывала бы «сборка 1.0.0» при любой правке.
        -->
        <FileVersion>$(Version)</FileVersion>
    </PropertyGroup>

    <ItemGroup>
        <AssemblyMetadata Include="Release" Value="$(ArxisRelease)"/>
    </ItemGroup>

</Project>
