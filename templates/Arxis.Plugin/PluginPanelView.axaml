<!--
    Разметка панели. По умолчанию словарь студии: контрол без префикса — её
    контрол. Всё родное Avalonia пишется через a: — и раскладка, и привязка, —
    так видно, чего в наборе Ax* ещё нет.

    Подписи ставит {Text ключ}: это привязка к словарю плагина, и смена языка
    в студии перерисует панель. Ключи — из lang/strings.json; ключа нет —
    анализатор скажет об этом при сборке.
-->
<AxUserControl xmlns="https://github.com/Arxis-Team/ArxisStudio"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:a="https://github.com/avaloniaui"
               x:Class="Arxis.MyPlugin.PluginPanelView">

  <a:StackPanel Spacing="10" Margin="12" VerticalAlignment="Top">
    <a:TextBlock Text="{Text panel.hint}" TextWrapping="Wrap"/>
    <AxButton Content="{Text command.hello}" HorizontalAlignment="Left" Click="OnHelloClick"/>
  </a:StackPanel>

</AxUserControl>
