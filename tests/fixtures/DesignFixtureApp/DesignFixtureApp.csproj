<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Подопытный проект для тестов дизайнера: настоящее приложение Avalonia,
        которое студия открывает так же, как открыла бы проект пользователя.
        Синтетическая разметка в строке этого не заменяет — половина работы
        дизайнера как раз в том, чтобы найти сборки проекта и разобрать
        документ с x:Class.
    -->
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <RootNamespace>DesignFixtureApp</RootNamespace>
        <AssemblyName>DesignFixtureApp</AssemblyName>
        <IsTestProject>false</IsTestProject>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
        <PackageReference Include="Avalonia.Desktop"/>
        <PackageReference Include="Avalonia.Themes.Fluent"/>
    </ItemGroup>

</Project>
