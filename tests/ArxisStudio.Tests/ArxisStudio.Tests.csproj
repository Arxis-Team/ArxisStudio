<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Headless.XUnit"/>
        <PackageReference Include="Avalonia.Themes.Fluent"/>
        <PackageReference Include="Avalonia.Fonts.Inter"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="xunit.runner.visualstudio"/>
    </ItemGroup>

    <!--
        Подопытный проект дизайнера: собирается вместе с тестами, но в процесс
        тестов не подгружается — дизайнер должен найти его сборки сам, как нашёл
        бы проект пользователя.
    -->
    <ItemGroup>
        <ProjectReference Include="../fixtures/DesignFixtureApp/DesignFixtureApp.csproj"
                          ReferenceOutputAssembly="false"
                          SkipGetTargetFrameworkProperties="true"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/ArxisStudio/ArxisStudio.csproj"/>
        <ProjectReference Include="../../src/ArxisStudio.Extensibility/ArxisStudio.Extensibility.csproj"/>
        <ProjectReference Include="../../src/ArxisStudio.Shell/ArxisStudio.Shell.csproj"/>
    </ItemGroup>

</Project>
