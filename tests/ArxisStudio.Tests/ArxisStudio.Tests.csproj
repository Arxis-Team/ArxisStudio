<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <!-- Анализатор проверяется как обычная библиотека: тест сам собирает код. -->
    <ItemGroup>
        <ProjectReference Include="../../src/ArxisStudio.Sdk.Analyzers/ArxisStudio.Sdk.Analyzers.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp"/>
        <PackageReference Include="Avalonia.Headless.XUnit"/>
        <!--
            Skia нужна тестам, которые открывают картинки: headless-рисование
            декодер не зовёт вовсе, а выдаёт болванку нужного размера — на ней
            «прочиталось» и «не прочиталось» неразличимы.
        -->
        <PackageReference Include="Avalonia.Skia"/>
        <!--
            Разбор разметки на ходу: словарь xmlns проверяется по тому, что
            объявили сборки, а не по тому, что компилятор XAML однажды
            подставил в сгенерированный файл.
        -->
        <PackageReference Include="Avalonia.Markup.Xaml.Loader"/>
        <PackageReference Include="Avalonia.Fonts.Inter"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="xunit.runner.visualstudio"/>
    </ItemGroup>

    <!--
        Пример плагина собирается вместе с тестами, но его сборка тестам не
        нужна: проверяется не код примера, а раскладка и архив, которые оставил
        после себя таргет упаковки.
    -->
    <ItemGroup>
        <ProjectReference Include="../../src/Plugins/Arxis.HelloPlugin/Arxis.HelloPlugin.csproj"
                          ReferenceOutputAssembly="false"
                          SkipGetTargetFrameworkProperties="true"/>
        <ProjectReference Include="../../src/Plugins/Arxis.HelloFriend/Arxis.HelloFriend.csproj"
                          ReferenceOutputAssembly="false"
                          SkipGetTargetFrameworkProperties="true"/>
        <!--
            Пробный просмотрщик — тоже собирается и тоже не связывается: его
            типы тест видеть не должен. Он единственный в репозитории редактор
            документов и единственный плагин со своей пакетной зависимостью, и
            обе дороги проверяются на нём — открытие файла и раскладка пакета.
        -->
        <ProjectReference Include="../../src/Plugins/Arxis.CodeViewer/Arxis.CodeViewer.csproj"
                          ReferenceOutputAssembly="false"
                          SkipGetTargetFrameworkProperties="true"/>
        <!--
            Контракт примера — обычной ссылкой: тест доказывает идентичность
            типов, приводя объект плагина к СВОЕМУ IGreeter. Это и есть весь
            смысл контрактных сборок.
        -->
        <ProjectReference Include="../../src/Plugins/Arxis.Hello.Contracts/Arxis.Hello.Contracts.csproj"/>
    </ItemGroup>

    <!--
        Ядро модели проектов — общая сборка студии: тест сверяет его поверхность с
        записанной и видит его типы так же, как их видит плагин.

        Движки и локальная история названы следом и только ради того, чтобы их выход остался в
        папке модуля «Проекты», который их и везёт. Транзитивные ссылки у тестового проекта включены — ими
        сюда приезжает всё, на что ссылается модуль, — и пометка ExcludeAssets на ссылке самого
        модуля соседей по цепочке не касается: без этих двух строк движки легли бы у корня, а
        раскладка тестов разошлась бы с боевой ровно на них.
    -->
    <ItemGroup>
        <ProjectReference Include="../../external/ArxisStudio.ProjectSystem/src/ArxisStudio.ProjectSystem/ArxisStudio.ProjectSystem.csproj"/>

        <ProjectReference Include="../../external/ArxisStudio.ProjectSystem/src/ArxisStudio.ProjectSystem.MSBuild/ArxisStudio.ProjectSystem.MSBuild.csproj"
                          Private="false" ExcludeAssets="runtime"/>
        <ProjectReference Include="../../external/ArxisStudio.ProjectSystem/src/ArxisStudio.ProjectSystem.NuGet/ArxisStudio.ProjectSystem.NuGet.csproj"
                          Private="false" ExcludeAssets="runtime"/>
        <ProjectReference Include="../../src/ArxisStudio.LocalHistory/ArxisStudio.LocalHistory.csproj"
                          Private="false" ExcludeAssets="runtime"/>
    </ItemGroup>

    <!--
        Разметка студии едет в сборке тестов текстом: храповик
        LiteralSpacingTests считает отступы, написанные числом, а
        скомпилированная разметка чисел уже не показывает. Шаблон берётся
        звёздочкой, чтобы новый экран попадал под счёт сам, а не тогда, когда о
        нём вспомнят. Шаблоны проектов считаются наравне с экранами: автор
        плагина списывает отступы оттуда.
    -->
    <ItemGroup>
        <EmbeddedResource Include="../../src/**/*.axaml;../../templates/**/*.axaml"
                          Exclude="../../**/bin/**;../../**/obj/**"
                          LogicalName="axaml/%(RecursiveDir)%(Filename)%(Extension)"/>
        <!--
            Код самой студии — для того же счёта отступов, что и разметка. Модулей,
            плагинов и анализаторов здесь нет: у первых двух число в коде при сборке
            ловит ARX0010, а в третьих оно — примеры в описаниях правил.
        -->
        <EmbeddedResource Include="../../src/**/*.cs"
                          Exclude="../../**/bin/**;../../**/obj/**;../../src/Modules/**;../../src/Plugins/**;../../src/ArxisStudio.Sdk.Analyzers/**"
                          LogicalName="code/%(RecursiveDir)%(Filename)%(Extension)"/>
        <!--
            Код расширений, шаблона и общих библиотек — не для счёта отступов, а для сверки ключей
            темы, названных строкой: переименованный ключ молчит в любом из них одинаково. Контролы и
            значки лежат под разными приставками — у обеих библиотек есть свой Properties/AssemblyInfo.cs.
        -->
        <EmbeddedResource Include="../../src/Modules/**/*.cs;../../src/Plugins/**/*.cs;../../templates/**/*.cs"
                          Exclude="../../**/bin/**;../../**/obj/**"
                          LogicalName="code-extensions/%(RecursiveDir)%(Filename)%(Extension)"/>
        <EmbeddedResource Include="../../external/ArxisStudio.Controls/src/**/*.cs"
                          Exclude="../../**/bin/**;../../**/obj/**"
                          LogicalName="code-controls/%(RecursiveDir)%(Filename)%(Extension)"/>
        <EmbeddedResource Include="../../external/ArxisStudio.Icons/src/**/*.cs"
                          Exclude="../../**/bin/**;../../**/obj/**"
                          LogicalName="code-icons/%(RecursiveDir)%(Filename)%(Extension)"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/ArxisStudio.Docking/ArxisStudio.Docking.csproj"/>
        <ProjectReference Include="../../src/ArxisStudio/ArxisStudio.csproj"/>
        <ProjectReference Include="../../src/ArxisStudio.Extensibility/ArxisStudio.Extensibility.csproj"/>
        <ProjectReference Include="../../src/ArxisStudio.Shell/ArxisStudio.Shell.csproj"/>
    </ItemGroup>

    <!--
        Модули подключаются теми же пометками, что и в студии, и тем же таргетом раскладываются в
        папки: тесты обязаны идти по боевой раскладке, а не по её плоскому подобию. Своей папки у
        модуля в плоском выходе нет, а с ней нет и манифеста — один module.json не может служить
        четырём модулям. Дорогу к папкам процессу тестов показывает TestAssemblyFolders.

        Контракт службы проектов назван прямо и только для компиляции — так же, как в
        ArxisStudio.csproj: возит его модуль «Проекты», который объявил его в своём манифесте.
    -->
    <ItemGroup>
        <ProjectReference Include="../../src/Modules/ArxisStudio.Projects.Contracts/ArxisStudio.Projects.Contracts.csproj"
                          Private="false" ExcludeAssets="runtime"/>

        <ProjectReference Include="../../src/Modules/ArxisStudio.Modules.Sample/ArxisStudio.Modules.Sample.csproj"
                          StudioModule="true" Private="false" ExcludeAssets="runtime"/>
        <ProjectReference Include="../../src/Modules/ArxisStudio.Modules.Terminal/ArxisStudio.Modules.Terminal.csproj"
                          StudioModule="true" Private="false" ExcludeAssets="runtime"/>
        <ProjectReference Include="../../src/Modules/ArxisStudio.Modules.Console/ArxisStudio.Modules.Console.csproj"
                          StudioModule="true" Private="false" ExcludeAssets="runtime"/>
        <ProjectReference Include="../../src/Modules/ArxisStudio.Modules.Projects/ArxisStudio.Modules.Projects.csproj"
                          StudioModule="true" Private="false" ExcludeAssets="runtime"/>
        <ProjectReference Include="../../src/Modules/ArxisStudio.Modules.Project/ArxisStudio.Modules.Project.csproj"
                          StudioModule="true" Private="false" ExcludeAssets="runtime"/>
    </ItemGroup>

    <Import Project="../../src/ArxisStudio/build/ArxisStudio.Modules.targets"/>

</Project>
