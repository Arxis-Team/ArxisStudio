<Project>
  <!-- Централизованные версии пакетов: одна цифра на решение. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Markup.Xaml.Loader" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.1" />
  </ItemGroup>
  <ItemGroup>
    <!--
        Декодер, которым рисует Avalonia.Skia: окно проекта спрашивает у него
        размер картинки по заголовку. Версия — ровно та, что приезжает с
        Avalonia.Skia, и двигается только вместе с ней: сама сборка едет со
        студией, а модуль ссылается на неё лишь для компиляции.
    -->
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>
  <ItemGroup>
    <!--
        Текстовый редактор: своя зависимость пробного плагина-просмотрщика, а не
        общая сборка студии. Студия его не грузит и о нём не знает.
    -->
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!--
        Терминал: псевдотерминал под три ОС и эмулятор VT. Версии прибиты
        намеренно — обе библиотеки молодые, и обновлять их надо глядя, а не
        плавающим диапазоном.
    -->
    <PackageVersion Include="Porta.Pty" Version="2.2.2" />
    <PackageVersion Include="XTerm.NET" Version="2.0.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- Инструменты отладки интерфейса; подключаются только в Debug. -->
    <PackageVersion Include="AvaDevTools" Version="12.1.8" />
  </ItemGroup>
  <ItemGroup>
    <!-- Анализатор плагинов собирается против Roslyn. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>
</Project>
