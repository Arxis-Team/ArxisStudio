{
  "id": "arxis.hello",
  "name": "Hello",
  "version": "1.0.0",
  "publisher": "Arxis Labs",
  "description": "%plugin.description%",
  "icon": "assets/icon.png",
  "sdk": {
    "min": "3.0"
  },
  "entry": "bin/Arxis.HelloPlugin.dll",
  "provides": {
    "contracts": [ "bin/Arxis.Hello.Contracts.dll" ]
  },
  "contributions": {
    "commands": [
      {
        "id": "hello.greet"
      }
    ],
    "menus": [
      {
        "path": "%menu.tools%/%menu.hello%/%command.greet%",
        "command": "hello.greet"
      }
    ],
    "toolWindows": [
      {
        "id": "hello.panel",
        "title": "%panel.hello%",
        "placement": {
          "side": "right",
          "size": 0.24
        }
      }
    ],
    "settings": [
      {
        "key": "hello.greeting",
        "type": "string",
        "scope": "user",
        "title": "%setting.greeting%",
        "default": "Здравствуйте!"
      }
    ]
  },
  "activation": [
    "onCommand:hello.greet",
    "onToolWindow:hello.panel"
  ]
}
