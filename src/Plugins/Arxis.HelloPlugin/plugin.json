{
  "id": "arxis.hello",
  "name": "Hello",
  "version": "1.0.0",
  "publisher": "Arxis Labs",
  "description": "Пример внешнего плагина: панель и команда",
  "sdk": {
    "min": "1.0"
  },
  "entry": "bin/Arxis.HelloPlugin.dll",
  "contributions": {
    "commands": [
      {
        "id": "hello.greet",
        "title": "Поздороваться"
      }
    ],
    "menus": [
      {
        "path": "Tools/Hello/Поздороваться",
        "command": "hello.greet"
      }
    ],
    "toolWindows": [
      {
        "id": "hello.panel",
        "title": "Hello",
        "zone": "right"
      }
    ],
    "settings": [
      {
        "key": "hello.greeting",
        "type": "string",
        "scope": "user",
        "title": "Чем здороваться",
        "default": "Здравствуйте!"
      }
    ]
  },
  "activation": [
    "onCommand:hello.greet",
    "onToolWindow:hello.panel"
  ]
}
