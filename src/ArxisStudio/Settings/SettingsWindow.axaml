<ax:AxWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ax="https://github.com/Arxis-Team/ArxisStudio"
        xmlns:s="using:ArxisStudio.Settings"
        xmlns:vm="using:ArxisStudio.ViewModels"
        xmlns:conv="using:ArxisStudio.Converters"
        xmlns:ext="using:ArxisStudio.Extensibility"
        xmlns:loc="using:ArxisStudio.Shell.Localization"
        x:Class="ArxisStudio.Settings.SettingsWindow"
        x:DataType="s:SettingsViewModel"
        Title="{ax:Loc settings.title}"
        Width="1040" Height="680"
        MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterScreen">

  <!--
      Чем рисовать страницу, решает её тип, а не сама страница: так вёрстка
      остаётся в разметке, а модель страницы не держит контролов. Дойдёт дело
      до своих страниц у плагинов — добавится ещё один шаблон, который покажет
      их контрол; окно об этом не узнает.
  -->
  <ax:AxWindow.DataTemplates>

    <!--
        Оформление: тема, плотность и язык. Переехало из экрана настроек в Welcome.

        Страница плоская, как у Rider: без карточки и без линий между строками — строки
        разводит воздух. Каждая страница прокручивается сама: у плагинов их две, список и
        подробности, и общая прокрутка окна уводила бы обе разом.
    -->
    <DataTemplate DataType="s:AppearancePage">
      <ScrollViewer>
        <StackPanel Margin="{DynamicResource AxSettingsPagePadding}" Spacing="{DynamicResource AxGapFormRow}">
          <!--
              Подпись и контрол — ряд, а не док: док зазора не знает, и при крупном кегле
              подпись вставала к контролу вплотную. Ряд держит зазор сам, а когда тесно,
              ставит контрол под подпись. Колонка подписей одна на всё окно: контролы стоят
              линией возле подписей, а не у края широкого окна.
          -->
          <ax:WrapRow Classes="settings-row" Spacing="{DynamicResource AxGapFormRow}"
                      LeadWidth="{DynamicResource AxSettingsLabelWidth}" IsVisible="{Binding ShowsTheme}">
            <TextBlock Text="{ax:Loc settings.theme}" FontSize="{DynamicResource AxFontSize}" TextWrapping="Wrap"/>
            <ax:AxSegmentedControl AutomationProperties.Name="{ax:Loc settings.theme}"
                                   SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}">
              <ax:AxSegmentItem Content="{ax:Loc settings.theme.dark}"/>
              <ax:AxSegmentItem Content="{ax:Loc settings.theme.light}"/>
            </ax:AxSegmentedControl>
          </ax:WrapRow>
          <ax:WrapRow Classes="settings-row" Spacing="{DynamicResource AxGapFormRow}"
                      LeadWidth="{DynamicResource AxSettingsLabelWidth}" IsVisible="{Binding ShowsDensity}">
            <TextBlock Text="{ax:Loc settings.density}" FontSize="{DynamicResource AxFontSize}" TextWrapping="Wrap"/>
            <ax:AxSegmentedControl AutomationProperties.Name="{ax:Loc settings.density}"
                                   SelectedIndex="{Binding DensityIndex, Mode=TwoWay}">
              <ax:AxSegmentItem Content="{ax:Loc settings.density.compact}"/>
              <ax:AxSegmentItem Content="{ax:Loc settings.density.normal}"/>
              <ax:AxSegmentItem Content="{ax:Loc settings.density.comfortable}"/>
            </ax:AxSegmentedControl>
          </ax:WrapRow>
          <ax:WrapRow Classes="settings-row" Spacing="{DynamicResource AxGapFormRow}"
                      LeadWidth="{DynamicResource AxSettingsLabelWidth}" IsVisible="{Binding ShowsLanguage}">
            <TextBlock Text="{ax:Loc settings.language}" FontSize="{DynamicResource AxFontSize}" TextWrapping="Wrap"/>
            <!-- Список языков студия узнаёт на ходу, а не знает наперёд. -->
            <ax:AxComboBox Width="{DynamicResource AxSettingsFilterWidth}"
                           AutomationProperties.Name="{ax:Loc settings.language}"
                           ItemsSource="{Binding Languages}"
                           SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">
              <ax:AxComboBox.ItemTemplate>
                <DataTemplate x:DataType="loc:StudioLanguage">
                  <TextBlock Text="{Binding Name}"/>
                </DataTemplate>
              </ax:AxComboBox.ItemTemplate>
            </ax:AxComboBox>
          </ax:WrapRow>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>

    <!--
        Клавиши: все сочетания студии, чьи они и кому не досталось. Правок у
        страницы нет — сочетания меняют в keymap.json, и страница ведёт к нему.
        Отказы стоят над списком: это ответ на вопрос, с которым сюда и приходят, —
        «куда делось моё сочетание».

        Строка — как в keymap Rider: команда слева, сочетание плашкой клавиши за ней,
        откуда оно — третичным текстом. Колонки сочетаний и источников общие у обоих
        разделов, и плашки стоят одной линией.
    -->
    <DataTemplate DataType="s:KeysPage">
      <ScrollViewer>
        <StackPanel Margin="{DynamicResource AxSettingsPagePadding}" Spacing="{DynamicResource AxGapGroup}"
                    Grid.IsSharedSizeScope="True">
          <ax:WrapRow Spacing="{DynamicResource AxGapFormRow}">
            <TextBlock ax:AxText.Tone="Tertiary" VerticalAlignment="Center" TextWrapping="Wrap"
                       FontSize="{DynamicResource AxFontSizeSmall}"
                       Text="{ax:Loc keys.subtitle}"/>
            <!-- Под подписью кнопка встаёт своей ширины, а не полосой во всю страницу. -->
            <ax:AxButton Content="{ax:Loc keys.open}" ToolTip.Tip="{Binding File}"
                         HorizontalAlignment="Left"
                         Click="OnKeymapOpenClick"/>
          </ax:WrapRow>

          <StackPanel IsVisible="{Binding ShowsRefusals}">
            <ax:AxGroupHeader Content="{ax:Loc keys.refused}" Counter="{Binding ShownRefusals.Count}"/>
            <ItemsControl ItemsSource="{Binding ShownRefusals}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="s:KeyRefusal">
                  <Grid MinHeight="{DynamicResource AxRowHeight}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto" SharedSizeGroup="gesture"/>
                      <ColumnDefinition Width="Auto" SharedSizeGroup="source"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Command}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <ax:AxChip Grid.Column="1" Kind="Key" Content="{Binding Gesture}" HorizontalAlignment="Left"
                               Margin="{DynamicResource AxSpaceWideLeadingThickness}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" ax:AxText.Tone="Tertiary" Text="{Binding Winner}"
                               Margin="{DynamicResource AxSpaceWideLeadingThickness}" VerticalAlignment="Center"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel>
            <ax:AxGroupHeader Content="{ax:Loc keys.assigned}" Counter="{Binding ShownRows.Count}"/>
            <ItemsControl ItemsSource="{Binding ShownRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="s:KeyRow">
                  <Grid MinHeight="{DynamicResource AxRowHeight}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto" SharedSizeGroup="gesture"/>
                      <ColumnDefinition Width="Auto" SharedSizeGroup="source"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Command}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <ax:AxChip Grid.Column="1" Kind="Key" Content="{Binding Gesture}" HorizontalAlignment="Left"
                               Margin="{DynamicResource AxSpaceWideLeadingThickness}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" ax:AxText.Tone="Tertiary" Text="{Binding Source}"
                               Margin="{DynamicResource AxSpaceWideLeadingThickness}" VerticalAlignment="Center"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>

    <!--
        Плагины: менеджер расширений, приехавших со стороны. Переехал сюда из
        экрана Welcome целиком — вместе с карточкой и вопросами о зависимых.

        Вторичные действия под «…», а не под шестерёнкой, как у Rider:
        шестерёнка в этой студии уже занята — она открывает само это окно, и
        два разных смысла на один значок читались бы как один.
    -->
    <DataTemplate DataType="s:PluginsPage">
      <ScrollViewer>
      <DockPanel Margin="{DynamicResource AxSettingsPagePadding}">

        <DockPanel DockPanel.Dock="Top" Margin="{DynamicResource AxSpaceWideBelowThickness}">
          <ax:AxButton DockPanel.Dock="Right" Appearance="Toolbar"
                       AutomationProperties.Name="{ax:Loc plugins.actions}"
                       ToolTip.Tip="{ax:Loc plugins.actions}"
                       Click="OnPluginActionsClick">
            <ax:AxIcon Data="{x:Static ax:AxIcons.MoreHorizontal}"/>
          </ax:AxButton>
          <TextBlock ax:AxText.Tone="Tertiary" VerticalAlignment="Center" TextWrapping="Wrap"
                     FontSize="{DynamicResource AxFontSizeSmall}"
                     Text="{ax:Loc plugins.subtitle}"/>
        </DockPanel>

        <!-- Чем кончилось последнее действие: установка, обновление, снятие. -->
        <ax:AxCard DockPanel.Dock="Top" Margin="{DynamicResource AxSpaceWideBelowThickness}" Padding="{DynamicResource AxBannerPadding}"
                   IsVisible="{Binding HasStatus}">
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap"
                     FontSize="{DynamicResource AxFontSizeSmall}" AutomationProperties.LiveSetting="Polite"/>
        </ax:AxCard>

        <TextBlock DockPanel.Dock="Top" ax:AxText.Tone="Tertiary" TextWrapping="Wrap"
                   FontSize="{DynamicResource AxFontSizeSmall}"
                   Text="{ax:Loc plugins.empty}" IsVisible="{Binding IsEmpty}"/>

        <ax:AxCard Padding="0" VerticalAlignment="Top" IsVisible="{Binding !IsEmpty}">
          <ItemsControl ItemsSource="{Binding Cards}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PluginCard">
                <DockPanel IsVisible="{Binding IsShown}">
                  <ax:AxDivider DockPanel.Dock="Bottom"/>
                  <Border Padding="{DynamicResource AxSettingsRowPadding}">
                    <DockPanel>
                      <Border DockPanel.Dock="Left" Width="{DynamicResource AxPluginTileSize}" Height="{DynamicResource AxPluginTileSize}" Margin="{DynamicResource AxSpaceWideTrailingThickness}"
                              CornerRadius="{DynamicResource AxCornerRadiusLarge}"
                              Background="{DynamicResource AxSurfaceRaisedBrush}">
                        <Panel>
                          <!--
                              Значок — украшение: имя плагина стоит рядом текстом, и
                              экранный диктор, назвав картинку ещё раз, сказал бы
                              одно и то же дважды. Поэтому из дерева доступности
                              значок убран, а не назван.
                          -->
                          <Image x:Name="PluginIcon" Width="{DynamicResource AxAvatarSizeSmall}" Height="{DynamicResource AxAvatarSizeSmall}"
                                 AutomationProperties.AccessibilityView="Raw"
                                 RenderOptions.BitmapInterpolationMode="HighQuality"
                                 Source="{Binding Plugin.IconPath, Converter={x:Static conv:PluginIconConverter.Instance}}"/>
                          <!--
                              Общий значок показывается тогда, когда картинки нет:
                              не объявлена, потерялась или не прочиталась. Решает
                              сама картинка, а не путь к ней, — иначе объявленный
                              и битый файл оставлял бы на карточке пустое место.
                          -->
                          <ax:AxIcon Data="{x:Static ax:AxIcons.Package}"
                                     Foreground="{DynamicResource AxTintPurpleBrush}"
                                     IsVisible="{Binding #PluginIcon.Source, Converter={x:Static ObjectConverters.IsNull}}"/>
                        </Panel>
                      </Border>
                      <!--
                          Одна кнопка на оба действия, как в Rider: слева
                          «Включить»/«Выключить», под стрелкой — удаление.
                          Выключают часто, удаляют редко и навсегда, и держать
                          необратимое на расстоянии одного промаха от частого
                          незачем.
                      -->
                      <ax:AxSplitButton DockPanel.Dock="Right" MinWidth="{DynamicResource AxSettingsActionWidth}" MinHeight="{DynamicResource AxControlHeightCompact}" Margin="{DynamicResource AxSpaceLeadingThickness}"
                                        VerticalAlignment="Center" FontSize="{DynamicResource AxFontSizeSmall}"
                                        Click="OnPluginToggleClick" Tag="{Binding}"
                                        Content="{Binding IsOn, Converter={x:Static conv:PluginToggleConverter.Instance}}"
                                        IsVisible="{Binding Plugin.IsValid}">
                        <ax:AxSplitButton.Flyout>
                          <ax:AxMenuFlyout Placement="BottomEdgeAlignedRight">
                            <ax:AxMenuItem IsDestructive="True" Header="{ax:Loc plugins.remove}"
                                           Click="OnPluginRemoveClick" Tag="{Binding}"/>
                          </ax:AxMenuFlyout>
                        </ax:AxSplitButton.Flyout>
                      </ax:AxSplitButton>
                      <!--
                          Сломанному включать нечего — ему остаётся только уйти, и
                          кнопка у него своя: под стрелкой удаление было бы
                          спрятано за действием, которого у него нет.
                      -->
                      <ax:AxButton DockPanel.Dock="Right" MinHeight="{DynamicResource AxControlHeightSmall}" Margin="{DynamicResource AxSpaceLeadingThickness}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource AxFontSizeSmall}"
                                   Click="OnPluginRemoveClick" Tag="{Binding}"
                                   Content="{ax:Loc plugins.remove}"
                                   IsVisible="{Binding !Plugin.IsValid}"/>
                      <TextBlock DockPanel.Dock="Right" ax:AxText.Role="Code" ax:AxText.Tone="Tertiary" VerticalAlignment="Center"
                                 FontSize="{DynamicResource AxFontSizeSmall}"
                                 Text="{Binding Plugin.Manifest.Version}"/>
                      <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource AxGapControls}">
                          <TextBlock Text="{Binding Plugin.DisplayName}" FontWeight="SemiBold"
                                     FontSize="{DynamicResource AxFontSize}"/>
                          <TextBlock ax:AxText.Tone="Tertiary" VerticalAlignment="Bottom"
                                     FontSize="{DynamicResource AxFontSizeSmall}"
                                     Text="{Binding Plugin.Manifest.Publisher}"/>
                          <ax:AxChip Content="{ax:Loc plugins.broken}" IsVisible="{Binding !Plugin.IsValid}"/>
                          <!--
                              Манифест цел, а плагин не поднялся: сборка не читается или точка
                              входа падает. Без отметки он выглядел исправным, хотя не работал, а
                              журнал, где сказана причина, с Welcome не виден.
                          -->
                          <ax:AxChip Content="{ax:Loc plugins.unrisen}" IsVisible="{Binding HasRiseError}"/>
                          <!--
                              Отметка непринятого: галочку копят до «Сохранить», и
                              без неё человек не отличит выключенное от того, что
                              он только что решил выключить.
                          -->
                          <ax:AxChip Content="{ax:Loc plugins.pending}" IsVisible="{Binding IsChanged}"/>
                        </StackPanel>
                        <!-- Описание длиннее строки сокращается многоточием и читается целиком в подсказке. -->
                        <TextBlock ax:AxText.Tone="Secondary" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                   FontSize="{DynamicResource AxFontSizeSmall}"
                                   Text="{Binding Plugin.Description}" ToolTip.Tip="{Binding Plugin.Description}"/>
                        <TextBlock ax:AxText.Tone="Tertiary" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                   FontSize="{DynamicResource AxFontSizeSmall}"
                                   Text="{Binding Plugin.Error}" IsVisible="{Binding !Plugin.IsValid}"/>
                        <!-- Причина отказа — одной строкой, целиком в подсказке. -->
                        <TextBlock ax:AxText.Tone="Tertiary" TextTrimming="CharacterEllipsis"
                                   FontSize="{DynamicResource AxFontSizeSmall}"
                                   Text="{Binding RiseError}" ToolTip.Tip="{Binding RiseError}"
                                   IsVisible="{Binding HasRiseError}"/>

                        <!--
                            Метки: то, чем расширение назвало себя само. Известные
                            студия переводит, остальные показывает как написаны.
                        -->
                        <ItemsControl ItemsSource="{Binding Tags}" Margin="{DynamicResource AxSpaceTightAboveThickness}"
                                      IsVisible="{Binding HasTags}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource AxGapIconText}"/>
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <ax:AxChip Content="{Binding}"/>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Полнота перевода: у обычного плагина список пуст. -->
                        <ItemsControl ItemsSource="{Binding Plugin.Coverage}" Margin="{DynamicResource AxSpaceTightAboveThickness}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource AxGapIconText}"/>
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="ext:LanguageCoverage">
                              <ax:AxChip Content="{Binding Label}"/>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--
                            Зависимости: у большинства плагинов их нет. Обязательная
                            не в порядке подсвечивается — это ответ на вопрос
                            «почему плагин не поднялся».
                        -->
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource AxGapIconText}" Margin="{DynamicResource AxSpaceTightAboveThickness}"
                                    IsVisible="{Binding HasDependencies}">
                          <TextBlock ax:AxText.Tone="Tertiary" VerticalAlignment="Center"
                                     FontSize="{DynamicResource AxFontSizeSmall}"
                                     Text="{ax:Loc plugins.deps}"/>
                          <ItemsControl ItemsSource="{Binding Dependencies}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource AxGapIconText}"/>
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="ext:PluginDependencyState">
                                <ax:AxChip Classes="dependency" Classes.problem="{Binding IsProblem}" Content="{Binding Label}"/>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ax:AxCard>

      </DockPanel>
      </ScrollViewer>
    </DataTemplate>

    <!--
        Ветка расширений: своих настроек нет. Страница ветки перечисляет детей ссылками, как
        страница раздела в Rider: подсказка «выберите слева» говорила, куда идти, а ссылка ведёт.
    -->
    <DataTemplate DataType="s:ExtensionsPage">
      <ScrollViewer>
        <StackPanel Margin="{DynamicResource AxSettingsPagePadding}" Spacing="{DynamicResource AxGapControls}">
          <TextBlock ax:AxText.Tone="Tertiary" TextWrapping="Wrap"
                     FontSize="{DynamicResource AxFontSizeSmall}"
                     Text="{ax:Loc settings.extensions.hint}"/>
          <ItemsControl ItemsSource="{Binding Children}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="{DynamicResource AxGapControls}"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="s:ISettingsPage">
                <ax:AxLink Content="{Binding Title}" Tag="{Binding Id}" HorizontalAlignment="Left"
                           Click="OnPageLinkClick"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>

    <!--
        Страница расширения: строки, объявленные его манифестом.

        Флаг — флажок с подписью, как в Rider, а не тумблер: тумблер обещает, что сработает
        сразу, а правка здесь ждёт «Сохранить». Ключ настройки — в подсказке подписи: ищут его
        и так, а строкой под каждой подписью он удваивал страницу.
    -->
    <DataTemplate DataType="s:ExtensionPage">
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Rows}" Margin="{DynamicResource AxSettingsPagePadding}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="{DynamicResource AxGapFormRow}"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <!--
                Подпись строки — она же имя контрола для средств доступности:
                глазом её видно рядом, а диктор читает сам контрол и без имени
                объявляет «поле» — одинаково во всех строках подряд.
            -->
            <DataTemplate x:DataType="vm:PluginSettingRow">
              <StackPanel IsVisible="{Binding IsShown}">
                <ax:AxCheckBox IsChecked="{Binding Flag, Mode=TwoWay}" ToolTip.Tip="{Binding Key}"
                               AutomationProperties.Name="{Binding Label}"
                               IsEnabled="{Binding IsEditable}" IsVisible="{Binding IsToggle}">
                  <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
                </ax:AxCheckBox>
                <!-- Ряд, как у строк оформления: подпись в колонке подписей, поле за ней. -->
                <ax:WrapRow Classes="settings-row" Spacing="{DynamicResource AxGapFormRow}"
                            LeadWidth="{DynamicResource AxSettingsLabelWidth}" IsVisible="{Binding IsText}">
                  <TextBlock Text="{Binding Label}" FontSize="{DynamicResource AxFontSize}" TextWrapping="Wrap"
                             ToolTip.Tip="{Binding Key}"/>
                  <ax:AxTextBox Width="{DynamicResource AxSettingsFieldWidth}" Text="{Binding Text, Mode=TwoWay}"
                                AutomationProperties.Name="{Binding Label}"
                                IsEnabled="{Binding IsEditable}"/>
                </ax:WrapRow>
                <TextBlock ax:AxText.Tone="Tertiary" FontSize="{DynamicResource AxFontSizeSmall}" TextWrapping="Wrap"
                           Margin="{DynamicResource AxSpaceHairAboveThickness}"
                           Text="{Binding Note}"
                           IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DataTemplate>

  </ax:AxWindow.DataTemplates>

  <!--
      В шапке остаётся один крестик — так же, как у настроек Rider.

      Свернуть некуда: окно модальное, и пока оно открыто, хозяин не отвечает;
      свёрнутый ребёнок оставил бы человека перед неотзывчивой студией без
      видимой причины. Кнопка к тому же не делала обещанного — после нажатия
      WindowState оставался Normal.

      Развернуть можно и без кнопки: AxTitleBar разворачивает окно двойным
      щелчком по полосе и делает это сам, не глядя на кнопки. Дорога осталась,
      ушла только лишняя мишень в шапке диалога.

      Прячутся две кнопки поимённо, а не ShowWindowControls целиком: тот снял
      бы и закрытие, а закрытие диалогу нужно.
  -->
  <ax:AxWindow.Styles>
    <Style Selector="ax|AxWindowControls /template/ Button#PART_Minimize">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="ax|AxWindowControls /template/ Button#PART_Maximize">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
  </ax:AxWindow.Styles>

  <DockPanel>

    <ax:AxTitleBar DockPanel.Dock="Top">
      <TextBlock Text="{ax:Loc settings.title}" Margin="{DynamicResource AxSpaceWideSidesThickness}" VerticalAlignment="Center"
                 FontSize="{DynamicResource AxFontSizeSmall}" ax:AxText.Tone="Secondary"/>
    </ax:AxTitleBar>

    <!--
        Подвал: слева жалоба, если что-то не записалось, справа две кнопки.
        Окно после неудачного сохранения не закрывается — сказать «сохранено»
        о том, что не легло, хуже, чем остаться открытым.
    -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource AxSurfacePanelBrush}">
      <DockPanel Margin="{DynamicResource AxDialogBandPadding}">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="{DynamicResource AxGapControls}">
          <ax:AxButton x:Name="Cancel" Content="{ax:Loc common.cancel}" MinWidth="{DynamicResource AxDialogButtonMinWidth}"/>
          <ax:AxButton x:Name="Save" Appearance="Primary" Content="{ax:Loc common.save}" MinWidth="{DynamicResource AxDialogButtonMinWidth}"/>
        </StackPanel>
        <TextBlock Text="{Binding Complaint}" IsVisible="{Binding HasComplaint}"
                   ax:AxText.Tone="Error" TextWrapping="Wrap" VerticalAlignment="Center"
                   FontSize="{DynamicResource AxFontSizeSmall}"/>
      </DockPanel>
    </Border>
    <!--
        Линия над подвалом — разделитель, а не верхний край рамки: край толщиной в раскладочную
        единицу при 150 и 175 % выходил вдвое толще разделителей студии.
    -->
    <ax:AxDivider DockPanel.Dock="Bottom"/>

    <Grid ColumnDefinitions="Auto,Auto,*">

      <!-- Слева: поиск и дерево разделов. Ширина — как у боковой полосы Welcome. -->
      <Border Grid.Column="0" Width="{DynamicResource AxSettingsNavWidth}"
              Background="{DynamicResource AxSurfacePanelBrush}">
        <DockPanel Margin="{DynamicResource AxSpaceWideThickness}">
          <ax:AxSearchField DockPanel.Dock="Top" x:Name="SearchBox" Margin="{DynamicResource AxSpaceWideBelowThickness}"
                            AutomationProperties.Name="{ax:Loc settings.search}"
                            PlaceholderText="{ax:Loc settings.search}"
                            Text="{Binding Search, Mode=TwoWay}"/>

          <TextBlock DockPanel.Dock="Top" ax:AxText.Tone="Tertiary" Margin="{DynamicResource AxFieldNoteMargin}"
                     FontSize="{DynamicResource AxFontSizeSmall}"
                     Text="{ax:Loc settings.empty}" IsVisible="{Binding IsEmpty}"/>

          <ax:AxTreeView x:Name="Tree"
                         AutomationProperties.Name="{ax:Loc settings.title}"
                         ItemsSource="{Binding Nodes}"
                         SelectedItem="{Binding Selected, Mode=TwoWay}">
            <!--
                Ветки развёрнуты всегда. Разделов два, прятать нечего, а
                свёрнутая ветка ломает поиск: он оставляет её ради совпавшего
                ребёнка — и ребёнка не видно. Узлы пересобираются на каждый
                запрос, поэтому стиль, а не свойство узла: раскрытие,
                записанное в модели, всё равно пришлось бы ставить заново.
            -->
            <ax:AxTreeView.Styles>
              <Style Selector="ax|AxTreeViewItem" x:DataType="s:SettingsNode">
                <Setter Property="IsExpanded" Value="True"/>
                <!--
                    Имя строки для средств доступности: подпись живёт в
                    шаблоне шапки, а диктор читает сам узел и без имени
                    объявляет «элемент дерева» — одинаково у всех разделов.
                    Несохранённое — там же, состоянием строки: точку глазом
                    видно, а диктору о ней надо сказать словами.
                -->
                <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                <Setter Property="AutomationProperties.ItemStatus" Value="{Binding ModifiedStatus}"/>
              </Style>
            </ax:AxTreeView.Styles>

            <ax:AxTreeView.ItemTemplate>
              <TreeDataTemplate x:DataType="s:SettingsNode" ItemsSource="{Binding Children}">
                <!--
                    Правленый раздел отмечен точкой — тем же знаком, что изменённая вкладка
                    документа, и там же, где Rider отмечает раздел с непринятой правкой.
                -->
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource AxGapIconText}">
                  <ax:AxIcon Data="{Binding Icon}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                  <Ellipse Width="{DynamicResource AxTabModifiedDotSize}" Height="{DynamicResource AxTabModifiedDotSize}"
                           Fill="{DynamicResource AxAccentBrush}" VerticalAlignment="Center"
                           IsVisible="{Binding IsModified}"/>
                </StackPanel>
              </TreeDataTemplate>
            </ax:AxTreeView.ItemTemplate>
          </ax:AxTreeView>
        </DockPanel>
      </Border>

      <ax:AxDivider Grid.Column="1" Orientation="Vertical"/>

      <!--
          Справа: шапка страницы и сама страница. Шапка — как в настройках Rider: путь к
          странице, «Сбросить», пока на ней есть несохранённое, и стрелки по пройденным
          страницам. Что рисовать ниже — решает тип страницы, шаблоны выше.
      -->
      <DockPanel Grid.Column="2">
        <Border DockPanel.Dock="Top" MinHeight="{DynamicResource AxTabHeight}"
                Padding="{DynamicResource AxSettingsHeaderPadding}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                        Spacing="{DynamicResource AxGapControls}">
              <ax:AxLink x:Name="Reset" Content="{ax:Loc settings.reset}" VerticalAlignment="Center"
                         IsVisible="{Binding CanReset}"/>
              <StackPanel Orientation="Horizontal">
                <ax:AxButton x:Name="Back" Appearance="Toolbar"
                             AutomationProperties.Name="{ax:Loc settings.back}"
                             ToolTip.Tip="{ax:Loc settings.back}" ax:AxToolTip.Gesture="Alt+Left"
                             IsEnabled="{Binding CanGoBack}">
                  <ax:AxIcon Data="{x:Static ax:AxIcons.ChevronLeft}"/>
                </ax:AxButton>
                <ax:AxButton x:Name="Forward" Appearance="Toolbar"
                             AutomationProperties.Name="{ax:Loc settings.forward}"
                             ToolTip.Tip="{ax:Loc settings.forward}" ax:AxToolTip.Gesture="Alt+Right"
                             IsEnabled="{Binding CanGoForward}">
                  <ax:AxIcon Data="{x:Static ax:AxIcons.ChevronRight}"/>
                </ax:AxButton>
              </StackPanel>
            </StackPanel>
            <ax:AxBreadcrumb x:Name="Crumbs" VerticalAlignment="Center" ItemsSource="{Binding Path}"
                             AutomationProperties.Name="{ax:Loc settings.path}"/>
          </DockPanel>
        </Border>
        <ax:AxDivider DockPanel.Dock="Top"/>

        <ContentControl Content="{Binding Page}"/>
      </DockPanel>

    </Grid>

  </DockPanel>

</ax:AxWindow>
