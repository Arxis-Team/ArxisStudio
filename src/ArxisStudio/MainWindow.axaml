<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ax="using:ArxisStudio.Controls"
        xmlns:shell="using:ArxisStudio.Shell"
        xmlns:dock="using:ArxisStudio.Docking"
        xmlns:loc="using:ArxisStudio.Shell.Localization"
        x:Class="ArxisStudio.MainWindow"
        Title="ArxisStudio"
        Width="1440" Height="900"
        MinWidth="1360" MinHeight="700"
        WindowDecorations="BorderOnly">

  <!--
      Окно — только оболочка: дерево доков, заголовок и запуск. Всё остальное
      приходит модулями и плагинами через SDK — и дизайнер форм, и панель
      проекта, и консоль. Разметки ни одного из них здесь нет.

      Раскладку определяет человек, а не эта разметка: где какая панель стоит и
      какой она ширины, знает дерево доков, а оно приходит из файла раскладки.
  -->
  <shell:StudioShell>

    <!-- Верхний тулбар (42px): логотип, проект, меню команд, run-группа. -->
    <shell:StudioShell.TopBar>
      <ax:AxTitleBar BorderThickness="0">
        <DockPanel Margin="10,0">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Width="24" Height="24" CornerRadius="{DynamicResource AxCornerRadius}"
                  Background="{DynamicResource AxAccStrongBrush}">
            <TextBlock Text="Ax" FontSize="{DynamicResource AxFontSizeCaption}" FontWeight="Bold"
                       Foreground="{DynamicResource AxOnAccBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock x:Name="ProjectName" Text="{loc:Loc studio.noproject}" FontSize="{DynamicResource AxFontSize}" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock Classes="dim" Text="{loc:Loc studio.configuration}" FontSize="{DynamicResource AxFontSizeSmall}" VerticalAlignment="Center" Margin="8,0,0,0"/>

          <!-- Команды плагинов; кнопки нет, пока никто ничего не добавил. -->
          <ax:AxButton x:Name="MenuButton" Classes="icon" IsVisible="False" Margin="8,0,0,0"
                       AutomationProperties.Name="{loc:Loc menu.tools}"
                       ToolTip.Tip="{loc:Loc menu.tools}"
                       Click="OnMenuClick">
            <ax:AxIcon Data="{x:Static ax:AxIcons.MoreHorizontal}" IsFilled="True"/>
          </ax:AxButton>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
          <ax:AxSegmentedControl x:Name="ThemeSwitch" SelectionChanged="OnThemeChanged">
            <ax:AxSegmentItem Content="{loc:Loc settings.theme.dark}"/>
            <ax:AxSegmentItem Content="{loc:Loc settings.theme.light}"/>
          </ax:AxSegmentedControl>
        </StackPanel>
          <Panel/>
        </DockPanel>
      </ax:AxTitleBar>
    </shell:StudioShell.TopBar>

    <!--
        Рабочая область — дерево доков. Панели встают в него из манифестов, а
        документы открываются в названную группу; заставка достаётся ей же,
        пока в ней пусто.
    -->
    <dock:DockView x:Name="Dock">
      <dock:DockView.Empty>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
          <TextBlock Classes="dim" Text="ArxisStudio" FontSize="{DynamicResource AxFontSizeTitle}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock Classes="dimmer" Text="{loc:Loc studio.canvas.hint}"
                     FontSize="{DynamicResource AxFontSizeSmall}" HorizontalAlignment="Center"/>
        </StackPanel>
      </dock:DockView.Empty>
    </dock:DockView>

    <!-- Статус-бар: 24, как в макете экрана Editor. -->
    <shell:StudioShell.StatusBar>
      <DockPanel Height="{DynamicResource AxControlHeightCompact}" Margin="12,0">
        <TextBlock x:Name="StatusText" Classes="dim" Text="{loc:Loc studio.ready}" FontSize="{DynamicResource AxFontSizeSmall}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <!--
            Идущая задача: имя, чем занята, полоса и отмена. Место одно на всех
            плагинов — иначе каждый заведёт свою мельницу, и человек будет
            искать, где у кого что крутится.
        -->
        <StackPanel x:Name="TaskStrip" DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center" Margin="16,0" IsVisible="False">
          <TextBlock x:Name="TaskTitle" FontSize="{DynamicResource AxFontSizeSmall}" VerticalAlignment="Center"/>
          <TextBlock x:Name="TaskMessage" Classes="dim" FontSize="{DynamicResource AxFontSizeSmall}"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
          <ax:AxProgressBar x:Name="TaskProgress" Width="120" VerticalAlignment="Center"/>
          <TextBlock x:Name="TaskRest" Classes="dimmer" FontSize="{DynamicResource AxFontSizeSmall}"
                     VerticalAlignment="Center" IsVisible="False"/>
          <ax:AxButton x:Name="TaskCancel" Classes="icon" Width="20" Height="20"
                       AutomationProperties.Name="{loc:Loc task.cancel}"
                       ToolTip.Tip="{loc:Loc task.cancel}" Click="OnCancelTaskClick">
            <ax:AxIcon Classes="small" Data="{x:Static ax:AxIcons.Close}"/>
          </ax:AxButton>
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Classes="dim" Text="Avalonia 12.1.1" FontSize="{DynamicResource AxFontSizeSmall}"/>
          <TextBlock Classes="dimmer" Text="·" FontSize="{DynamicResource AxFontSizeSmall}"/>
          <TextBlock Classes="dim" Text="net10.0" FontSize="{DynamicResource AxFontSizeSmall}"/>
          <TextBlock Classes="dimmer" Text="·" FontSize="{DynamicResource AxFontSizeSmall}"/>
          <TextBlock Classes="dim" Text="UTF-8" FontSize="{DynamicResource AxFontSizeSmall}"/>
          <TextBlock Classes="dimmer" Text="·" FontSize="{DynamicResource AxFontSizeSmall}"/>
          <TextBlock Classes="dim" Text="100%" FontSize="{DynamicResource AxFontSizeSmall}"/>
        </StackPanel>
      </DockPanel>
    </shell:StudioShell.StatusBar>

  </shell:StudioShell>
</Window>
