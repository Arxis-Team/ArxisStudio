<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ax="using:ArxisStudio.Controls"
        xmlns:shell="using:ArxisStudio.Shell"
        x:Class="ArxisStudio.MainWindow"
        Title="ArxisStudio"
        Width="1440" Height="900"
        MinWidth="1360" MinHeight="700">

  <shell:StudioShell>

    <!-- Верхний тулбар (42px): логотип, проект, конфигурация, run-группа. -->
    <shell:StudioShell.TopBar>
      <DockPanel Height="42" Margin="10,0">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource AxAccBrush}">
            <TextBlock Text="Ax" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock x:Name="ProjectName" Text="Без проекта" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock Classes="dim" Text="Desktop · Debug" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Border Background="{DynamicResource AxBg1Brush}" BorderBrush="{DynamicResource AxBrdBrush}"
                  BorderThickness="1" CornerRadius="7" Padding="2">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <ax:AxButton Classes="icon" ToolTip.Tip="Run">
                <Path Data="M 5.2 3.4 V 12.6 L 13 8 Z" Fill="{DynamicResource AxGrnBrush}" Width="14" Height="14" Stretch="Uniform"/>
              </ax:AxButton>
              <ax:AxButton Classes="icon" ToolTip.Tip="Stop" IsEnabled="False">
                <Path Data="M 4 4 H 12 V 12 H 4 Z" Fill="{DynamicResource AxFg3Brush}" Width="11" Height="11" Stretch="Uniform"/>
              </ax:AxButton>
            </StackPanel>
          </Border>
          <ax:AxSegmentedControl x:Name="ThemeSwitch" SelectionChanged="OnThemeChanged">
            <ax:AxSegmentItem>Dark</ax:AxSegmentItem>
            <ax:AxSegmentItem>Light</ax:AxSegmentItem>
          </ax:AxSegmentedControl>
        </StackPanel>
        <Panel/>
      </DockPanel>
    </shell:StudioShell.TopBar>

    <!-- Левая зона: Hierarchy + Toolbox (заглушки M1). -->
    <shell:StudioShell.LeftPane>
      <Grid RowDefinitions="*,1,*">
        <DockPanel Grid.Row="0">
          <Border DockPanel.Dock="Top" Classes="tool-window-header">
            <TextBlock Classes="title" Text="Hierarchy"/>
          </Border>
          <TextBlock Classes="dimmer" Text="Нет открытого документа" FontSize="12"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </DockPanel>
        <Border Grid.Row="1" Background="{DynamicResource AxBrdBrush}"/>
        <DockPanel Grid.Row="2">
          <Border DockPanel.Dock="Top" Classes="tool-window-header">
            <TextBlock Classes="title" Text="Toolbox"/>
          </Border>
          <TextBlock Classes="dimmer" Text="Палитра контролов появится с дизайнером" FontSize="12"
                     HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="20,0"/>
        </DockPanel>
      </Grid>
    </shell:StudioShell.LeftPane>

    <!-- Центр: канва (пока пустая, с точечной сеткой по мокапу). -->
    <Border Background="{DynamicResource AxCanvasBrush}">
      <Panel>
        <Panel x:Name="CanvasDots"/>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
          <TextBlock Classes="dim" Text="ArxisStudio" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock Classes="dimmer" Text="Откройте документ .axaml — дизайнер форм появится в M3"
                     FontSize="12" HorizontalAlignment="Center"/>
        </StackPanel>
      </Panel>
    </Border>

    <!-- Нижняя зона: вкладки панелей (заглушки M1). -->
    <shell:StudioShell.BottomPane>
      <DockPanel>
        <Border DockPanel.Dock="Top" Height="32" BorderBrush="{DynamicResource AxBrdBrush}" BorderThickness="0,0,0,1" Padding="6,0">
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="Project" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" Margin="12,0"/>
            <TextBlock Classes="dim" Text="Console" FontSize="12" VerticalAlignment="Center" Margin="12,0"/>
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Margin="12,0">
              <TextBlock Classes="dim" Text="Problems" FontSize="12" VerticalAlignment="Center"/>
              <TextBlock Classes="dimmer" Text="0" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <TextBlock Classes="dimmer" Text="Панель проекта появится с открытием solution (M3)" FontSize="12"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </DockPanel>
    </shell:StudioShell.BottomPane>

    <!-- Правая зона: Inspector (заглушка M1). -->
    <shell:StudioShell.RightPane>
      <DockPanel>
        <Border DockPanel.Dock="Top" Classes="tool-window-header">
          <TextBlock Classes="title" Text="Inspector"/>
        </Border>
        <TextBlock Classes="dimmer" Text="Ничего не выбрано" FontSize="12"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </DockPanel>
    </shell:StudioShell.RightPane>

    <!-- Статус-бар (26px). -->
    <shell:StudioShell.StatusBar>
      <DockPanel Height="26" Margin="12,0">
        <TextBlock x:Name="StatusText" Classes="dim" Text="Ready" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Classes="dim" Text="Avalonia 12.1.1" FontSize="11"/>
          <TextBlock Classes="dimmer" Text="·" FontSize="11"/>
          <TextBlock Classes="dim" Text="net10.0" FontSize="11"/>
          <TextBlock Classes="dimmer" Text="·" FontSize="11"/>
          <TextBlock Classes="dim" Text="UTF-8" FontSize="11"/>
          <TextBlock Classes="dimmer" Text="·" FontSize="11"/>
          <TextBlock Classes="dim" Text="100%" FontSize="11"/>
        </StackPanel>
        <Panel/>
      </DockPanel>
    </shell:StudioShell.StatusBar>

  </shell:StudioShell>

</Window>
