<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ax="using:ArxisStudio.Controls"
        xmlns:shell="using:ArxisStudio.Shell"
        xmlns:loc="using:ArxisStudio.Shell.Localization"
        x:Class="ArxisStudio.MainWindow"
        Title="ArxisStudio"
        Width="1440" Height="900"
        MinWidth="1360" MinHeight="700"
        WindowDecorations="BorderOnly">

  <!--
      Окно — только оболочка: зоны, вкладки документов, заголовок и запуск.
      Всё остальное приходит модулями и плагинами через SDK — и дизайнер форм,
      и панель проекта, и консоль. Разметки ни одного из них здесь нет.
  -->
  <shell:StudioShell>

    <!-- Верхний тулбар (42px): логотип, проект, меню команд, run-группа. -->
    <shell:StudioShell.TopBar>
      <ax:AxTitleBar BorderThickness="0">
        <DockPanel Margin="10,0">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Width="24" Height="24" CornerRadius="{DynamicResource AxCornerRadius}"
                  Background="{DynamicResource AxAccStrongBrush}">
            <TextBlock Text="Ax" FontSize="{DynamicResource AxFontSizeCaption}" FontWeight="Bold"
                       Foreground="{DynamicResource AxOnAccBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock x:Name="ProjectName" Text="{loc:Loc studio.noproject}" FontSize="{DynamicResource AxFontSize}" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock Classes="dim" Text="{loc:Loc studio.configuration}" FontSize="{DynamicResource AxFontSizeSmall}" VerticalAlignment="Center" Margin="8,0,0,0"/>

          <!-- Команды плагинов; кнопки нет, пока никто ничего не добавил. -->
          <ax:AxButton x:Name="MenuButton" Classes="icon" IsVisible="False" Margin="8,0,0,0"
                       AutomationProperties.Name="{loc:Loc menu.tools}"
                       ToolTip.Tip="{loc:Loc menu.tools}"
                       Click="OnMenuClick">
            <ax:AxIcon Data="{x:Static ax:AxIcons.MoreHorizontal}" IsFilled="True"/>
          </ax:AxButton>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Border Background="{DynamicResource AxBg1Brush}" BorderBrush="{DynamicResource AxBrdBrush}"
                  BorderThickness="1" CornerRadius="{DynamicResource AxCornerRadius}" Padding="2">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <ax:AxButton x:Name="RunButton" Classes="icon" ToolTip.Tip="{loc:Loc studio.run}"
                           AutomationProperties.Name="{loc:Loc studio.run}" Click="OnRunClick">
                <ax:AxIcon Data="{x:Static ax:AxIcons.Play}" IsFilled="True" Foreground="{DynamicResource AxGrnBrush}"/>
              </ax:AxButton>
              <ax:AxButton x:Name="StopButton" Classes="icon" ToolTip.Tip="{loc:Loc studio.stop}" IsEnabled="False"
                           AutomationProperties.Name="{loc:Loc studio.stop}" Click="OnStopClick">
                <ax:AxIcon Data="{x:Static ax:AxIcons.Stop}" IsFilled="True" Foreground="{DynamicResource AxFg3Brush}"/>
              </ax:AxButton>
            </StackPanel>
          </Border>
          <ax:AxSegmentedControl x:Name="ThemeSwitch" SelectionChanged="OnThemeChanged">
            <ax:AxSegmentItem Content="{loc:Loc settings.theme.dark}"/>
            <ax:AxSegmentItem Content="{loc:Loc settings.theme.light}"/>
          </ax:AxSegmentedControl>
        </StackPanel>
          <Panel/>
        </DockPanel>
      </ax:AxTitleBar>
    </shell:StudioShell.TopBar>

    <!-- Левая зона: сюда встают панели модулей и плагинов. -->
    <shell:StudioShell.LeftPane>
      <Grid x:Name="LeftZone"/>
    </shell:StudioShell.LeftPane>

    <!-- Центр: вкладки документов; содержимое каждой даёт её редактор. -->
    <DockPanel>
      <ax:AxTabStrip x:Name="DocumentTabs" DockPanel.Dock="Top"
                     IsVisible="False"
                     SelectionChanged="OnDocumentTabChanged"/>

      <Panel>
        <ContentControl x:Name="DocumentHost"/>

        <StackPanel x:Name="CanvasHint" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
          <TextBlock Classes="dim" Text="ArxisStudio" FontSize="{DynamicResource AxFontSizeTitle}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock Classes="dimmer" Text="{loc:Loc studio.canvas.hint}"
                     FontSize="{DynamicResource AxFontSizeSmall}" HorizontalAlignment="Center"/>
        </StackPanel>
      </Panel>
    </DockPanel>

    <!--
        Нижняя зона: пустой набор вкладок. Проект, консоль и проблемы приходят
        сюда модулями — оболочка знает только, что вкладки бывают.
    -->
    <shell:StudioShell.BottomPane>
      <ax:AxToolWindow>
        <ax:AxToolWindow.Tabs>
          <ax:AxTabStrip x:Name="BottomTabs" Theme="{StaticResource AxToolWindowTabStrip}"
                         SelectionChanged="OnBottomTabChanged"/>
        </ax:AxToolWindow.Tabs>
        <ax:AxToolWindow.Actions>
          <ax:AxButton Classes="icon" AutomationProperties.Name="{loc:Loc action.collapse}">
            <ax:AxIcon Data="{x:Static ax:AxIcons.Minus}"/>
          </ax:AxButton>
        </ax:AxToolWindow.Actions>
        <Panel x:Name="BottomPluginHost"/>
      </ax:AxToolWindow>
    </shell:StudioShell.BottomPane>

    <!-- Правая зона: сюда встают панели модулей и плагинов. -->
    <shell:StudioShell.RightPane>
      <Grid x:Name="RightZone"/>
    </shell:StudioShell.RightPane>

    <!-- Статус-бар (26px). -->
    <shell:StudioShell.StatusBar>
      <DockPanel Height="26" Margin="12,0">
        <TextBlock x:Name="StatusText" Classes="dim" Text="{loc:Loc studio.ready}" FontSize="{DynamicResource AxFontSizeSmall}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Classes="dim" Text="Avalonia 12.1.1" FontSize="{DynamicResource AxFontSizeSmall}"/>
          <TextBlock Classes="dimmer" Text="·" FontSize="{DynamicResource AxFontSizeSmall}"/>
          <TextBlock Classes="dim" Text="net10.0" FontSize="{DynamicResource AxFontSizeSmall}"/>
          <TextBlock Classes="dimmer" Text="·" FontSize="{DynamicResource AxFontSizeSmall}"/>
          <TextBlock Classes="dim" Text="UTF-8" FontSize="{DynamicResource AxFontSizeSmall}"/>
          <TextBlock Classes="dimmer" Text="·" FontSize="{DynamicResource AxFontSizeSmall}"/>
          <TextBlock Classes="dim" Text="100%" FontSize="{DynamicResource AxFontSizeSmall}"/>
        </StackPanel>
      </DockPanel>
    </shell:StudioShell.StatusBar>

  </shell:StudioShell>
</Window>
