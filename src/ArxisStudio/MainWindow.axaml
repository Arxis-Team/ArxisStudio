<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ax="using:ArxisStudio.Controls"
        xmlns:shell="using:ArxisStudio.Shell"
        xmlns:loc="using:ArxisStudio.Shell.Localization"
        xmlns:svc="using:ArxisStudio.Services"
        x:Class="ArxisStudio.MainWindow"
        Title="ArxisStudio"
        Width="1440" Height="900"
        MinWidth="1360" MinHeight="700"
        WindowDecorations="BorderOnly">

  <!--
      Окно — только оболочка: зоны, вкладки, проект, консоль и запуск.
      Всё, что умеет редактировать, приходит модулями и плагинами через SDK;
      дизайнер форм — первый из них, и здесь его разметки нет.
  -->
  <shell:StudioShell>

    <!-- Верхний тулбар (42px): логотип, проект, меню команд, run-группа. -->
    <shell:StudioShell.TopBar>
      <ax:AxTitleBar BorderThickness="0">
        <DockPanel Margin="10,0">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource AxAccBrush}">
            <TextBlock Text="Ax" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock x:Name="ProjectName" Text="{loc:Loc studio.noproject}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock Classes="dim" Text="{loc:Loc studio.configuration}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>

          <!-- Команды плагинов; кнопки нет, пока никто ничего не добавил. -->
          <ax:AxButton x:Name="MenuButton" Classes="icon" IsVisible="False" Margin="8,0,0,0"
                       AutomationProperties.Name="{loc:Loc menu.tools}"
                       ToolTip.Tip="{loc:Loc menu.tools}"
                       Click="OnMenuClick">
            <ax:AxIcon Data="M 3 5 H 13 M 3 8 H 13 M 3 11 H 13" Width="13" Height="13" StrokeThickness="1.3"/>
          </ax:AxButton>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Border Background="{DynamicResource AxBg1Brush}" BorderBrush="{DynamicResource AxBrdBrush}"
                  BorderThickness="1" CornerRadius="7" Padding="2">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <ax:AxButton x:Name="RunButton" Classes="icon" ToolTip.Tip="{loc:Loc studio.run}"
                           AutomationProperties.Name="{loc:Loc studio.run}" Click="OnRunClick">
                <ax:AxIcon Data="{x:Static ax:AxIcons.Play}" IsFilled="True" Width="13" Height="13" Foreground="{DynamicResource AxGrnBrush}"/>
              </ax:AxButton>
              <ax:AxButton x:Name="StopButton" Classes="icon" ToolTip.Tip="{loc:Loc studio.stop}" IsEnabled="False"
                           AutomationProperties.Name="{loc:Loc studio.stop}" Click="OnStopClick">
                <ax:AxIcon Data="M 4 4 H 12 V 12 H 4 Z" IsFilled="True" Width="10" Height="10" Foreground="{DynamicResource AxFg3Brush}"/>
              </ax:AxButton>
            </StackPanel>
          </Border>
          <ax:AxSegmentedControl x:Name="ThemeSwitch" SelectionChanged="OnThemeChanged">
            <ax:AxSegmentItem Content="{loc:Loc settings.theme.dark}"/>
            <ax:AxSegmentItem Content="{loc:Loc settings.theme.light}"/>
          </ax:AxSegmentedControl>
        </StackPanel>
          <Panel/>
        </DockPanel>
      </ax:AxTitleBar>
    </shell:StudioShell.TopBar>

    <!-- Левая зона: сюда встают панели модулей и плагинов. -->
    <shell:StudioShell.LeftPane>
      <Grid x:Name="LeftZone"/>
    </shell:StudioShell.LeftPane>

    <!-- Центр: вкладки документов; содержимое каждой даёт её редактор. -->
    <DockPanel>
      <ax:AxTabStrip x:Name="DocumentTabs" DockPanel.Dock="Top"
                     IsVisible="False"
                     SelectionChanged="OnDocumentTabChanged"/>

      <Panel>
        <ContentControl x:Name="DocumentHost"/>

        <StackPanel x:Name="CanvasHint" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
          <TextBlock Classes="dim" Text="ArxisStudio" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock Classes="dimmer" Text="{loc:Loc studio.canvas.hint}"
                     FontSize="12" HorizontalAlignment="Center"/>
        </StackPanel>
      </Panel>
    </DockPanel>

    <!-- Нижняя зона: проект, консоль, проблемы и вкладки плагинов. -->
    <shell:StudioShell.BottomPane>
      <ax:AxToolWindow>
        <ax:AxToolWindow.Tabs>
          <ax:AxTabStrip x:Name="BottomTabs" Theme="{StaticResource AxToolWindowTabStrip}"
                         SelectionChanged="OnBottomTabChanged">
            <ax:AxTabItem Classes="compact" IsClosable="False" Content="{loc:Loc panel.project}"/>
            <ax:AxTabItem Classes="compact" IsClosable="False" Content="{loc:Loc panel.console}"/>
            <ax:AxTabItem Classes="compact" IsClosable="False" Content="{loc:Loc panel.problems}"/>
          </ax:AxTabStrip>
        </ax:AxToolWindow.Tabs>
        <ax:AxToolWindow.Actions>
          <ax:AxButton Classes="icon" AutomationProperties.Name="{loc:Loc action.collapse}">
            <ax:AxIcon Data="M 4 8 H 12" Width="13" Height="13" StrokeThickness="1.3"/>
          </ax:AxButton>
        </ax:AxToolWindow.Actions>
        <Panel>
          <!-- Журнал студии: сборка, запуск и всё, что пишут плагины. -->
          <DockPanel x:Name="ConsolePane" IsVisible="False">
            <ax:AxButton DockPanel.Dock="Top" Classes="compact ghost" HorizontalAlignment="Left"
                         Margin="8,6,0,0" Content="{loc:Loc console.clear}" Click="OnConsoleClear"/>
            <ScrollViewer x:Name="ConsoleScroll">
              <ItemsControl x:Name="ConsoleList" Margin="10,4">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="svc:StudioLogEntry">
                    <StackPanel Orientation="Horizontal" Spacing="8" Height="18">
                      <TextBlock Classes="mono dimmer" FontSize="11.5" Width="56" Text="{Binding Stamp}"/>
                      <TextBlock Classes="mono" FontSize="11.5" Width="48" FontWeight="SemiBold"
                                 Text="{Binding LevelName}"
                                 Classes.ok="{Binding IsInfo}"
                                 Classes.warn="{Binding IsWarning}"
                                 Classes.bad="{Binding IsError}"/>
                      <TextBlock Classes="mono" FontSize="11.5" Text="{Binding Source}" Width="52"
                                 Foreground="{DynamicResource AxFg3Brush}"/>
                      <TextBlock Classes="mono" FontSize="11.5" Text="{Binding Message}"
                                 TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>

          <TextBlock x:Name="ProblemsEmpty" Classes="dimmer" Text="{loc:Loc panel.problems.none}" FontSize="12"
                     IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>

          <Panel x:Name="BottomPluginHost"/>

          <TextBlock x:Name="ProjectEmpty" Classes="dimmer" Text="{loc:Loc panel.project.empty}" FontSize="12"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <ax:AxTreeView x:Name="ProjectTreeView" DoubleTapped="OnProjectTreeDoubleTapped">
            <ax:AxTreeView.Styles>
              <Style Selector="ax|AxTreeViewItem" x:DataType="svc:ProjectNode">
                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
              </Style>
            </ax:AxTreeView.Styles>
            <ax:AxTreeView.ItemTemplate>
              <TreeDataTemplate x:DataType="svc:ProjectNode" ItemsSource="{Binding Children}">
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
              </TreeDataTemplate>
            </ax:AxTreeView.ItemTemplate>
          </ax:AxTreeView>
        </Panel>
      </ax:AxToolWindow>
    </shell:StudioShell.BottomPane>

    <!-- Правая зона: сюда встают панели модулей и плагинов. -->
    <shell:StudioShell.RightPane>
      <Grid x:Name="RightZone"/>
    </shell:StudioShell.RightPane>

    <!-- Статус-бар (26px). -->
    <shell:StudioShell.StatusBar>
      <DockPanel Height="26" Margin="12,0">
        <TextBlock x:Name="StatusText" Classes="dim" Text="{loc:Loc studio.ready}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Classes="dim" Text="Avalonia 12.1.1" FontSize="11"/>
          <TextBlock Classes="dimmer" Text="·" FontSize="11"/>
          <TextBlock Classes="dim" Text="net10.0" FontSize="11"/>
          <TextBlock Classes="dimmer" Text="·" FontSize="11"/>
          <TextBlock Classes="dim" Text="UTF-8" FontSize="11"/>
          <TextBlock Classes="dimmer" Text="·" FontSize="11"/>
          <TextBlock Classes="dim" Text="100%" FontSize="11"/>
        </StackPanel>
      </DockPanel>
    </shell:StudioShell.StatusBar>

  </shell:StudioShell>
</Window>
