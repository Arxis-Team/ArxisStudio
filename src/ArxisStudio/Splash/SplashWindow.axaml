<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ax="https://github.com/Arxis-Team/ArxisStudio"
        xmlns:art="using:ArxisStudio.Splash.Art"
        xmlns:vm="using:ArxisStudio.ViewModels"
        x:Class="ArxisStudio.Splash.SplashWindow"
        x:DataType="vm:SplashViewModel"
        Title="ArxisStudio"
        Width="640" Height="360"
        CanResize="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">

  <!--
      Рама заставки и полоса хода: то, что при смене оформления остаётся.
      Картинку релиза даёт art:Splash2026 — один элемент ниже, и меняют к новой
      версии именно его.

      Своей рамки у окна нет вовсе: скруглить системную нельзя, а заставка со
      скруглением карточки — часть узнаваемости студии. Поэтому прозрачное окно и
      скруглённая подложка внутри. Размеры и отступы заставки записаны в
      docs/design-spec.md: у экрана без записи нет критериев приёмки, и заставка
      разошлась со всем остальным ровно потому, что записи у неё не было.
  -->
  <Border Background="{DynamicResource AxBg1Brush}"
          BorderBrush="{DynamicResource AxBrdBrush}"
          BorderThickness="1"
          CornerRadius="{DynamicResource AxCornerRadiusCard}"
          ClipToBounds="True">
    <Grid>
      <art:Splash2026/>

      <StackPanel VerticalAlignment="Bottom" Margin="{DynamicResource AxSplashPadding}">
        <TextBlock Text="{Binding Stage}"
                   FontSize="{DynamicResource AxFontSizeSmall}"
                   Foreground="{DynamicResource AxFg2Brush}"
                   TextTrimming="CharacterEllipsis"/>

        <ax:AxProgressBar Margin="{DynamicResource AxSpaceAboveThickness}"
                          IsVisible="{Binding !HasFailed}"
                          Minimum="0" Maximum="100"
                          Value="{Binding Progress}"
                          IsIndeterminate="{Binding IsIndeterminate}"/>

        <!--
            Отказ встаёт на место полосы хода. Второго окна ради него не
            заводят: заставка уже на экране, уже единственная и уже имеет
            строку под текст, а собирать окно пришлось бы тем самым кодом,
            который только что не собрался.

            Причина пишется моноширинным и не переводится — её несут в отчёт о
            сбое. Кнопка нужна не для красоты: рамы у окна нет, и без неё
            человек остался бы с незакрываемой заставкой.
        -->
        <StackPanel Margin="{DynamicResource AxSpaceAboveThickness}" IsVisible="{Binding HasFailed}">
          <TextBlock Text="{Binding Failure}"
                     FontFamily="{DynamicResource AxFontFamilyMono}"
                     FontSize="{DynamicResource AxFontSizeCaption}"
                     Foreground="{DynamicResource AxRedTextBrush}"
                     TextWrapping="Wrap" MaxLines="3"
                     TextTrimming="CharacterEllipsis"/>

          <ax:AxButton Content="{ax:Loc common.close}" Margin="{DynamicResource AxSpaceWideAboveThickness}"
                       HorizontalAlignment="Left" Click="OnCloseClick"/>
        </StackPanel>

        <!--
            Подвал: слева права и набор инструментов, справа среда. Обе строки
            нужны в отчёте о сбое — человек снимает заставку, и на снимке уже
            есть всё, о чём его иначе пришлось бы расспрашивать.
        -->
        <Grid Margin="{DynamicResource AxSpaceLooseAboveThickness}">
          <TextBlock Text="{Binding Credit}" HorizontalAlignment="Left"
                     FontFamily="{DynamicResource AxFontFamilyMono}"
                     FontSize="{DynamicResource AxFontSizeCaption}"
                     Foreground="{DynamicResource AxFg3Brush}"/>

          <TextBlock Text="{Binding Runtime}" HorizontalAlignment="Right"
                     FontFamily="{DynamicResource AxFontFamilyMono}"
                     FontSize="{DynamicResource AxFontSizeCaption}"
                     Foreground="{DynamicResource AxFg3Brush}"/>
        </Grid>
      </StackPanel>
    </Grid>
  </Border>
</Window>
