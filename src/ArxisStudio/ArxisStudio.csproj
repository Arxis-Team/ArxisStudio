<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <RootNamespace>ArxisStudio</RootNamespace>
        <AssemblyName>ArxisStudio</AssemblyName>
        <!--
            AVLN3001 предупреждает, что окно без конструктора без аргументов не
            поднять загрузчиком разметки во время выполнения. Окна студии
            создаются кодом и получают сервисы через конструктор; загрузчик
            здесь работает только с документами открытого проекта.
        -->
        <NoWarn>$(NoWarn);AVLN3001</NoWarn>
        <!--
            Привязки проверяются при сборке: опечатка в имени свойства модели
            становится ошибкой компиляции, а не пустым местом в окне. Ради этого
            у каждого корня разметки и каждого шаблона стоит x:DataType.
        -->
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <!--
        У корня выхода — сама студия: exe, её сборка и два файла среды. Платформа лежит в
        папке Lib, модули и то, что везут только они, — в Modules; правила раскладки в
        build/ArxisStudio.Library.targets и build/ArxisStudio.Modules.targets, а дорога к обеим
        папкам при запуске — StudioAssemblyFolder.

        Документация ссылок в выход не идёт: XML-файлы нужны компилятору и подсказкам, а
        студия их не читает. Транзитивные ссылки на проекты выключены: иначе SDK приписал бы
        приложению приватные проекты модулей — провайдер MSBuild, контракт службы проектов — и
        положил бы их в корень. Поэтому всё, что нужно самой студии, названо ниже прямо.
    -->
    <PropertyGroup>
        <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
        <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
        <PackageReference Include="Avalonia.Desktop"/>
        <PackageReference Include="Avalonia.Fonts.Inter"/>
        <PackageReference Include="Avalonia.Themes.Fluent"/>
    </ItemGroup>

    <!--
        AvaDevTools — инспектор дерева, стилей и раскладки прямо в процессе
        студии, с конечной точкой MCP на петле. Отладочный инструмент: в
        Release пакета нет, поэтому и код обращения к нему под #if DEBUG.
    -->
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <PackageReference Include="AvaDevTools"/>
    </ItemGroup>

    <!-- Разбор вывода dotnet new закрыт от плагинов, но проверяется тестами. -->
    <ItemGroup>
        <InternalsVisibleTo Include="ArxisStudio.Tests"/>
    </ItemGroup>

    <!--
        Платформа: всё, что нужно самой студии, — у корня. Ядро модели проектов в их числе,
        хоть студия его типов и не зовёт: это общая сборка, плагины берут её из основного
        контекста, и лежать ей положено рядом с SDK и контролами, а не в углу одного модуля.
    -->
    <ItemGroup>
        <ProjectReference Include="../ArxisStudio.Sdk/ArxisStudio.Sdk.csproj"/>
        <ProjectReference Include="../ArxisStudio.Shell/ArxisStudio.Shell.csproj"/>
        <ProjectReference Include="../ArxisStudio.Docking/ArxisStudio.Docking.csproj"/>
        <ProjectReference Include="../ArxisStudio.Extensibility/ArxisStudio.Extensibility.csproj"/>
        <ProjectReference Include="../../external/ArxisStudio.Controls/src/ArxisStudio.Controls.csproj"/>
        <ProjectReference Include="../../external/ArxisStudio.Icons/src/ArxisStudio.Icons.csproj"/>
        <ProjectReference Include="../../external/ArxisStudio.Themes.Arxis/src/ArxisStudio.Themes.Arxis.csproj"/>
        <ProjectReference Include="../../external/ArxisStudio.Fonts.Cascadia/src/ArxisStudio.Fonts.Cascadia.csproj"/>
        <ProjectReference Include="../../external/ArxisStudio.ProjectSystem/src/ArxisStudio.ProjectSystem/ArxisStudio.ProjectSystem.csproj"/>
    </ItemGroup>

    <!--
        Встроенные модули. Порядок подъёма задаёт StudioModules.Assemblies; здесь — только то,
        как модуль попадает в выход. Компилироваться против него можно — студия называет его
        сборку в списке модулей, — а сам он и всё, что он тянет, ложится в Modules. Новый модуль
        заводится двумя строками: здесь, с теми же пометками, и в списке.
    -->
    <!--
        Контракт службы проектов — ради живого пути в контексте плагина: студия берёт службу тем же
        экспортом, каким её берёт плагин, и потому обязана назвать её тип. Сборка приезжает с
        модулем и лежит в Modules; сюда она не копируется, и уйдёт модуль — уйдёт и эта строка.
    -->
    <ItemGroup>
        <ProjectReference Include="../Modules/ArxisStudio.Projects.Contracts/ArxisStudio.Projects.Contracts.csproj"
                          Private="false" ExcludeAssets="runtime"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Modules/ArxisStudio.Modules.Sample/ArxisStudio.Modules.Sample.csproj"
                          StudioModule="true" Private="false" ExcludeAssets="runtime"/>
        <ProjectReference Include="../Modules/ArxisStudio.Modules.Terminal/ArxisStudio.Modules.Terminal.csproj"
                          StudioModule="true" Private="false" ExcludeAssets="runtime"/>
        <ProjectReference Include="../Modules/ArxisStudio.Modules.Console/ArxisStudio.Modules.Console.csproj"
                          StudioModule="true" Private="false" ExcludeAssets="runtime"/>
        <ProjectReference Include="../Modules/ArxisStudio.Modules.Projects/ArxisStudio.Modules.Projects.csproj"
                          StudioModule="true" Private="false" ExcludeAssets="runtime"/>
    </ItemGroup>

    <Import Project="build/ArxisStudio.Library.targets"/>
    <Import Project="build/ArxisStudio.Modules.targets"/>

</Project>
