<ax:AxWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ax="https://github.com/Arxis-Team/ArxisStudio"
        xmlns:vm="using:ArxisStudio.ViewModels"
        xmlns:conv="using:ArxisStudio.Converters"
        xmlns:ext="using:ArxisStudio.Extensibility"
        x:Class="ArxisStudio.Welcome.WelcomeWindow"
        x:DataType="vm:WelcomeViewModel"
        Title="{ax:Loc welcome.title}"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="600">

  <DockPanel>

    <!-- Полоса заголовка: подпись слева, кнопки окна справа. -->
    <ax:AxTitleBar DockPanel.Dock="Top" Height="38">
      <TextBlock Classes="dimmer" Text="{ax:Loc welcome.title}" FontSize="{DynamicResource AxFontSizeSmall}"
                 VerticalAlignment="Center" Margin="14,0"/>
    </ax:AxTitleBar>

    <Grid ColumnDefinitions="230,*">

    <!-- Sidebar 230px: логотип, разделы, Settings, пользователь. -->
    <Border Grid.Column="0" Background="{DynamicResource AxBg2Brush}"
            BorderBrush="{DynamicResource AxBrdBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="10,16,10,12">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="8,0,8,16">
          <ax:AxAvatar Width="34" Height="34" Initials="Ax" FontSize="{DynamicResource AxFontSizeTitle}"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{ax:Loc app.name}" FontWeight="SemiBold" FontSize="{DynamicResource AxFontSize}"/>
            <TextBlock Classes="dimmer" Text="Avalonia 12.1 · net10.0" FontSize="{DynamicResource AxFontSizeSmall}"/>
          </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="8">
          <ToggleButton Classes="nav" IsChecked="{Binding IsSettings, Mode=OneWay}"
                        AutomationProperties.Name="{ax:Loc welcome.nav.settings}"
                        Click="OnSettingsClick">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ax:AxIcon Data="{x:Static ax:AxIcons.Settings}" Width="15" Height="15"/>
              <TextBlock Text="{ax:Loc welcome.nav.settings}" VerticalAlignment="Center"/>
            </StackPanel>
          </ToggleButton>
          <Border BorderBrush="{DynamicResource AxBrdBrush}" BorderThickness="0,1,0,0" Padding="10,8,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ax:AxAvatar Classes="round" Width="22" Height="22" Initials="FF" FontSize="{DynamicResource AxFontSizeCaption}"
                           TileBrush="{DynamicResource AxPurBrush}"/>
              <TextBlock Classes="dim" Text="FibonacciFox" FontSize="{DynamicResource AxFontSizeSmall}" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="2">
          <ToggleButton Classes="nav" IsChecked="{Binding IsProjects, Mode=OneWay}"
                        AutomationProperties.Name="{ax:Loc welcome.nav.projects}" Click="OnProjectsClick">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ax:AxIcon Data="{x:Static ax:AxIcons.Folder}" Width="15" Height="15"/>
              <TextBlock Text="{ax:Loc welcome.nav.projects}" VerticalAlignment="Center"/>
            </StackPanel>
          </ToggleButton>
          <ToggleButton Classes="nav" IsChecked="{Binding IsLearn, Mode=OneWay}"
                        AutomationProperties.Name="{ax:Loc welcome.nav.learn}" Click="OnLearnClick">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ax:AxIcon Data="{x:Static ax:AxIcons.Play}" Width="15" Height="15"/>
              <TextBlock Text="{ax:Loc welcome.nav.learn}" VerticalAlignment="Center"/>
            </StackPanel>
          </ToggleButton>
          <ToggleButton Classes="nav" IsChecked="{Binding IsPlugins, Mode=OneWay}"
                        AutomationProperties.Name="{ax:Loc welcome.nav.plugins}" Click="OnPluginsClick">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ax:AxIcon Data="{x:Static ax:AxIcons.Package}" Width="15" Height="15"/>
              <TextBlock Text="{ax:Loc welcome.nav.plugins}" VerticalAlignment="Center"/>
            </StackPanel>
          </ToggleButton>
        </StackPanel>

      </DockPanel>
    </Border>

    <!-- Контент раздела. -->
    <DockPanel Grid.Column="1">

      <!-- Полоса сообщений операций (создание проекта, установка плагина). -->
      <Border DockPanel.Dock="Bottom" IsVisible="{Binding HasStatus}"
              Background="{DynamicResource AxBg2Brush}"
              BorderBrush="{DynamicResource AxBrdBrush}" BorderThickness="0,1,0,0"
              Padding="24,10">
        <DockPanel>
          <ax:AxButton DockPanel.Dock="Right" Classes="ghost" Content="{ax:Loc common.close}"
                       Click="OnDismissStatus" Height="24" FontSize="{DynamicResource AxFontSizeSmall}"/>
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="{DynamicResource AxFontSizeSmall}" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>

      <ScrollViewer>
        <Panel Margin="36,28">

          <!-- ===== Projects ===== -->
          <StackPanel IsVisible="{Binding IsProjects}" Spacing="0" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Classes="section" Text="{ax:Loc projects.recent}" Margin="0,0,0,8"/>

            <!--
                Заглушка вместо списка. Работа с проектами приедет отдельным
                модулем, а войти в студию нужно уже сейчас: строка одна и ведёт
                в пустой каркас. Ни пути, ни времени открытия у неё нет —
                открывать пока нечего.

                Список недавних при этом никуда не делся: RecentProjects и
                recent-projects.json остаются моделью, к которой модуль
                вернётся, — исчезло только то, что её показывало.
            -->
            <Border Classes="row" Height="58" CornerRadius="{DynamicResource AxCornerRadiusLarge}" Padding="12,0"
                    PointerPressed="OnStudioPressed">
              <DockPanel>
                <ax:AxAvatar DockPanel.Dock="Left" Initials="AX" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{ax:Loc projects.stub}" FontWeight="Medium"
                             FontSize="{DynamicResource AxFontSize}"/>
                  <TextBlock Classes="dimmer" Text="{ax:Loc projects.stub.hint}"
                             FontSize="{DynamicResource AxFontSizeSmall}" Margin="0,1,0,0"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>

          <!-- ===== Learn ===== -->
          <StackPanel IsVisible="{Binding IsLearn}" Spacing="0" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="{ax:Loc learn.title}" FontSize="{DynamicResource AxFontSizeTitle}" FontWeight="SemiBold"/>
            <TextBlock Classes="dimmer" FontSize="{DynamicResource AxFontSizeSmall}" Margin="0,2,0,0" Text="{ax:Loc learn.subtitle}"/>

            <ax:AxCard Margin="0,22,0,0" Padding="4,2">
              <StackPanel>
                <Border Classes="link-row" Tag="https://github.com/Arxis-Team" PointerPressed="OnLinkPressed">
                  <DockPanel>
                    <ax:AxIcon DockPanel.Dock="Left" Data="{x:Static ax:AxIcons.Document}" Margin="0,0,10,0"/>
                    <TextBlock Classes="link" Text="{ax:Loc learn.docs}" FontSize="{DynamicResource AxFontSize}" VerticalAlignment="Center"/>
                  </DockPanel>
                </Border>
                <Border Classes="link-row" Tag="https://github.com/Arxis-Team" PointerPressed="OnLinkPressed">
                  <DockPanel>
                    <ax:AxIcon DockPanel.Dock="Left" Data="{x:Static ax:AxIcons.List}" Margin="0,0,10,0"/>
                    <TextBlock Classes="link" Text="{ax:Loc learn.api}" FontSize="{DynamicResource AxFontSize}" VerticalAlignment="Center"/>
                  </DockPanel>
                </Border>
                <Border Classes="link-row" Tag="https://github.com/Arxis-Team" PointerPressed="OnLinkPressed">
                  <DockPanel>
                    <ax:AxIcon DockPanel.Dock="Left" Data="{x:Static ax:AxIcons.Package}" Margin="0,0,10,0"/>
                    <TextBlock Classes="link" Text="{ax:Loc learn.samples}" FontSize="{DynamicResource AxFontSize}" VerticalAlignment="Center"/>
                  </DockPanel>
                </Border>
                <Border Classes="link-row" Tag="https://github.com/Arxis-Team" PointerPressed="OnLinkPressed">
                  <DockPanel>
                    <ax:AxIcon DockPanel.Dock="Left" Data="{x:Static ax:AxIcons.Bubble}" Margin="0,0,10,0"/>
                    <TextBlock Classes="link" Text="{ax:Loc learn.community}" FontSize="{DynamicResource AxFontSize}" VerticalAlignment="Center"/>
                  </DockPanel>
                </Border>
              </StackPanel>
            </ax:AxCard>
          </StackPanel>

          <!-- ===== Plugins ===== -->
          <StackPanel IsVisible="{Binding IsPlugins}" Spacing="0" MaxWidth="980" HorizontalAlignment="Left">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10">
                <ax:AxButton Classes="accent" Content="{ax:Loc plugins.install}" Click="OnInstallPluginClick"/>
                <ax:AxButton Content="{ax:Loc plugins.installarchive}" Click="OnInstallArchiveClick"/>
                <ax:AxButton Content="{ax:Loc plugins.openfolder}" Click="OnOpenPluginFolderClick"/>
              </StackPanel>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{ax:Loc plugins.title}" FontSize="{DynamicResource AxFontSizeTitle}" FontWeight="SemiBold"/>
                <TextBlock Classes="dimmer" FontSize="{DynamicResource AxFontSizeSmall}" Margin="0,2,0,0" Text="{ax:Loc plugins.subtitle}"/>
              </StackPanel>
            </DockPanel>

            <TextBlock Classes="dimmer" FontSize="{DynamicResource AxFontSizeSmall}" Margin="0,22,0,0"
                       Text="{ax:Loc plugins.empty}" IsVisible="{Binding HasNoPlugins}"/>

            <ax:AxCard Margin="0,18,0,0" Padding="0" IsVisible="{Binding !HasNoPlugins}">
              <ItemsControl ItemsSource="{Binding InstalledPlugins}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PluginCard">
                    <Border Padding="16,12" BorderBrush="{DynamicResource AxBrdBrush}" BorderThickness="0,0,0,1">
                      <DockPanel>
                        <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="{DynamicResource AxCornerRadiusLarge}" Margin="0,0,12,0"
                                Background="{DynamicResource AxBg3Brush}">
                          <Panel>
                            <Image x:Name="PluginIcon" Width="24" Height="24"
                                   RenderOptions.BitmapInterpolationMode="HighQuality"
                                   Source="{Binding Plugin.IconPath, Converter={x:Static conv:PluginIconConverter.Instance}}"/>
                            <!-- Общий значок показывается тогда, когда картинки
                                 нет: не объявлена, потерялась или не
                                 прочиталась. Решает сама картинка, а не путь к
                                 ней, — иначе объявленный и битый файл оставлял
                                 бы на карточке пустое место. -->
                            <ax:AxIcon Width="19" Height="19" Data="{x:Static ax:AxIcons.Package}"
                                       Foreground="{DynamicResource AxPurBrush}"
                                       IsVisible="{Binding #PluginIcon.Source, Converter={x:Static ObjectConverters.IsNull}}"/>
                          </Panel>
                        </Border>
                        <ax:AxButton DockPanel.Dock="Right" Height="26" FontSize="{DynamicResource AxFontSizeSmall}"
                                     VerticalAlignment="Center" Margin="8,0,0,0"
                                     Click="OnRemovePluginClick" Tag="{Binding Plugin}"
                                     Content="{ax:Loc plugins.remove}"/>
                        <ax:AxButton DockPanel.Dock="Right" MinWidth="96" Height="26" FontSize="{DynamicResource AxFontSizeSmall}"
                                     VerticalAlignment="Center" Margin="10,0,0,0"
                                     Click="OnTogglePluginClick" Tag="{Binding Plugin}"
                                     Content="{Binding Plugin.IsEnabled, Converter={x:Static conv:PluginToggleConverter.Instance}}"
                                     IsVisible="{Binding Plugin.IsValid}"/>
                        <TextBlock DockPanel.Dock="Right" Classes="mono dimmer" FontSize="{DynamicResource AxFontSizeSmall}"
                                   VerticalAlignment="Center" Text="{Binding Plugin.Manifest.Version}"/>
                        <StackPanel VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Plugin.DisplayName}" FontWeight="SemiBold" FontSize="{DynamicResource AxFontSize}"/>
                            <TextBlock Classes="dimmer" FontSize="{DynamicResource AxFontSizeSmall}" VerticalAlignment="Bottom"
                                       Text="{Binding Plugin.Manifest.Publisher}"/>
                            <ax:AxChip Content="{ax:Loc plugins.broken}" IsVisible="{Binding !Plugin.IsValid}"/>
                          </StackPanel>
                          <TextBlock Classes="dim" FontSize="{DynamicResource AxFontSizeSmall}" Margin="0,1,0,0"
                                     TextTrimming="CharacterEllipsis"
                                     Text="{Binding Plugin.Description}"/>
                          <TextBlock Classes="dimmer" FontSize="{DynamicResource AxFontSizeSmall}" Margin="0,1,0,0"
                                     TextTrimming="CharacterEllipsis"
                                     Text="{Binding Plugin.Error}" IsVisible="{Binding !Plugin.IsValid}"/>

                          <!-- Полнота перевода: у обычного плагина список пуст,
                               и строка не появляется. -->
                          <ItemsControl ItemsSource="{Binding Plugin.Coverage}" Margin="0,3,0,0">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6"/>
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="ext:LanguageCoverage">
                                <ax:AxChip Content="{Binding Label}"/>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>

                          <!-- Зависимости: у большинства плагинов их нет, и
                               строка не появляется. Обязательная не в порядке
                               подсвечивается — это ответ на вопрос «почему
                               плагин не поднялся». -->
                          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,3,0,0"
                                      IsVisible="{Binding HasDependencies}">
                            <TextBlock Classes="dimmer" FontSize="{DynamicResource AxFontSizeSmall}"
                                       VerticalAlignment="Center" Text="{ax:Loc plugins.deps}"/>
                            <ItemsControl ItemsSource="{Binding Dependencies}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <StackPanel Orientation="Horizontal" Spacing="6"/>
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="ext:PluginDependencyState">
                                  <ax:AxChip Content="{Binding Label}"
                                             Foreground="{Binding IsProblem, Converter={x:Static conv:DependencyProblemBrushConverter.Instance}}"/>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ax:AxCard>
          </StackPanel>

          <!-- ===== Settings ===== -->
          <!-- Ширина задана, а не набрана содержимым: строка настройки плагина
               прижимает поле ввода вправо, и колонка, ужимающаяся по самой
               узкой из показанных строк, наезжала бы подписью на это поле.
               Сколько строк показано сейчас — от плагинов, и ширине окна знать
               об этом незачем. -->
          <StackPanel IsVisible="{Binding IsSettings}" Spacing="0" Width="640"
                      HorizontalAlignment="Left" Margin="0,0,0,28">
            <TextBlock Text="{ax:Loc settings.title}" FontSize="{DynamicResource AxFontSizeTitle}" FontWeight="SemiBold"/>
            <TextBlock Classes="dimmer" FontSize="{DynamicResource AxFontSizeSmall}" Margin="0,2,0,0" Text="{ax:Loc settings.subtitle}"/>

            <TextBlock Classes="section" Text="{ax:Loc settings.appearance}" Margin="0,22,0,8"/>
            <ax:AxCard Padding="16,2">
              <StackPanel>
                <DockPanel Classes="settings-row">
                  <ax:AxSegmentedControl DockPanel.Dock="Right" x:Name="ThemeSwitch" SelectionChanged="OnThemeChanged">
                    <ax:AxSegmentItem Content="{ax:Loc settings.theme.dark}"/>
                    <ax:AxSegmentItem Content="{ax:Loc settings.theme.light}"/>
                  </ax:AxSegmentedControl>
                  <TextBlock Text="{ax:Loc settings.theme}" FontSize="{DynamicResource AxFontSize}" VerticalAlignment="Center"/>
                </DockPanel>
                <ax:AxDivider/>
                <DockPanel Classes="settings-row">
                  <!-- Пункты собираются из найденных словарей: список языков
                       студия узнаёт на ходу, а не знает наперёд. -->
                  <ax:AxComboBox DockPanel.Dock="Right" x:Name="LanguageBox" Width="170"
                                 SelectionChanged="OnLanguageChanged"/>
                  <TextBlock Text="{ax:Loc settings.language}" FontSize="{DynamicResource AxFontSize}" VerticalAlignment="Center"/>
                </DockPanel>
              </StackPanel>
            </ax:AxCard>

            <TextBlock Classes="section" Text="{ax:Loc settings.plugins}" Margin="0,22,0,8"/>
            <TextBlock Classes="dimmer" FontSize="{DynamicResource AxFontSizeSmall}" Margin="0,0,0,8"
                       Text="{ax:Loc settings.plugins.empty}" IsVisible="{Binding HasNoPluginSettings}"/>
            <ax:AxCard Padding="16,2" IsVisible="{Binding !HasNoPluginSettings}">
              <ItemsControl ItemsSource="{Binding PluginSettings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PluginSettingRow">
                    <DockPanel Classes="settings-row">
                      <ax:AxToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Flag, Mode=TwoWay}"
                                         IsEnabled="{Binding IsEditable}" IsVisible="{Binding IsToggle}"/>
                      <ax:AxTextBox DockPanel.Dock="Right" Width="220" Text="{Binding Text, Mode=TwoWay}"
                                    IsEnabled="{Binding IsEditable}" IsVisible="{Binding IsText}"/>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}" FontSize="{DynamicResource AxFontSize}"/>
                        <TextBlock Classes="dimmer" FontSize="{DynamicResource AxFontSizeSmall}" Margin="0,1,0,0"
                                   Text="{Binding PluginName}"/>
                        <TextBlock Classes="dimmer" FontSize="{DynamicResource AxFontSizeSmall}" Margin="0,1,0,0"
                                   Text="{Binding Note}" IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ax:AxCard>

          </StackPanel>

        </Panel>
      </ScrollViewer>
    </DockPanel>
    </Grid>
  </DockPanel>

</ax:AxWindow>
