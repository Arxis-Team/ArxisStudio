<ax:AxWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ax="https://github.com/Arxis-Team/ArxisStudio"
        xmlns:vm="using:ArxisStudio.ViewModels"
        xmlns:conv="using:ArxisStudio.Converters"
        xmlns:ext="using:ArxisStudio.Extensibility"
        xmlns:svc="using:ArxisStudio.Services"
        x:Class="ArxisStudio.Welcome.WelcomeWindow"
        x:DataType="vm:WelcomeViewModel"
        Title="{ax:Loc welcome.title}"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <!--
      Кнопка меню строки живёт только здесь, поэтому и стиль её здесь, а не в ShellStyles:
      класс `row` общий для нескольких экранов, а `more` — этого.
  -->
  <ax:AxWindow.Styles>
    <Style Selector="Border.row ax|AxButton.more">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Border.row:pointerover ax|AxButton.more">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Border.row:focus-within ax|AxButton.more">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
  </ax:AxWindow.Styles>

  <DockPanel>

    <!-- Полоса заголовка: подпись слева, кнопки окна справа. -->
    <ax:AxTitleBar DockPanel.Dock="Top" MinHeight="38">
      <TextBlock ax:AxText.Tone="Tertiary" Text="{ax:Loc welcome.title}" FontSize="{DynamicResource AxFontSizeSmall}"
                 VerticalAlignment="Center" Margin="{DynamicResource AxSpaceWideSidesThickness}"/>
    </ax:AxTitleBar>

    <Grid ColumnDefinitions="230,*">

    <!-- Sidebar 230px: логотип, разделы, Settings, пользователь. -->
    <Border Grid.Column="0" Background="{DynamicResource AxSurfacePanelBrush}"
            BorderBrush="{DynamicResource AxStrokeSubtleBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="10,16,10,12">

        <!--
            Док, а не горизонтальная стопка: стопка отдаёт тексту сколько угодно ширины, и при
            крупном кегле подпись вылезала из колонки в 230 под соседний раздел. В доке текст
            знает свою ширину и сокращается многоточием.
        -->
        <DockPanel DockPanel.Dock="Top" Margin="8,0,8,16">
          <ax:AxAvatar DockPanel.Dock="Left" Width="34" Height="34" Initials="Ax" FontSize="{DynamicResource AxFontSizeTitle}"
                       Margin="{DynamicResource AxSpaceWideTrailingThickness}"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{ax:Loc app.name}" FontWeight="SemiBold" FontSize="{DynamicResource AxFontSize}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock ax:AxText.Tone="Tertiary" Text="Avalonia 12.1 · net10.0" FontSize="{DynamicResource AxFontSizeSmall}"
                       TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </DockPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="{DynamicResource AxGapControls}">
          <!--
              Настройки разделом быть перестали: у них своё окно, одно на
              студию и на Welcome. Строка осталась там же, где стояла, и
              отмечается, пока окно открыто.

              Значок — шестерёнка, а не ползунки: дверь в настройки читается
              шестерёнкой везде. Ползунки в наборе остаются за Settings — они
              про подстройку, а не про вход.
          -->
          <ax:AxToggleButton Classes="nav" IsChecked="{Binding IsSettingsOpen, Mode=OneWay}"
                        AutomationProperties.Name="{ax:Loc welcome.nav.settings}"
                        Click="OnSettingsClick">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource AxGapControls}">
              <ax:AxIcon Data="{x:Static ax:AxIcons.Gear}"/>
              <TextBlock Text="{ax:Loc welcome.nav.settings}" VerticalAlignment="Center"/>
            </StackPanel>
          </ax:AxToggleButton>
          <Border BorderBrush="{DynamicResource AxStrokeSubtleBrush}" BorderThickness="0,1,0,0" Padding="10,8,0,0">
            <!-- Док, а не стопка, — по той же причине, что у знака наверху. -->
            <DockPanel>
              <!--
                  Монограмма — классом темы, а не своей кистью. Тема прямо
                  запрещает ставить инициалы на AxTintPurple: белый даёт на нём 3,4:1, а
                  класс purple берёт ступень шкалы, где белый держит порог.
              -->
              <ax:AxAvatar DockPanel.Dock="Left" Shape="Circle" Tint="Purple" Width="22" Height="22" Initials="FF" FontSize="{DynamicResource AxFontSizeCaption}"
                           Margin="{DynamicResource AxSpaceTrailingThickness}"/>
              <TextBlock ax:AxText.Tone="Secondary" Text="FibonacciFox" FontSize="{DynamicResource AxFontSizeSmall}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"/>
            </DockPanel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="{DynamicResource AxSpaceHair}">
          <ax:AxToggleButton Classes="nav" IsChecked="{Binding IsProjects, Mode=OneWay}"
                        AutomationProperties.Name="{ax:Loc welcome.nav.projects}" Click="OnProjectsClick">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource AxGapControls}">
              <ax:AxIcon Data="{x:Static ax:AxIcons.Folder}"/>
              <TextBlock Text="{ax:Loc welcome.nav.projects}" VerticalAlignment="Center"/>
            </StackPanel>
          </ax:AxToggleButton>
          <ax:AxToggleButton Classes="nav" IsChecked="{Binding IsLearn, Mode=OneWay}"
                        AutomationProperties.Name="{ax:Loc welcome.nav.learn}" Click="OnLearnClick">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource AxGapControls}">
              <ax:AxIcon Data="{x:Static ax:AxIcons.Play}"/>
              <TextBlock Text="{ax:Loc welcome.nav.learn}" VerticalAlignment="Center"/>
            </StackPanel>
          </ax:AxToggleButton>
          <!--
              Плагины разделом быть перестали — как и настройки: менеджер живёт
              страницей того же окна, одного на студию и на Welcome. Строка
              осталась там же и отмечается, пока окно открыто.
          -->
          <ax:AxToggleButton Classes="nav" IsChecked="{Binding IsPluginsOpen, Mode=OneWay}"
                        AutomationProperties.Name="{ax:Loc welcome.nav.plugins}" Click="OnPluginsClick">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource AxGapControls}">
              <ax:AxIcon Data="{x:Static ax:AxIcons.Package}"/>
              <TextBlock Text="{ax:Loc welcome.nav.plugins}" VerticalAlignment="Center"/>
            </StackPanel>
          </ax:AxToggleButton>
        </StackPanel>

      </DockPanel>
    </Border>

    <!-- Контент раздела. -->
    <DockPanel Grid.Column="1">

      <!--
          Полоса состояния: единственное место, где экран отвечает на отказ. Окно закрывается,
          как только проект открыт, и сказанное после этого человеку уже некуда показать.
      -->
      <Border DockPanel.Dock="Bottom" IsVisible="{Binding HasStatus}"
              Background="{DynamicResource AxSurfacePanelBrush}"
              BorderBrush="{DynamicResource AxStrokeSubtleBrush}" BorderThickness="0,1,0,0"
              Padding="24,10">
        <DockPanel>
          <ax:AxButton DockPanel.Dock="Right" Appearance="Subtle" Content="{ax:Loc common.close}"
                       Click="OnDismissStatus" MinHeight="{DynamicResource AxControlHeightCompact}" FontSize="{DynamicResource AxFontSizeSmall}"/>
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center"
                     FontSize="{DynamicResource AxFontSizeSmall}"/>
        </DockPanel>
      </Border>

      <ScrollViewer>
        <Panel Margin="{DynamicResource AxWelcomePadding}">

          <!-- ===== Projects ===== -->
          <!--
              Ширина не ограничена, и это отличает раздел от остальных. Поиск стоит слева,
              кнопки — у правого края окна, дата недавнего — там же: между ними растёт пустое
              место, а не поле. Закрытый шириной в 980 раздел прижимался бы влево, и в развёрнутом
              окне кнопки оказывались бы посреди экрана с пустотой справа.
          -->
          <StackPanel IsVisible="{Binding IsProjects}" Spacing="0">

            <!--
                Поиск слева, действия справа. «Каркас студии» стоит кнопкой, а не строкой списка:
                это действие, а не проект — ни пути, ни даты у него нет, а плитка с инициалами
                среди настоящих проектов притворялась бы одним из них. Кнопкой оно переживает и
                пустой список, а строкой внутри списка исчезло бы вместе с единственным входом
                в студию.
            -->
            <!--
                Поиск слева, кнопки у правого края, между ними — пустота, а не поле: поле
                растягивается до 340 и дальше не идёт. Когда рядом с полем кнопкам тесно — в узком
                окне или при крупном кегле, — кнопки уходят строкой ниже, а не срезаются краем окна.
                Прежняя сетка с колонкой под кнопки их ширины сжимала поиск в ноль при двойном
                кегле и выталкивала «Каркас студии» за край.

                Кнопки в WrapPanel, а не в стопке: перенесённым под поиск им самим может не хватить
                ширины, и тогда переносятся уже они.
            -->
            <ax:WrapRow Spacing="{DynamicResource AxGapFormRow}">
              <ax:AxSearchField MaxWidth="340"
                                PlaceholderText="{ax:Loc projects.search}"
                                Text="{Binding ProjectFilter, Mode=TwoWay}"/>

              <WrapPanel ItemSpacing="{DynamicResource AxGapFormRow}" LineSpacing="{DynamicResource AxGapControls}">
                <ax:AxButton Appearance="Primary" Content="{ax:Loc projects.new}" Click="OnNewProjectClick"/>
                <ax:AxButton Content="{ax:Loc projects.open}" Click="OnOpenProjectClick"/>
                <ax:AxButton Content="{ax:Loc projects.clone}" Click="OnCloneClick"/>
                <ax:AxButton Appearance="Subtle" Content="{ax:Loc projects.stub}"
                             AutomationProperties.Name="{ax:Loc projects.stub.hint}"
                             ToolTip.Tip="{ax:Loc projects.stub.hint}"
                             Click="OnStudioClick"/>
              </WrapPanel>
            </ax:WrapRow>

            <!-- Черта отделяет действия от списка: выше делают, ниже выбирают. -->
            <ax:AxDivider Margin="{DynamicResource AxSpaceLooseAboveThickness}"/>

            <TextBlock ax:AxText.Role="Section" Text="{ax:Loc projects.recent}" Margin="0,16,0,8"/>

            <TextBlock ax:AxText.Tone="Tertiary" FontSize="{DynamicResource AxFontSizeSmall}" Margin="{DynamicResource AxSpaceEndsThickness}"
                       Text="{ax:Loc projects.empty}"
                       IsVisible="{Binding HasNoRecent}"/>

            <!--
                Строка знает свой проект дважды: Tag="{Binding Path}" для щелчка и Tag="{Binding}"
                у пунктов меню, которым нужна вся запись. Focusable — ради Delete: у клавиши должна
                быть цель, и видно её делает стиль Border.row:focus.
            -->
            <ItemsControl ItemsSource="{Binding RecentProjects}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="svc:RecentProject">
                  <Border Classes="row" MinHeight="58" CornerRadius="{DynamicResource AxCornerRadiusLarge}" Padding="{DynamicResource AxSpaceWideSidesThickness}"
                          Tag="{Binding Path}" Focusable="True"
                          PointerPressed="OnRecentPressed" KeyDown="OnRecentKeyDown">
                    <Border.ContextFlyout>
                      <ax:AxMenuFlyout>
                        <ax:AxMenuItem Header="{ax:Loc projects.open}" Tag="{Binding}" Click="OnRecentOpenClick">
                          <ax:AxMenuItem.Icon>
                            <ax:AxIcon Data="{x:Static ax:AxIcons.FolderOpen}"/>
                          </ax:AxMenuItem.Icon>
                        </ax:AxMenuItem>
                        <ax:AxMenuItem Header="{ax:Loc projects.reveal}" Tag="{Binding}" Click="OnRecentRevealClick">
                          <ax:AxMenuItem.Icon>
                            <ax:AxIcon Data="{x:Static ax:AxIcons.Folder}"/>
                          </ax:AxMenuItem.Icon>
                        </ax:AxMenuItem>
                        <ax:AxMenuItem Header="{ax:Loc projects.copypath}" Tag="{Binding}" Click="OnRecentCopyPathClick">
                          <ax:AxMenuItem.Icon>
                            <ax:AxIcon Data="{x:Static ax:AxIcons.Copy}"/>
                          </ax:AxMenuItem.Icon>
                        </ax:AxMenuItem>
                        <ax:AxMenuItem Header="{ax:Loc projects.remove}" Tag="{Binding}" Click="OnRecentRemoveClick">
                          <ax:AxMenuItem.Icon>
                            <ax:AxIcon Data="{x:Static ax:AxIcons.Trash}"/>
                          </ax:AxMenuItem.Icon>
                        </ax:AxMenuItem>
                      </ax:AxMenuFlyout>
                    </Border.ContextFlyout>
                    <DockPanel>
                      <ax:AxAvatar DockPanel.Dock="Left" Initials="{Binding Initials}" Margin="{DynamicResource AxSpaceWideTrailingThickness}"/>

                      <!--
                          Кнопка меню у правого края, как в Rider. Место под неё занято всегда —
                          иначе дата прыгала бы под курсором, — а сама она показывается, когда
                          строка под курсором или в фокусе. Место держит панель, а не прозрачность:
                          прозрачная кнопка ловила бы щелчки, которых человек ей не адресовал.
                      -->
                      <Panel DockPanel.Dock="Right" Width="28" VerticalAlignment="Center">
                        <ax:AxButton Classes="more" Appearance="Toolbar" Width="24" Height="24"
                                     Tag="{Binding}" Click="OnRecentMoreClick"
                                     AutomationProperties.Name="{ax:Loc projects.actions}"
                                     ToolTip.Tip="{ax:Loc projects.actions}">
                          <ax:AxIcon Data="{x:Static ax:AxIcons.MoreVertical}"/>
                        </ax:AxButton>
                      </Panel>

                      <!--
                          Колонка даты — наименьшая, а не прибитая: сто двадцать держат даты строк
                          одной колонкой, но при крупном кегле дата в них не помещалась и теряла время.
                      -->
                      <TextBlock DockPanel.Dock="Right" ax:AxText.Tone="Tertiary" FontSize="{DynamicResource AxFontSizeSmall}"
                                 MinWidth="120" TextAlignment="Right" VerticalAlignment="Center"
                                 Text="{Binding OpenedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"/>
                      <ax:AxChip DockPanel.Dock="Right" VerticalAlignment="Center" Margin="{DynamicResource AxSpaceSidesThickness}"
                                 Content="{ax:Loc projects.missing}"
                                 IsVisible="{Binding !Exists}"/>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="{DynamicResource AxFontSize}"/>
                        <!-- Путь длиннее строки сокращается многоточием и читается целиком в подсказке. -->
                        <TextBlock ax:AxText.Role="Code" ax:AxText.Tone="Tertiary" Text="{Binding Path}" Margin="0,1,0,0"
                                   FontSize="{DynamicResource AxFontSizeSmall}"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- ===== Learn ===== -->
          <StackPanel IsVisible="{Binding IsLearn}" Spacing="0" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="{ax:Loc learn.title}" FontSize="{DynamicResource AxFontSizeTitle}" FontWeight="SemiBold"/>
            <TextBlock ax:AxText.Tone="Tertiary" FontSize="{DynamicResource AxFontSizeSmall}" Margin="{DynamicResource AxSpaceHairAboveThickness}" Text="{ax:Loc learn.subtitle}"/>

            <ax:AxCard Margin="{DynamicResource AxSpaceSectionAboveThickness}" Padding="{DynamicResource AxSpaceTightThickness}">
              <StackPanel>
                <Border Classes="link-row" Tag="https://github.com/Arxis-Team" PointerPressed="OnLinkPressed">
                  <DockPanel>
                    <ax:AxIcon DockPanel.Dock="Left" Data="{x:Static ax:AxIcons.Document}" Margin="{DynamicResource AxGapIconTextThickness}"/>
                    <TextBlock Classes="link" Text="{ax:Loc learn.docs}" FontSize="{DynamicResource AxFontSize}" VerticalAlignment="Center"/>
                  </DockPanel>
                </Border>
                <Border Classes="link-row" Tag="https://github.com/Arxis-Team" PointerPressed="OnLinkPressed">
                  <DockPanel>
                    <ax:AxIcon DockPanel.Dock="Left" Data="{x:Static ax:AxIcons.List}" Margin="{DynamicResource AxGapIconTextThickness}"/>
                    <TextBlock Classes="link" Text="{ax:Loc learn.api}" FontSize="{DynamicResource AxFontSize}" VerticalAlignment="Center"/>
                  </DockPanel>
                </Border>
                <Border Classes="link-row" Tag="https://github.com/Arxis-Team" PointerPressed="OnLinkPressed">
                  <DockPanel>
                    <ax:AxIcon DockPanel.Dock="Left" Data="{x:Static ax:AxIcons.Package}" Margin="{DynamicResource AxGapIconTextThickness}"/>
                    <TextBlock Classes="link" Text="{ax:Loc learn.samples}" FontSize="{DynamicResource AxFontSize}" VerticalAlignment="Center"/>
                  </DockPanel>
                </Border>
                <Border Classes="link-row" Tag="https://github.com/Arxis-Team" PointerPressed="OnLinkPressed">
                  <DockPanel>
                    <ax:AxIcon DockPanel.Dock="Left" Data="{x:Static ax:AxIcons.Bubble}" Margin="{DynamicResource AxGapIconTextThickness}"/>
                    <TextBlock Classes="link" Text="{ax:Loc learn.community}" FontSize="{DynamicResource AxFontSize}" VerticalAlignment="Center"/>
                  </DockPanel>
                </Border>
              </StackPanel>
            </ax:AxCard>
          </StackPanel>

        </Panel>
      </ScrollViewer>
    </DockPanel>
    </Grid>
  </DockPanel>

</ax:AxWindow>
