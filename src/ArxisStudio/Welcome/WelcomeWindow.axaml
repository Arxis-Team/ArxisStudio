<ax:AxWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ax="https://github.com/Arxis-Team/ArxisStudio"
        xmlns:vm="using:ArxisStudio.ViewModels"
        xmlns:conv="using:ArxisStudio.Converters"
        xmlns:ext="using:ArxisStudio.Extensibility"
        x:Class="ArxisStudio.Welcome.WelcomeWindow"
        x:DataType="vm:WelcomeViewModel"
        Title="{ax:Loc welcome.title}"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <DockPanel>

    <!-- Полоса заголовка: подпись слева, кнопки окна справа. -->
    <ax:AxTitleBar DockPanel.Dock="Top" Height="38">
      <TextBlock Classes="dimmer" Text="{ax:Loc welcome.title}" FontSize="{DynamicResource AxFontSizeSmall}"
                 VerticalAlignment="Center" Margin="14,0"/>
    </ax:AxTitleBar>

    <Grid ColumnDefinitions="230,*">

    <!-- Sidebar 230px: логотип, разделы, Settings, пользователь. -->
    <Border Grid.Column="0" Background="{DynamicResource AxBg2Brush}"
            BorderBrush="{DynamicResource AxBrdBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="10,16,10,12">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="8,0,8,16">
          <ax:AxAvatar Width="34" Height="34" Initials="Ax" FontSize="{DynamicResource AxFontSizeTitle}"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{ax:Loc app.name}" FontWeight="SemiBold" FontSize="{DynamicResource AxFontSize}"/>
            <TextBlock Classes="dimmer" Text="Avalonia 12.1 · net10.0" FontSize="{DynamicResource AxFontSizeSmall}"/>
          </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="8">
          <!--
              Настройки разделом быть перестали: у них своё окно, одно на
              студию и на Welcome. Строка осталась там же, где стояла, и
              отмечается, пока окно открыто.

              Значок — шестерёнка, а не ползунки: дверь в настройки читается
              шестерёнкой везде. Ползунки в наборе остаются за Settings — они
              про подстройку, а не про вход.
          -->
          <ToggleButton Classes="nav" IsChecked="{Binding IsSettingsOpen, Mode=OneWay}"
                        AutomationProperties.Name="{ax:Loc welcome.nav.settings}"
                        Click="OnSettingsClick">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ax:AxIcon Data="{x:Static ax:AxIcons.Gear}"/>
              <TextBlock Text="{ax:Loc welcome.nav.settings}" VerticalAlignment="Center"/>
            </StackPanel>
          </ToggleButton>
          <Border BorderBrush="{DynamicResource AxBrdBrush}" BorderThickness="0,1,0,0" Padding="10,8,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ax:AxAvatar Classes="round" Width="22" Height="22" Initials="FF" FontSize="{DynamicResource AxFontSizeCaption}"
                           TileBrush="{DynamicResource AxPurBrush}"/>
              <TextBlock Classes="dim" Text="FibonacciFox" FontSize="{DynamicResource AxFontSizeSmall}" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="2">
          <ToggleButton Classes="nav" IsChecked="{Binding IsProjects, Mode=OneWay}"
                        AutomationProperties.Name="{ax:Loc welcome.nav.projects}" Click="OnProjectsClick">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ax:AxIcon Data="{x:Static ax:AxIcons.Folder}"/>
              <TextBlock Text="{ax:Loc welcome.nav.projects}" VerticalAlignment="Center"/>
            </StackPanel>
          </ToggleButton>
          <ToggleButton Classes="nav" IsChecked="{Binding IsLearn, Mode=OneWay}"
                        AutomationProperties.Name="{ax:Loc welcome.nav.learn}" Click="OnLearnClick">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ax:AxIcon Data="{x:Static ax:AxIcons.Play}"/>
              <TextBlock Text="{ax:Loc welcome.nav.learn}" VerticalAlignment="Center"/>
            </StackPanel>
          </ToggleButton>
          <!--
              Плагины разделом быть перестали — как и настройки: менеджер живёт
              страницей того же окна, одного на студию и на Welcome. Строка
              осталась там же и отмечается, пока окно открыто.
          -->
          <ToggleButton Classes="nav" IsChecked="{Binding IsPluginsOpen, Mode=OneWay}"
                        AutomationProperties.Name="{ax:Loc welcome.nav.plugins}" Click="OnPluginsClick">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ax:AxIcon Data="{x:Static ax:AxIcons.Package}"/>
              <TextBlock Text="{ax:Loc welcome.nav.plugins}" VerticalAlignment="Center"/>
            </StackPanel>
          </ToggleButton>
        </StackPanel>

      </DockPanel>
    </Border>

    <!-- Контент раздела. -->
    <DockPanel Grid.Column="1">
      <ScrollViewer>
        <Panel Margin="36,28">

          <!-- ===== Projects ===== -->
          <StackPanel IsVisible="{Binding IsProjects}" Spacing="0" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Classes="section" Text="{ax:Loc projects.recent}" Margin="0,0,0,8"/>

            <!--
                Заглушка вместо списка. Работа с проектами приедет отдельным
                модулем, а войти в студию нужно уже сейчас: строка одна и ведёт
                в пустой каркас. Ни пути, ни времени открытия у неё нет —
                открывать пока нечего.

                Список недавних при этом никуда не делся: RecentProjects и
                recent-projects.json остаются моделью, к которой модуль
                вернётся, — исчезло только то, что её показывало.
            -->
            <Border Classes="row" Height="58" CornerRadius="{DynamicResource AxCornerRadiusLarge}" Padding="12,0"
                    PointerPressed="OnStudioPressed">
              <DockPanel>
                <ax:AxAvatar DockPanel.Dock="Left" Initials="AX" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{ax:Loc projects.stub}" FontWeight="Medium"
                             FontSize="{DynamicResource AxFontSize}"/>
                  <TextBlock Classes="dimmer" Text="{ax:Loc projects.stub.hint}"
                             FontSize="{DynamicResource AxFontSizeSmall}" Margin="0,1,0,0"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>

          <!-- ===== Learn ===== -->
          <StackPanel IsVisible="{Binding IsLearn}" Spacing="0" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="{ax:Loc learn.title}" FontSize="{DynamicResource AxFontSizeTitle}" FontWeight="SemiBold"/>
            <TextBlock Classes="dimmer" FontSize="{DynamicResource AxFontSizeSmall}" Margin="0,2,0,0" Text="{ax:Loc learn.subtitle}"/>

            <ax:AxCard Margin="0,22,0,0" Padding="4,2">
              <StackPanel>
                <Border Classes="link-row" Tag="https://github.com/Arxis-Team" PointerPressed="OnLinkPressed">
                  <DockPanel>
                    <ax:AxIcon DockPanel.Dock="Left" Data="{x:Static ax:AxIcons.Document}" Margin="0,0,10,0"/>
                    <TextBlock Classes="link" Text="{ax:Loc learn.docs}" FontSize="{DynamicResource AxFontSize}" VerticalAlignment="Center"/>
                  </DockPanel>
                </Border>
                <Border Classes="link-row" Tag="https://github.com/Arxis-Team" PointerPressed="OnLinkPressed">
                  <DockPanel>
                    <ax:AxIcon DockPanel.Dock="Left" Data="{x:Static ax:AxIcons.List}" Margin="0,0,10,0"/>
                    <TextBlock Classes="link" Text="{ax:Loc learn.api}" FontSize="{DynamicResource AxFontSize}" VerticalAlignment="Center"/>
                  </DockPanel>
                </Border>
                <Border Classes="link-row" Tag="https://github.com/Arxis-Team" PointerPressed="OnLinkPressed">
                  <DockPanel>
                    <ax:AxIcon DockPanel.Dock="Left" Data="{x:Static ax:AxIcons.Package}" Margin="0,0,10,0"/>
                    <TextBlock Classes="link" Text="{ax:Loc learn.samples}" FontSize="{DynamicResource AxFontSize}" VerticalAlignment="Center"/>
                  </DockPanel>
                </Border>
                <Border Classes="link-row" Tag="https://github.com/Arxis-Team" PointerPressed="OnLinkPressed">
                  <DockPanel>
                    <ax:AxIcon DockPanel.Dock="Left" Data="{x:Static ax:AxIcons.Bubble}" Margin="0,0,10,0"/>
                    <TextBlock Classes="link" Text="{ax:Loc learn.community}" FontSize="{DynamicResource AxFontSize}" VerticalAlignment="Center"/>
                  </DockPanel>
                </Border>
              </StackPanel>
            </ax:AxCard>
          </StackPanel>

        </Panel>
      </ScrollViewer>
    </DockPanel>
    </Grid>
  </DockPanel>

</ax:AxWindow>
