<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="using:ArxisStudio.Themes.Arxis"
             xmlns:shell="using:ArxisStudio.Shell"
             x:Class="ArxisStudio.App"
             RequestedThemeVariant="Dark">
  <!-- Канва дизайнера приходит со своей темой: без неё контролы редактора не рисуются. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ArxisStudio.DesignEditor/Themes/ArxisStudioDesignEditorTheme.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <!-- FluentTheme — базовый слой M0 для не-Ax примитивов; поверх — тема и стили студии. -->
  <Application.Styles>
    <FluentTheme/>
    <themes:ArxisTheme/>
    <shell:ShellStyles/>
  </Application.Styles>
</Application>
