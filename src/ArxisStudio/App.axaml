<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ax="https://github.com/Arxis-Team/ArxisStudio"
             x:Class="ArxisStudio.App"
             RequestedThemeVariant="Dark">
  <!--
      Три слоя, и все свои: тема, стили оболочки, стили докинга. Чужой базовой темы здесь больше
      нет — окно, окно попапа и простые контейнеры одеты в AxRoots, и грузить ради трёх шаблонов
      сотню чужих незачем.
  -->
  <Application.Styles>
    <ax:ArxisTheme/>
    <ax:ShellStyles/>
    <ax:DockingStyles/>
  </Application.Styles>
</Application>
