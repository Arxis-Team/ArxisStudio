<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Анализатор компилятора, поэтому netstandard2.0 и никаких ссылок на
        студию: он загружается внутрь сборки плагина и живёт по правилам
        Roslyn, а не по правилам приложения.
    -->
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <RootNamespace>ArxisStudio.Sdk.Analyzers</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>false</IsPackable>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all"/>
    </ItemGroup>

    <!-- Roslyn ведёт учёт правил по выпускам и требует эти два файла. -->
    <ItemGroup>
        <AdditionalFiles Include="AnalyzerReleases.Shipped.md"/>
        <AdditionalFiles Include="AnalyzerReleases.Unshipped.md"/>
    </ItemGroup>

</Project>
