<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Анализатор компилятора, поэтому netstandard2.0 и никаких ссылок на
        студию: он загружается внутрь сборки плагина и живёт по правилам
        Roslyn, а не по правилам приложения.
    -->
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <RootNamespace>ArxisStudio.Sdk.Analyzers</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>false</IsPackable>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all"/>
    </ItemGroup>

    <!--
        Словари темы вшиты в анализатор: правила ARX0008–ARX0010 называют ключи
        по их значениям, и список ключей берётся из самой темы, а не из копии,
        переписанной сюда руками, — копия разошлась бы с темой на первой правке
        шкалы. Словари едут вместе с SDK, поэтому плагин проверяется против той
        темы, против которой собирается.
    -->
    <ItemGroup>
        <EmbeddedResource Include="../../external/ArxisStudio.Themes.Arxis/src/Palette.axaml"
                          LogicalName="theme/Palette.axaml"/>
        <EmbeddedResource Include="../../external/ArxisStudio.Themes.Arxis/src/Typography.axaml"
                          LogicalName="theme/Typography.axaml"/>
        <EmbeddedResource Include="../../external/ArxisStudio.Themes.Arxis/src/Spacing.axaml"
                          LogicalName="theme/Spacing.axaml"/>
    </ItemGroup>

    <!-- Roslyn ведёт учёт правил по выпускам и требует эти два файла. -->
    <ItemGroup>
        <AdditionalFiles Include="AnalyzerReleases.Shipped.md"/>
        <AdditionalFiles Include="AnalyzerReleases.Unshipped.md"/>
    </ItemGroup>

</Project>
