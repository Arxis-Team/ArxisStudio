<!--
    Стили движка докинга: вид группы вкладок и границы между областями.
    Подключается приложением после темы:  <dock:DockingStyles/>
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ArxisStudio.Docking.DockingStyles"
        xmlns:dock="using:ArxisStudio.Docking"
        xmlns:ax="using:ArxisStudio.Controls"
        xmlns:axi="using:ArxisStudio.Icons">

  <Styles.Resources>
    <ResourceDictionary>

      <!--
          Группа — обычное окно инструментов, у которого вместо заголовка
          вкладки. Заголовка нет намеренно: подпись несёт вкладка, и одинокая
          панель выглядит так же, как соседка в паре, — иначе перетаскивание
          превращало бы одно устройство в другое прямо под рукой.
      -->
      <ControlTheme x:Key="{x:Type dock:DockGroupView}" TargetType="dock:DockGroupView">
        <Setter Property="Template">
          <ControlTemplate>
            <!--
                Углы прямые. Скругление у AxToolWindow — для панели, стоящей
                отдельной карточкой; в доках они стоят встык, и на каждом стыке
                скруглённый угол открывает фон оболочки — тот темнее панели, и
                на границах выступают чёрные зазубрины.
            -->
            <ax:AxToolWindow ShowHeaderSeparator="True"
                             ShowHeader="{TemplateBinding HasTabs}"
                             Actions="{TemplateBinding Actions}"
                             CornerRadius="0">
              <!--
                  Кнопка сворачивания едет вместе с вкладками, а не в правом
                  краю шапки: правый край принадлежит хозяину группы — туда
                  оторванное окно кладёт свои кнопки, — и заняв его собой, мы
                  оставили бы окно без крестика. Скрытый ребёнок DockPanel
                  места не занимает, поэтому у группы, которой сворачиваться
                  некуда, шапка остаётся прежней, а вкладки — во всю ширину.

                  Подпись у кнопки меняется вместе с её смыслом, и ставит её
                  код: смыслов два, а свойство одно.
              -->
              <ax:AxToolWindow.Tabs>
                <DockPanel>
                  <ax:AxButton x:Name="PART_Collapse" DockPanel.Dock="Right" Classes="icon"
                               VerticalAlignment="Center"
                               IsVisible="{TemplateBinding CanCollapse}">
                    <!--
                        Контур ставит код, а не привязка. Содержимое кнопки
                        переезжает в её собственный шаблон, и хозяин шаблона у
                        переехавшего меняется с группы на кнопку: и привязка к
                        TemplatedParent, и TemplateBinding перестают находить
                        свойство молча — оба значка остались бы на виду разом.
                    -->
                    <axi:AxIcon x:Name="PART_Fold" Classes="small"/>
                  </ax:AxButton>
                  <ax:AxTabStrip x:Name="PART_Tabs" Theme="{DynamicResource AxToolWindowTabStrip}"/>
                </DockPanel>
              </ax:AxToolWindow.Tabs>
              <ContentControl x:Name="PART_Content"
                              IsVisible="{TemplateBinding Collapsed, Converter={x:Static BoolConverters.Not}}"/>
            </ax:AxToolWindow>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

    </ResourceDictionary>
  </Styles.Resources>

  <!--
      Подсказка: место, которое займёт брошенная вкладка, с её подписью.
      Заливка полупрозрачная — человеку надо видеть, что именно накроет панель,
      а сплошная скрывала бы как раз то, ради чего он смотрит. Настоящих
      областей подсказка не двигает: перекладка на каждой границе зон
      заставляла бы раскладку щёлкать под курсором.
  -->
  <Style Selector="Border.dock-hint">
    <Setter Property="Background" Value="{DynamicResource AxAccBrush}"/>
    <Setter Property="Opacity" Value="0.28"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AxAccStrongBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadius}"/>
  </Style>
  <Style Selector="Border.dock-hint > TextBlock">
    <Setter Property="Margin" Value="10,8"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="Foreground" Value="{DynamicResource AxFgBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSize}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>

  <!--
      Пол рабочей области — цвета оболочки, а не панели. Панели видно только
      потому, что они лежат на чём-то темнее себя: покрась пол в их цвет, и окно
      станет одним ровным пятном, где границы держит одна пиксельная линия.
      Карточка «Заголовок панели» этим не нарушена — шапка по-прежнему без своего
      фона и одного цвета с телом группы, каким бы оно ни было.
  -->
  <Style Selector="dock|DockGroupView[Standing=True] /template/ ax|AxToolWindow">
    <Setter Property="Background" Value="{DynamicResource AxBg1Brush}"/>
  </Style>

  <!--
      Призрак отдельного окна: то же обещание, что и подсказка, но отдельным
      окном — под курсором может быть чужое приложение, и рисовать внутри себя
      там нечего. Заливка сплошная: сквозь чужие окна просвечивать нечему, а
      полупрозрачная рамка над рабочим столом читалась бы грязью.
  -->
  <Style Selector="Border.dock-ghost">
    <Setter Property="Background" Value="{DynamicResource AxBg2Brush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AxAccStrongBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadius}"/>
  </Style>
  <Style Selector="Border.dock-ghost > TextBlock">
    <Setter Property="Margin" Value="12,10"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="Foreground" Value="{DynamicResource AxFgBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSize}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>

  <!--
      Черта в полосе вкладок: у неё вкладка и встанет. Она же и объясняет, что
      место в полосе выбирают тем же движением, каким несут.
  -->
  <Style Selector="Border.dock-caret">
    <Setter Property="Background" Value="{DynamicResource AxAccStrongBrush}"/>
  </Style>

  <!--
      Граница между областями: линия 1px, хит-зона 7px поверх соседей. Сетка
      детей не обрезает, поэтому линия остаётся однопиксельной, как в мокапе, а
      взяться за неё мышью всё-таки можно.
  -->
  <Style Selector="GridSplitter.dock-v">
    <Setter Property="Width" Value="7"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent">
          <Border Width="1" Background="{DynamicResource AxBrdBrush}" HorizontalAlignment="Center"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="GridSplitter.dock-h">
    <Setter Property="Height" Value="7"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent">
          <Border Height="1" Background="{DynamicResource AxBrdBrush}" VerticalAlignment="Center"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

</Styles>
