<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Терминал студии: настоящий псевдотерминал с настоящей оболочкой, как в
        Rider. Под капотом две библиотеки: Porta.Pty даёт псевдотерминал под
        Windows (ConPTY), Linux и macOS, XTerm.NET — эмуляцию VT без единой
        зависимости. Рисует, принимает клавиши и собирает панель модуль сам, на
        контролах студии: вид, тема и доступность остаются нашими.

        Раскладка по папкам, и она же порядок зависимостей:

          Shells/    какие оболочки есть на машине и чем их звать
          Emulator/  перевод через границу XTerm.NET: клавиши туда, цвета оттуда
          Pty/       процесс оболочки под тремя ОС: окружение, байты туда, байты оттуда
          Sessions/  один сеанс и его экран
          Dialogs/   три вопроса человеку: имя, адрес SSH, настройки
          Panels/    панель студии: сеансы вкладками

        Ссылки идут только вниз по этому списку, и это видно по usings:
        Shells и Emulator не знают никого, Pty знает Shells, Sessions знает
        Pty, Shells и Emulator, Dialogs знает Shells, Panels знает Sessions и
        Dialogs. Обратных стрелок нет ни одной — Pty ничего не знает о сеансе,
        сеанс ничего не знает о панели.

        В корне — граница модуля: манифест, точка входа, шов между командами и
        панелью, типизированные ключи настроек. Лежат они там не «потому что
        общие», а потому что это лицо модуля к студии; usings им при этом не
        нужны никому — вложенное пространство имён видит объемлющее само.
    -->
    <PropertyGroup>
        <RootNamespace>ArxisStudio.Modules.Terminal</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
        <PackageReference Include="Porta.Pty"/>
        <PackageReference Include="XTerm.NET"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../ArxisStudio.Sdk/ArxisStudio.Sdk.csproj"/>
        <ProjectReference Include="../../../external/ArxisStudio.Controls/src/ArxisStudio.Controls.csproj"/>
    </ItemGroup>

    <!--
        Анализатор — отдельной строкой, как и у плагина: через цепочку
        ProjectReference анализаторы не передаются. Правила у модуля и у
        плагина одни, и проверяться они должны одинаково — иначе код,
        переносимый между режимами, менял бы смысл при переносе.
    -->
    <ItemGroup>
        <ProjectReference Include="../../ArxisStudio.Sdk.Analyzers/ArxisStudio.Sdk.Analyzers.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <!-- Манифест едет внутри сборки — как у всякого встроенного модуля. -->
    <ItemGroup>
        <EmbeddedResource Include="module.json"/>
    </ItemGroup>

    <!--
        Манифест и словарь — входами сборки, чтобы ARX0002 сверил одно с другим.
        Словарь у модуля не свой: своей папки у него нет, и текст ему дают
        словари самой студии.
    -->
    <ItemGroup>
        <AdditionalFiles Include="module.json"/>
        <AdditionalFiles Include="../../ArxisStudio.Shell/Localization/Strings/en.json"/>
    </ItemGroup>

</Project>
