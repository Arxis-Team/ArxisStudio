{
  "id": "arxis.terminal",
  "name": "%panel.terminal%",
  "version": "1.0.0",
  "publisher": "Arxis",
  "description": "%module.terminal.description%",
  "tags": [ "tools", "terminal" ],
  "contributions": {
    "commands": [
      { "id": "terminal.open", "icon": "arxis:Terminal" },
      { "id": "terminal.new", "icon": "arxis:Plus" },
      { "id": "terminal.newSsh" },
      { "id": "terminal.settings", "icon": "arxis:Gear" }
    ],
    "menus": [
      { "path": "%menu.tools%/%menu.terminal%/%menu.terminal.new%", "command": "terminal.new" },
      { "path": "%menu.tools%/%menu.terminal%/%menu.terminal.ssh%", "command": "terminal.newSsh" },
      { "path": "%menu.tools%/%menu.terminal%/%menu.terminal.settings%", "command": "terminal.settings" }
    ],
    "toolWindows": [
      { "id": "terminal.panel", "title": "%panel.terminal%", "icon": "arxis:Terminal", "placement": { "side": "bottom", "size": 0.3 } }
    ],
    "toolBar": [
      { "id": "terminal.open", "kind": "button", "slot": "right", "command": "terminal.open",
        "title": "%toolbar.terminal.open%" }
    ],
    "settings": [
      { "key": "terminal.shell", "type": "string", "scope": "user", "title": "%settings.terminal.shell%", "default": "" },
      { "key": "terminal.fontSize", "type": "number", "scope": "user", "title": "%settings.terminal.fontSize%", "default": 13 },
      { "key": "terminal.scrollback", "type": "number", "scope": "user", "title": "%settings.terminal.scrollback%", "default": 5000 },
      { "key": "terminal.cursorBlink", "type": "bool", "scope": "user", "title": "%settings.terminal.cursorBlink%", "default": true }
    ]
  },
  "activation": [ "onStartup" ]
}
