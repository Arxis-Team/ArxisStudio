<!--
    Один сеанс: экран во всю панель и строка о том, что оболочка кончилась.
    Строка внизу и до поры скрыта — пока сеанс жив, сказать о нём нечего.
-->
<AxUserControl xmlns="https://github.com/Arxis-Team/ArxisStudio"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:a="https://github.com/avaloniaui"
               xmlns:sessions="using:ArxisStudio.Modules.Terminal.Sessions"
               x:Class="ArxisStudio.Modules.Terminal.Sessions.TerminalSessionView">

  <a:DockPanel>

    <a:Border x:Name="Note"
              a:DockPanel.Dock="Bottom"
              IsVisible="False"
              Padding="{a:DynamicResource AxNotePadding}">
      <a:TextBlock x:Name="Reason" TextWrapping="Wrap"/>
    </a:Border>

    <!--
        Линия над объяснением показывается вместе с ним: линия, отделяющая пустое место от
        пустого места, отделяет одно ничто от другого. Разделитель, а не верхняя рамка плашки, —
        пиксель устройства он меряет сам.
    -->
    <AxDivider a:DockPanel.Dock="Bottom" IsVisible="{a:Binding #Note.IsVisible}"/>

    <sessions:TerminalView x:Name="Screen">
      <a:Control.ContextFlyout>
        <AxMenuFlyout>
          <AxMenuItem x:Name="Copy" Header="{Text terminal.copy}"/>
          <AxMenuItem x:Name="Paste" Header="{Text terminal.paste}"/>
          <AxMenuItem x:Name="SelectAll" Header="{Text terminal.selectAll}"/>
          <AxMenuItem x:Name="Clear" Header="{Text terminal.clear}"/>
        </AxMenuFlyout>
      </a:Control.ContextFlyout>
    </sessions:TerminalView>

  </a:DockPanel>

</AxUserControl>
