<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Контракт службы XAML: то, что видит плагин. Отдельной сборкой по той же причине, что контракт
        службы проектов: модуль держит загрузчик Markup и поколения типов проекта, а типы, которыми с
        ним обмениваются соседи, обязаны быть одни на всех. Модуль объявляет эту сборку в
        provides.contracts, и студия грузит её в общий контекст.

        Ссылки названы все, и больше их не станет: SDK — ради контекста плагина, ядро модели проектов —
        ради путей и диагностик, синтаксис разметки — документ, его редактор и путь элемента, — и
        Avalonia — корень формы и приложение формы. Загрузчика Markup и адаптера ProjectSystem здесь
        нет: их поверхность велика и ещё меняется, а держатель живого объекта чужого поколения не дал
        бы поколению уйти. Всё, что переживает замену поколения, называется путём или именем. Держит
        это XamlContractTests — на собранной сборке.
    -->
    <PropertyGroup>
        <RootNamespace>ArxisStudio.Xaml</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../ArxisStudio.Sdk/ArxisStudio.Sdk.csproj"/>
        <ProjectReference Include="../../../external/ArxisStudio.ProjectSystem/src/ArxisStudio.ProjectSystem/ArxisStudio.ProjectSystem.csproj"/>
        <ProjectReference Include="../../../external/ArxisStudio.Markup/src/ArxisStudio.Markup.Xaml/ArxisStudio.Markup.Xaml.csproj"/>
    </ItemGroup>

</Project>
