<!--
    Окно проекта: полоса поиска, дерево решения и — в две колонки — содержимое выбранного.

    Полоса стоит первой строкой содержимого, а не в шапке панели: шапка в доке студии принадлежит
    группе вкладок. Поиск слева, действия справа — так собрана полоса Solution в Rider; последней
    стоит ⋮ с раскладкой окна.

    Дерево — список строк, а не дерево контролов: список виртуализован, и решение на тысячи файлов
    держит в памяти столько строк, сколько видно. Строка повторяет геометрию строки дерева темы:
    высота строки, отступ — глубина, умноженная на шаг лестницы AxTreeIndent, ячейка шеврона шириной
    в тот же шаг. Отличие одно и названо: у листа ячейка остаётся пустой, и значки соседей стоят
    столбцом, как в Rider. Совпадение держит тест, а не глаз: ProjectWindowParityTests кладёт рядом
    дерево темы.

    Две колонки — как Project в Unity: слева то же дерево, но только контейнеры, справа — что лежит
    в выбранном, крупно, путь до него крошками, внизу строка выбранного и ползунок размера. Одна
    колонка — дерево на всю ширину; правая колонка при этом не разбирается, а прячется: раскладку
    меняют на ходу, и собирать её каждый раз заново незачем.

    Состояния — решение не открыто, открывается, не открылось — лежат поверх содержимого, а не
    подменяют его: подмена значила бы собирать списки заново на каждое открытие.
-->
<AxUserControl xmlns="https://github.com/Arxis-Team/ArxisStudio"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:a="https://github.com/avaloniaui"
               xmlns:ax="https://github.com/Arxis-Team/ArxisStudio"
               xmlns:b="using:ArxisStudio.Modules.Project.Browse"
               xmlns:p="using:ArxisStudio.Modules.Project.Panels"
               xmlns:t="using:ArxisStudio.Modules.Project.Tree"
               x:Class="ArxisStudio.Modules.Project.Panels.ProjectPanelView"
               x:DataType="p:ProjectModel">

  <a:DockPanel>

    <a:Border a:DockPanel.Dock="Top" Padding="{a:DynamicResource AxToolBarPadding}">
      <a:DockPanel>

        <a:StackPanel a:DockPanel.Dock="Right" Orientation="Horizontal" Spacing="{a:DynamicResource AxSpaceHair}"
                      VerticalAlignment="Center">

          <!--
              Перезагрузка решения идёт, пока дерево показывает прежний снимок: служба проектов
              перечитывает решение целиком на каждый новый файл, и молча стоящее дерево выглядело бы
              устаревшим.
          -->
          <AxSpinner x:Name="Loading" IsVisible="{a:Binding IsLoading}" VerticalAlignment="Center"
                     a:ToolTip.Tip="{Text project.loading}"
                     a:AutomationProperties.Name="{Text project.loading}"/>

          <AxButton x:Name="CollapseAll" Appearance="Toolbar"
                    a:ToolTip.Tip="{Text project.collapse}"
                    a:AutomationProperties.Name="{Text project.collapse}">
            <AxIcon Data="{x:Static ax:AxIcons.CollapseAll}"/>
          </AxButton>

          <AxButton x:Name="Options" Appearance="Toolbar"
                    a:ToolTip.Tip="{Text project.options}"
                    a:AutomationProperties.Name="{Text project.options}">
            <AxIcon Data="{x:Static ax:AxIcons.MoreVertical}"/>
          </AxButton>

        </a:StackPanel>

        <AxSearchField x:Name="Query" Size="Compact"
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       MaxWidth="{a:DynamicResource AxSearchFieldMaxWidth}"
                       PlaceholderText="{Text project.search}"
                       a:AutomationProperties.Name="{Text project.search}"/>

      </a:DockPanel>
    </a:Border>

    <AxDivider a:DockPanel.Dock="Top"/>

    <!--
        Перезагрузка не удалась, а снимок остался: дерево честно показывает последнее загруженное,
        и об этом сказано над ним, а не в журнале, куда человек не смотрит.
    -->
    <AxBanner x:Name="Stale" a:DockPanel.Dock="Top" Severity="Warning"
              IsVisible="{a:Binding IsStale}"
              Content="{Text project.state.stale}"/>

    <a:Panel>

      <a:Grid x:Name="Columns" ColumnDefinitions="*,Auto,3*" IsVisible="{a:Binding IsReady}">

        <a:Panel a:Grid.ColumnSpan="{a:Binding TreeSpan}">

          <!--
              Выбор множественный, как в Rider: Ctrl и Shift со щелчком, Shift со стрелками. Правка
              файлов берёт весь выбор, а клавиши дерева — строку, на которой стоит кольцо фокуса.
          -->
          <p:TreeRows x:Name="Tree"
                     ItemsSource="{a:Binding Tree.Rows}"
                     SelectionMode="Multiple"
                     Padding="{a:DynamicResource AxTreeViewPadding}">
            <p:TreeRows.Styles>
              <!--
                  Отбивка строки — строки дерева, а не списка: у дерева она идёт за плотностью (6, 8,
                  10), у строки списка — нет, и в компактной и просторной плотности окно разъехалось
                  бы с деревом темы на две точки.

                  Диктор читает строку по имени узла, а путь от решения — подсказкой к ней: у строки
                  нет своего текста, кроме подписей, и без имени она читалась бы названием типа.
              -->
              <a:Style Selector="AxListBoxItem" x:DataType="t:Row">
                <a:Setter Property="Padding" Value="{a:DynamicResource AxSpaceLeadingThickness}"/>
                <a:Setter Property="a:AutomationProperties.Name" Value="{a:Binding Name}"/>
                <a:Setter Property="a:AutomationProperties.HelpText" Value="{a:Binding Hint}"/>
              </a:Style>
            </p:TreeRows.Styles>
            <p:TreeRows.ItemTemplate>
              <a:DataTemplate x:DataType="t:Row">
                <a:DockPanel Background="Transparent">
                  <a:DockPanel.Margin>
                    <a:MultiBinding Converter="{x:Static p:Indent.Instance}">
                      <a:Binding Path="Depth"/>
                      <a:Binding ElementName="Chevron" Path="Width"/>
                    </a:MultiBinding>
                  </a:DockPanel.Margin>

                  <!--
                      Ячейка шеврона есть у каждой строки, и у листа она пустая: значки соседей стоят
                      столбцом, как в Rider, — по нему глаз и бежит, отыскивая файл. Дерево темы у
                      листа ячейку прячет; для списка файлов столбец дороже этих двадцати точек.
                  -->
                  <a:Border x:Name="Chevron" a:DockPanel.Dock="Left"
                            Width="{a:DynamicResource AxTreeIndent}" Background="Transparent">
                    <a:Panel IsVisible="{a:Binding HasChildren}">
                      <AxIcon Size="Small" Data="{x:Static ax:AxIcons.ChevronRight}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              IsVisible="{a:Binding !IsExpanded}"/>
                      <AxIcon Size="Small" Data="{x:Static ax:AxIcons.ChevronDown}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              IsVisible="{a:Binding IsExpanded}"/>
                    </a:Panel>
                  </a:Border>

                  <AxIcon a:DockPanel.Dock="Left" VerticalAlignment="Center"
                          Margin="{a:DynamicResource AxGapIconTextThickness}"
                          p:Tint.Key="{a:Binding Node, Converter={x:Static p:TintKey.Instance}}" p:Tint.Muted="{a:Binding IsCut}">
                    <AxIcon.Data>
                      <a:MultiBinding Converter="{x:Static p:Glyph.Instance}">
                        <a:Binding Path="Node"/>
                        <a:Binding Path="IsExpanded"/>
                      </a:MultiBinding>
                    </AxIcon.Data>
                  </AxIcon>

                  <!--
                      Сетка, прижатая влево, а не полоса: полоса меряет детей бесконечной шириной, и
                      длинное имя в узком окне обрезалось бы краем без многоточия. Здесь имя
                      сжимается первым, а вторая подпись — версия, платформа, «не загрузился» —
                      остаётся целой.
                  -->
                  <a:Grid ColumnDefinitions="*,Auto" ColumnSpacing="{a:DynamicResource AxGapIconText}"
                          HorizontalAlignment="Left" VerticalAlignment="Center"
                          Margin="{a:DynamicResource AxTreeViewItemPadding}">
                    <a:TextBlock Text="{a:Binding Name}" TextTrimming="CharacterEllipsis"
                                 AxText.Tone="{a:Binding IsCut, Converter={x:Static p:CutTone.Instance}}"/>
                    <a:TextBlock a:Grid.Column="1" Text="{a:Binding Detail}" IsVisible="{a:Binding HasDetail}" AxText.Tone="Secondary"/>
                    <a:TextBlock a:Grid.Column="1" Text="{a:Binding Detail}" IsVisible="{a:Binding IsBroken}" AxText.Tone="Error"
                                 a:ToolTip.Tip="{a:Binding Hint}"/>
                  </a:Grid>
                </a:DockPanel>
              </a:DataTemplate>
            </p:TreeRows.ItemTemplate>
          </p:TreeRows>

          <a:TextBlock IsVisible="{a:Binding NothingFound}" Text="{Text project.search.none}"
                       AxText.Tone="Secondary" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        </a:Panel>

        <AxSplitter x:Name="Splitter" a:Grid.Column="1" Orientation="Vertical" IsVisible="{a:Binding IsTwoColumns}"/>

        <a:DockPanel x:Name="Browser" a:Grid.Column="2" IsVisible="{a:Binding IsTwoColumns}">

          <!--
              Над колонкой — путь до выбранного крошками, а во время поиска — сколько нашлось: поиск
              ищет по всему решению, и пути у найденного нет.
          -->
          <a:Border a:DockPanel.Dock="Top" Padding="{a:DynamicResource AxToolBarPadding}">
            <a:Panel>
              <AxBreadcrumb x:Name="Path" ItemsSource="{a:Binding Browser.Segments}" IsVisible="{a:Binding IsBrowsing}"
                            a:AutomationProperties.Name="{Text project.browser.path}">
                <AxBreadcrumb.Styles>
                  <a:Style Selector="AxBreadcrumbItem" x:DataType="b:Segment">
                    <a:Setter Property="Icon" Value="{a:Binding Node, Converter={x:Static p:NodeGlyph.Instance}}"/>
                  </a:Style>
                </AxBreadcrumb.Styles>
              </AxBreadcrumb>
              <a:TextBlock x:Name="Results" IsVisible="{a:Binding IsSearching}" Text="{a:Binding Results}"
                           AxText.Tone="Secondary" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </a:Panel>
          </a:Border>

          <AxDivider a:DockPanel.Dock="Top"/>

          <!--
              Строка выбранного и ползунок — внизу, как у Unity: путь выбранного, а без выбора —
              сколько в колонке предметов. Ползунок идёт по лестнице плитки: первое положение —
              список, дальше ступени силуэта от малой до крупной. Сколько их, знает тема, и край
              ползунка ставит колонка; колесо с Ctrl и Ctrl с плюсом и минусом двигают тот же ползунок.
          -->
          <a:Border a:DockPanel.Dock="Bottom" Padding="{a:DynamicResource AxToolBarPadding}">
            <a:DockPanel>
              <AxSlider x:Name="Size" a:DockPanel.Dock="Right" VerticalAlignment="Center"
                        Minimum="0" TickFrequency="1" IsSnapToTickEnabled="True"
                        Width="{a:DynamicResource AxTileSliderWidth}"
                        a:ToolTip.Tip="{Text project.browser.size.tip}"
                        a:AutomationProperties.Name="{Text project.browser.size}"
                        a:AutomationProperties.HelpText="{Text project.browser.size.tip}"/>
              <a:TextBlock x:Name="Status" Text="{a:Binding Status}" AxText.Tone="Secondary"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </a:DockPanel>
          </a:Border>

          <AxDivider a:DockPanel.Dock="Bottom"/>

          <a:Panel>

            <!--
                Плитки: что на диске — силуэтом, что в модели — подложкой со значком его вида. Размеры
                плитки — силуэт, её ширина, подложка — колонка ставит списку по ступени лестницы
                (p:TileMetrics), а плитка берёт их у списка: числа лестницы — ключи темы, и в разметке
                их нет.

                Подложка не крупнее обычной ступени: значок на ней размера набора, и на крупных она
                стояла бы пустым квадратом. Место под значок растёт со ступенью, и подложка встаёт
                в нём по центру — подписи ряда остаются на одной линии.
            -->
            <AxListBox x:Name="Tiles" ItemsSource="{a:Binding Browser.Items}" IsVisible="{a:Binding ShowsTiles}"
                       SelectionMode="Multiple"
                       Padding="{a:DynamicResource AxTilePadding}"
                       a:ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <AxListBox.ItemsPanel>
                <a:ItemsPanelTemplate>
                  <a:WrapPanel ItemSpacing="{a:DynamicResource AxSpaceTight}" LineSpacing="{a:DynamicResource AxSpaceTight}"/>
                </a:ItemsPanelTemplate>
              </AxListBox.ItemsPanel>
              <AxListBox.Styles>
                <!--
                    Плитка прижата к верху ряда. Подпись бывает в две строки, ряд берёт высоту самой
                    высокой плитки, а содержимое строки тема ставит по центру — значок двухстрочной
                    уезжал бы вверх от соседей.
                -->
                <a:Style Selector="AxListBoxItem" x:DataType="b:Tile">
                  <a:Setter Property="Padding" Value="{a:DynamicResource AxTilePadding}"/>
                  <a:Setter Property="VerticalAlignment" Value="Top"/>
                  <a:Setter Property="a:ToolTip.Tip" Value=""/>
                  <a:Setter Property="AxTrimmedTip.IsEnabled" Value="True"/>
                  <a:Setter Property="a:AutomationProperties.Name" Value="{a:Binding Name}"/>
                  <a:Setter Property="a:AutomationProperties.HelpText" Value="{a:Binding Hint}"/>
                </a:Style>
                <a:Style Selector="a|StackPanel.tile">
                  <a:Setter Property="Width" Value="{a:Binding $parent[AxListBox].(p:TileMetrics.Width)}"/>
                </a:Style>
                <a:Style Selector="AxIcon.tile">
                  <a:Setter Property="Width" Value="{a:Binding $parent[AxListBox].(p:TileMetrics.Glyph)}"/>
                  <a:Setter Property="Height" Value="{a:Binding $parent[AxListBox].(p:TileMetrics.Glyph)}"/>
                </a:Style>
                <!--
                    Место под значок — квадрат ступени, и у силуэта, и у подложки: подложка не крупнее
                    обычной ступени, и место шириной в неё на крупных ступенях вышло бы узким и высоким —
                    подложка наведения и выбора вокруг него вытягивалась по вертикали.
                -->
                <a:Style Selector="a|Panel.glyph">
                  <a:Setter Property="Width" Value="{a:Binding $parent[AxListBox].(p:TileMetrics.Glyph)}"/>
                  <a:Setter Property="Height" Value="{a:Binding $parent[AxListBox].(p:TileMetrics.Glyph)}"/>
                </a:Style>
                <a:Style Selector="a|Border.plate">
                  <a:Setter Property="Width" Value="{a:Binding $parent[AxListBox].(p:TileMetrics.Plate)}"/>
                  <a:Setter Property="Height" Value="{a:Binding $parent[AxListBox].(p:TileMetrics.Plate)}"/>
                  <a:Setter Property="Background" Value="{a:DynamicResource AxSurfaceRaisedBrush}"/>
                  <a:Setter Property="CornerRadius" Value="{a:DynamicResource AxCornerRadiusLarge}"/>
                </a:Style>
                <!--
                    Состояния плитки — не заливкой во всю плитку, а там, куда смотрят, как в сетках
                    Finder и Unity. Наведение — подложка под значком. Выбор — та же подложка погашенным
                    цветом выделения и плашка под подписью: она горит полным цветом, пока клавиатура в
                    колонке, и гаснет, когда фокус ушёл, — правило выделения студии, только место у него
                    своё. Заливка во всю плитку
                    путала бы состояния: наведённая и погашенно выбранная плитки в тёмной теме почти
                    одного серого, а синий блок выбора ложился под сам силуэт и глушил его цвет.

                    Заливку строки список рисует сам, и здесь она снята; подложка и плашка стоят всегда,
                    прозрачными, — состояние меняет только цвет, и ничего в раскладке не сдвигается.
                    Плашка при этом не рамка с полем: поле отняло бы ширину у подписи каждой плитки, и
                    имя, которому колонки хватало, переломилось бы посреди слова. Её заливка выходит за
                    края подписи в поле плитки (Pill).
                -->
                <a:Style Selector="AxListBoxItem:pointerover /template/ a|ContentPresenter#PART_ContentPresenter">
                  <a:Setter Property="Background" Value="Transparent"/>
                </a:Style>
                <a:Style Selector="AxListBoxItem:selected /template/ a|ContentPresenter#PART_ContentPresenter">
                  <a:Setter Property="Background" Value="Transparent"/>
                </a:Style>
                <!-- Метки строки у плитки нет: её выбор — подложка под значком и плашка под подписью. -->
                <a:Style Selector="AxListBoxItem:selected /template/ a|Border#PART_SelectionMarker">
                  <a:Setter Property="IsVisible" Value="False"/>
                </a:Style>
                <a:Style Selector="a|Border.backdrop">
                  <a:Setter Property="Padding" Value="{a:DynamicResource AxSpaceTightThickness}"/>
                  <a:Setter Property="CornerRadius" Value="{a:DynamicResource AxCornerRadiusLarge}"/>
                </a:Style>
                <a:Style Selector="p|Pill">
                  <a:Setter Property="Outset" Value="{a:DynamicResource AxSpaceTightSidesThickness}"/>
                  <a:Setter Property="CornerRadius" Value="{a:DynamicResource AxCornerRadius}"/>
                </a:Style>
                <a:Style Selector="AxListBoxItem:pointerover a|Border.backdrop">
                  <a:Setter Property="Background" Value="{a:DynamicResource AxHoverBrush}"/>
                </a:Style>
                <a:Style Selector="AxListBoxItem:selected a|Border.backdrop">
                  <a:Setter Property="Background" Value="{a:DynamicResource AxSelectionInactiveBrush}"/>
                </a:Style>
                <a:Style Selector="AxListBoxItem:selected p|Pill">
                  <a:Setter Property="Background" Value="{a:DynamicResource AxSelectionInactiveBrush}"/>
                </a:Style>
                <a:Style Selector="AxListBoxItem:selected:selection-active p|Pill">
                  <a:Setter Property="Background" Value="{a:DynamicResource AxSelectionActiveBrush}"/>
                </a:Style>
              </AxListBox.Styles>
              <AxListBox.ItemTemplate>
                <a:DataTemplate x:DataType="b:Tile">
                  <a:StackPanel Classes="tile" Spacing="{a:DynamicResource AxSpaceHair}">
                    <a:Border Classes="backdrop" HorizontalAlignment="Center">
                      <a:Panel Classes="glyph">
                        <AxIcon Classes="tile" IsVisible="{a:Binding IsSilhouette}"
                                Data="{a:Binding Node, Converter={x:Static p:Silhouette.Instance}}"
                                p:Tint.Key="{a:Binding Node, Converter={x:Static p:TintKey.Instance}}" p:Tint.Muted="{a:Binding IsCut}"/>
                        <a:Border Classes="plate" IsVisible="{a:Binding IsPlate}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                          <AxIcon HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="{a:Binding Node, Converter={x:Static p:NodeGlyph.Instance}}"
                                  p:Tint.Key="{a:Binding Node, Converter={x:Static p:TintKey.Instance}}" p:Tint.Muted="{a:Binding IsCut}"/>
                        </a:Border>
                      </a:Panel>
                    </a:Border>
                    <p:Pill HorizontalAlignment="Center">
                      <a:TextBlock Text="{a:Binding Name}" TextAlignment="Center" TextWrapping="Wrap"
                                   MaxLines="{a:Binding $parent[AxListBox].(p:TileMetrics.Lines)}"
                                   TextTrimming="CharacterEllipsis"
                                   AxText.Tone="{a:Binding IsCut, Converter={x:Static p:CutTone.Instance}}"/>
                    </p:Pill>
                  </a:StackPanel>
                </a:DataTemplate>
              </AxListBox.ItemTemplate>
            </AxListBox>

            <!--
                Ступень «список» — строки, как у дерева, только без лестницы: вложенный файл отступает
                на шаг за владельцем.
            -->
            <AxListBox x:Name="Files" ItemsSource="{a:Binding Browser.Items}" IsVisible="{a:Binding ShowsList}"
                       SelectionMode="Multiple"
                       Padding="{a:DynamicResource AxTreeViewPadding}">
              <AxListBox.Styles>
                <a:Style Selector="AxListBoxItem" x:DataType="b:Tile">
                  <a:Setter Property="Padding" Value="{a:DynamicResource AxSpaceLeadingThickness}"/>
                  <a:Setter Property="a:AutomationProperties.Name" Value="{a:Binding Name}"/>
                  <a:Setter Property="a:AutomationProperties.HelpText" Value="{a:Binding Hint}"/>
                </a:Style>
              </AxListBox.Styles>
              <AxListBox.ItemTemplate>
                <a:DataTemplate x:DataType="b:Tile">
                  <a:DockPanel Background="Transparent">
                    <a:Border a:DockPanel.Dock="Left" Width="{a:DynamicResource AxTreeIndent}" IsVisible="{a:Binding IsNested}"/>
                    <AxIcon a:DockPanel.Dock="Left" VerticalAlignment="Center"
                            Margin="{a:DynamicResource AxGapIconTextThickness}"
                            Data="{a:Binding Node, Converter={x:Static p:NodeGlyph.Instance}}"
                            p:Tint.Key="{a:Binding Node, Converter={x:Static p:TintKey.Instance}}" p:Tint.Muted="{a:Binding IsCut}"/>
                    <a:Grid ColumnDefinitions="*,Auto" ColumnSpacing="{a:DynamicResource AxGapIconText}"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="{a:DynamicResource AxTreeViewItemPadding}">
                      <a:TextBlock Text="{a:Binding Name}" TextTrimming="CharacterEllipsis"
                                 AxText.Tone="{a:Binding IsCut, Converter={x:Static p:CutTone.Instance}}"/>
                      <a:TextBlock a:Grid.Column="1" Text="{a:Binding Detail}" IsVisible="{a:Binding HasDetail}" AxText.Tone="Secondary"/>
                    </a:Grid>
                  </a:DockPanel>
                </a:DataTemplate>
              </AxListBox.ItemTemplate>
            </AxListBox>

            <a:TextBlock IsVisible="{a:Binding BrowserEmpty}" Text="{Text project.browser.empty}"
                         AxText.Tone="Secondary" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <a:TextBlock IsVisible="{a:Binding BrowserNothingFound}" Text="{Text project.search.none}"
                         AxText.Tone="Secondary" HorizontalAlignment="Center" VerticalAlignment="Center"/>

          </a:Panel>

        </a:DockPanel>

      </a:Grid>

      <a:StackPanel IsVisible="{a:Binding IsClosed}" Spacing="{a:DynamicResource AxGapFormRow}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="{a:DynamicResource AxSpaceWideThickness}">
        <a:TextBlock Text="{Text project.state.closed}" AxText.Tone="Secondary" HorizontalAlignment="Center"/>
        <a:TextBlock Text="{Text project.state.closed.hint}" AxText.Role="Small" AxText.Tone="Tertiary"
                     HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
        <AxButton x:Name="OpenSolution" Content="{Text project.state.open}" HorizontalAlignment="Center"/>
      </a:StackPanel>

      <a:TextBlock IsVisible="{a:Binding IsNoService}" Text="{Text project.state.noService}"
                   AxText.Tone="Secondary" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" TextAlignment="Center" Margin="{a:DynamicResource AxSpaceWideThickness}"/>

      <a:StackPanel IsVisible="{a:Binding IsOpening}" Orientation="Horizontal" Spacing="{a:DynamicResource AxGapIconText}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
        <AxSpinner VerticalAlignment="Center"/>
        <a:TextBlock Text="{a:Binding Opening}" AxText.Tone="Secondary" VerticalAlignment="Center"/>
      </a:StackPanel>

      <!--
          Неудача — содержимое окна, а не сообщение поверх него: баннер закрывается крестиком и
          унёс бы с собой «Повторить», а показать вместо дерева больше нечего.
      -->
      <a:StackPanel IsVisible="{a:Binding IsFailed}" Spacing="{a:DynamicResource AxGapFormRow}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="{a:DynamicResource AxSpaceWideThickness}">
        <a:TextBlock Text="{Text project.state.failed}" AxText.Tone="Secondary" HorizontalAlignment="Center"/>
        <a:TextBlock x:Name="Failure" Text="{a:Binding Failure}" AxText.Role="Small" AxText.Tone="Error"
                     HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
        <AxButton x:Name="Retry" Content="{Text project.state.retry}" HorizontalAlignment="Center"/>
      </a:StackPanel>

    </a:Panel>

  </a:DockPanel>

</AxUserControl>
