<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Панель проекта — встроенный модуль. Модель решения ему нужна целиком,
        поэтому ссылка на ProjectSystem прямая: модуль приезжает со студией и
        одну библиотеку с ней делит, а не везёт свою.
    -->
    <PropertyGroup>
        <RootNamespace>ArxisStudio.Modules.Project</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../ArxisStudio.Sdk/ArxisStudio.Sdk.csproj"/>
        <ProjectReference Include="../../ArxisStudio.Shell/ArxisStudio.Shell.csproj"/>
        <ProjectReference Include="../../../external/ArxisStudio.Controls/src/ArxisStudio.Controls.csproj"/>
        <ProjectReference Include="../../../external/ArxisStudio.ProjectSystem/src/ArxisStudio.ProjectSystem/ArxisStudio.ProjectSystem.csproj"/>
    </ItemGroup>

    <!-- Манифест модуля живёт в сборке: своей папки у модуля нет. -->
    <ItemGroup>
        <EmbeddedResource Include="module.json"/>
    </ItemGroup>

    <!-- Построение дерева проверяют тесты студии. -->
    <ItemGroup>
        <InternalsVisibleTo Include="ArxisStudio.Tests"/>
    </ItemGroup>

</Project>
