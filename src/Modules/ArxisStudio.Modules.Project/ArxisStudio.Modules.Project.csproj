<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Окно проекта: открытое решение деревом, как Solution в Rider, в одну или две колонки, как
        Project в Unity. Решение модуль берёт у службы проектов — её контракт соседа, — а на саму
        студию не ссылается: всё, что ему нужно, приходит службами контекста.

        Зависимости внутри модуля идут в одну сторону: Model (снимок → дерево, без Avalonia) →
        Looks (узел → значок и цвет) → Tree (раскрытие и плоский список строк) → Panels (вид,
        клавиатура, меню). Модель и дерево строк от контролов не зависят: их проверяют без окна, и
        плоское дерево переедет в библиотеку со вторым потребителем.
    -->
    <PropertyGroup>
        <RootNamespace>ArxisStudio.Modules.Project</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>

        <!--
            Размер картинки по заголовку — у декодера, которым рисует Avalonia: своего такого вопроса у
            неё нет, а превью без него растягивало бы иконку 16×16 во всю плитку. Только для
            компиляции: сборка едет со студией в lib/, тем же экземпляром, что у Avalonia.Skia, и в
            папку модуля не копируется.
        -->
        <PackageReference Include="SkiaSharp" IncludeAssets="compile" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../ArxisStudio.Sdk/ArxisStudio.Sdk.csproj"/>
        <ProjectReference Include="../../../external/ArxisStudio.Controls/src/ArxisStudio.Controls.csproj"/>

        <!--
            Контракт соседа — только для компиляции: возит его владелец, модуль «Проекты». Копия в
            своей папке дала бы вторую сборку того же контракта, и AXL1002 не дал бы собрать студию.
        -->
        <ProjectReference Include="../ArxisStudio.Projects.Contracts/ArxisStudio.Projects.Contracts.csproj"
                          Private="false" ExcludeAssets="runtime"/>
    </ItemGroup>

    <!--
        Анализатор — отдельной строкой, как и у плагина: через цепочку ProjectReference анализаторы
        не передаются.
    -->
    <ItemGroup>
        <ProjectReference Include="../../ArxisStudio.Sdk.Analyzers/ArxisStudio.Sdk.Analyzers.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <!-- Манифест — входом сборки: по нему ARX0002 сверяет %ключи% со словарём модуля. -->
    <ItemGroup>
        <AdditionalFiles Include="module.json"/>
    </ItemGroup>

    <!--
        Тестам открыты модель, строки дерева и склейка панели: проверяется наблюдаемое поведение
        окна, а не его разметка, и без этого окно пришлось бы искать по дереву контролов.
    -->
    <ItemGroup>
        <InternalsVisibleTo Include="ArxisStudio.Tests"/>
    </ItemGroup>

</Project>
