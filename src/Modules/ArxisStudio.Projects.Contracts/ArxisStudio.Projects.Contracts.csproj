<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Контракт службы проектов: то, что видит плагин. Живёт отдельной сборкой, а не в
        модуле, и причина в разных сроках жизни. Модуль держит движок — MSBuild, который
        регистрируется на процесс один раз, — а типы, которыми с модулем обмениваются соседи,
        обязаны быть одни на всех. Модуль объявляет эту сборку в provides.contracts, и студия
        грузит её в общий контекст.

        Ссылок две, и больше их не станет: SDK — ради контекста плагина, ядро модели проектов
        — ради снимков. Ни Avalonia, ни MSBuild, ни NuGet: контракт, притянувший движок,
        притянул бы его к каждому потребителю, и шов под отдельный процесс закрылся бы уже на
        уровне типов. Держит это ProjectsContractTests — на собранной сборке, а не на
        честном слове этого файла.
    -->
    <PropertyGroup>
        <RootNamespace>ArxisStudio.Projects</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../../ArxisStudio.Sdk/ArxisStudio.Sdk.csproj"/>
        <ProjectReference Include="../../../external/ArxisStudio.ProjectSystem/src/ArxisStudio.ProjectSystem/ArxisStudio.ProjectSystem.csproj"/>
    </ItemGroup>

</Project>
