<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Консоль студии: журнал того, что студия и расширения сказали за сеанс. Панель одна и
        просится вниз — вкладкой её делает сам док.

        Раскладка по папкам, и она же порядок зависимостей:

          Feed/    как записи доезжают до списка: склейка перестроений в один кадр и коллекция,
                   меняющая содержимое одним событием
          Log/     что такое строка журнала: отбор, свёртка, счётчики, вид записи текстом
          Panels/  панель и её части: полоса, меню источников, меню строки, разметка

        Ссылки идут только вниз по этому списку: Feed не знает никого, Log не знает Feed, Panels
        знают обе. Обратных стрелок нет ни одной — ни строка журнала, ни склейка перестроений
        ничего не знают о панели.

        В корне — граница модуля: манифест, точка входа, шов между командой и панелью,
        типизированные ключи настроек. Лежат они там не «потому что общие», а потому что это лицо
        модуля к студии.
    -->
    <PropertyGroup>
        <RootNamespace>ArxisStudio.Modules.Console</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../ArxisStudio.Sdk/ArxisStudio.Sdk.csproj"/>
        <ProjectReference Include="../../../external/ArxisStudio.Controls/src/ArxisStudio.Controls.csproj"/>
    </ItemGroup>

    <!--
        Анализатор — отдельной строкой, как и у плагина: через цепочку
        ProjectReference анализаторы не передаются. Правила у модуля и у
        плагина одни, и проверяться они должны одинаково — иначе код,
        переносимый между режимами, менял бы смысл при переносе.
    -->
    <ItemGroup>
        <ProjectReference Include="../../ArxisStudio.Sdk.Analyzers/ArxisStudio.Sdk.Analyzers.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <!--
        Манифест — входом сборки: по нему ARX0002 сверяет %ключи% со словарём модуля.
        Сам словарь подаёт общий src/Modules/Directory.Build.targets, одним правилом на все модули.
    -->
    <ItemGroup>
        <AdditionalFiles Include="module.json"/>
    </ItemGroup>

    <!--
        Тестам открыты внутренности: пункты меню собираются в коде, а показываются в попапе —
        в отдельном окне, которого у безголового прогона нет. Проверять их там, где они
        рождаются, честнее, чем через окно, которого не будет.
    -->
    <ItemGroup>
        <InternalsVisibleTo Include="ArxisStudio.Tests"/>
    </ItemGroup>

</Project>
