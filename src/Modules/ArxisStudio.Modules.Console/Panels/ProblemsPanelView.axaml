<!--
    Панель находок: полоса отбора, таблица и подробности выбранной.

    Устроена так же, как панель журнала, и намеренно: две панели одной группы,
    между которыми человек переключается вкладкой, обязаны читаться одинаково.
    Общего кода у них при этом почти нет — различий больше, чем сходства:
    здесь нет очистки, нет свёртки и нет источника, зато есть открытие файла.
-->
<AxUserControl xmlns="https://github.com/Arxis-Team/ArxisStudio"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:a="https://github.com/avaloniaui"
               xmlns:ax="https://github.com/Arxis-Team/ArxisStudio"
               xmlns:feed="using:ArxisStudio.Modules.Console.Feed"
               xmlns:problems="using:ArxisStudio.Modules.Console.Problems"
               x:Class="ArxisStudio.Modules.Console.Panels.ProblemsPanelView">

  <a:DockPanel>

    <a:Border a:DockPanel.Dock="Top"
              Padding="4,2"
              BorderThickness="0,0,0,1"
              BorderBrush="{a:DynamicResource AxBrdBrush}">
      <a:DockPanel>

        <a:StackPanel a:DockPanel.Dock="Left" Orientation="Horizontal" Spacing="2"
                      VerticalAlignment="Center">

          <feed:ConsoleToggle x:Name="Errors" Classes="compact ghost error"
                              a:ToolTip.Tip="{Text console.level.error}"
                              a:AutomationProperties.Name="{Text console.level.error}">
            <a:StackPanel Orientation="Horizontal" Spacing="4">
              <AxIcon x:Name="ErrorIcon" Classes="small" Data="{x:Static ax:AxIcons.Error}"/>
              <a:TextBlock x:Name="ErrorCount" VerticalAlignment="Center"/>
            </a:StackPanel>
          </feed:ConsoleToggle>

          <feed:ConsoleToggle x:Name="Warnings" Classes="compact ghost warn"
                              a:ToolTip.Tip="{Text console.level.warning}"
                              a:AutomationProperties.Name="{Text console.level.warning}">
            <a:StackPanel Orientation="Horizontal" Spacing="4">
              <AxIcon x:Name="WarningIcon" Classes="small" Data="{x:Static ax:AxIcons.Warning}"/>
              <a:TextBlock x:Name="WarningCount" VerticalAlignment="Center"/>
            </a:StackPanel>
          </feed:ConsoleToggle>

          <feed:ConsoleToggle x:Name="Infos" Classes="compact ghost"
                              a:ToolTip.Tip="{Text console.level.info}"
                              a:AutomationProperties.Name="{Text console.level.info}">
            <a:StackPanel Orientation="Horizontal" Spacing="4">
              <AxIcon Classes="small" Data="{x:Static ax:AxIcons.Info}"/>
              <a:TextBlock x:Name="InfoCount" VerticalAlignment="Center"/>
            </a:StackPanel>
          </feed:ConsoleToggle>

          <AxDivider Orientation="Vertical" Classes="toolbar"/>
        </a:StackPanel>

        <a:StackPanel a:DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2"
                      VerticalAlignment="Center">

          <AxButton x:Name="Open" Classes="icon" IsEnabled="False"
                    a:ToolTip.Tip="{Text problems.open}"
                    a:AutomationProperties.Name="{Text problems.open}">
            <AxIcon Classes="small" Data="{x:Static ax:AxIcons.ExternalLink}"/>
          </AxButton>

          <feed:ConsoleToggle x:Name="Details" Classes="icon"
                              a:ToolTip.Tip="{Text problems.details}"
                              a:AutomationProperties.Name="{Text problems.details}">
            <AxIcon Classes="small" Data="{x:Static ax:AxIcons.Split}"/>
          </feed:ConsoleToggle>

        </a:StackPanel>

        <AxSearchField x:Name="Query" Classes="compact"
                       PlaceholderText="{Text problems.search}"
                       MaxWidth="360" HorizontalAlignment="Left" Margin="8,0"
                       VerticalAlignment="Center"
                       a:AutomationProperties.Name="{Text problems.search}"/>

      </a:DockPanel>
    </a:Border>

    <!--
        Таблица и подробности делят место долями. Вторая строка сначала нулевая:
        подробности показывает переключатель, и он же меняет её долю — скрытая
        строка ненулевой высоты оставляла бы под собой пустую полосу.
    -->
    <a:Grid x:Name="Body" RowDefinitions="2*,Auto,0">

      <a:Panel a:Grid.Row="0">

        <!--
            Столбцы выравнены тем, что одни и те же определения стоят и в шапке,
            и в шаблоне строки: так их держит AxDataGrid — своих столбцов у него
            нет, он список со строкой заголовков.
        -->
        <AxDataGrid x:Name="Findings" SelectionMode="Single">
          <AxDataGrid.Header>
            <a:Grid ColumnDefinitions="24,90,*,160">
              <a:TextBlock a:Grid.Column="1" Text="{Text problems.column.code}"/>
              <a:TextBlock a:Grid.Column="2" Text="{Text problems.column.message}"/>
              <a:TextBlock a:Grid.Column="3" Text="{Text problems.column.where}"/>
            </a:Grid>
          </AxDataGrid.Header>

          <AxDataGrid.ItemTemplate>
            <a:DataTemplate x:DataType="problems:ProblemRow">
              <!--
                  Высота минимумом, а не числом: строка однострочна, поэтому
                  строки одинаковы и оценка длины у списка точна, — но текст,
                  увеличенный человеком вдвое, в неё поместится.
              -->
              <a:Grid MinHeight="{a:DynamicResource AxRowHeight}"
                      ColumnDefinitions="24,90,*,160">

                <!--
                    Три значка вместо одного с выбором цвета в коде: какой из
                    них показать — дело данных. Цвет при этом приходит вместе со
                    строкой: кисти панель спрашивает у темы один раз.
                -->
                <a:Panel a:Grid.Column="0">
                  <AxIcon Classes="small" Data="{x:Static ax:AxIcons.Error}"
                          Foreground="{a:Binding Tint}" IsVisible="{a:Binding IsError}"/>
                  <AxIcon Classes="small" Data="{x:Static ax:AxIcons.Warning}"
                          Foreground="{a:Binding Tint}" IsVisible="{a:Binding IsWarning}"/>
                  <AxIcon Classes="small" Data="{x:Static ax:AxIcons.Info}"
                          IsVisible="{a:Binding IsInfo}"/>
                </a:Panel>

                <a:TextBlock a:Grid.Column="1" Classes="mono dim" Text="{a:Binding Code}"
                             VerticalAlignment="Center"/>

                <a:TextBlock a:Grid.Column="2" Text="{a:Binding Text}"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                <a:TextBlock a:Grid.Column="3" Classes="mono dim" Text="{a:Binding Where}"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

              </a:Grid>
            </a:DataTemplate>
          </AxDataGrid.ItemTemplate>
        </AxDataGrid>

        <!--
            Пустой список находок — обычное состояние студии, а не поломка:
            сообщать о них некому, пока не встанет расширение, которое умеет.
            Поэтому под объяснением стоит вторая строка — она и говорит, что
            пусто здесь по делу.
        -->
        <a:StackPanel x:Name="Empty" Spacing="6"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
          <a:TextBlock x:Name="EmptyText" Classes="dim" TextAlignment="Center"/>
          <a:TextBlock x:Name="EmptyHint" Classes="dim" TextAlignment="Center"
                       FontSize="{a:DynamicResource AxFontSizeSmall}"
                       Text="{Text problems.empty.hint}"/>
        </a:StackPanel>

      </a:Panel>

      <AxSplitter x:Name="Handle" a:Grid.Row="1" Orientation="Horizontal" IsVisible="False"
                  a:AutomationProperties.Name="{Text problems.details}"/>

      <!--
          Подробности занимают треть панели, а не заданное число пикселей:
          панель дока бывает невысокой, и полтораста пикселей съедали бы её
          целиком — список пропадал бы с глаз. Дальше долю правит человек:
          выше стоит AxSplitter, и прячется он вместе с подробностями —
          граница, которой не с чем граничить, ничего не разделяет.
      -->
      <a:Border x:Name="DetailsPane" a:Grid.Row="2" IsVisible="False"
                BorderThickness="0,1,0,0"
                BorderBrush="{a:DynamicResource AxBrdBrush}">
        <!--
            Своего минимума высоты у поля здесь нет: многострочному полю его
            даёт тема — четыре строки, — а высоту подробностей решает граница,
            которую тянет человек. С минимумом поле переставало помещаться в
            отведённую долю и вылезало за нижний край панели.
        -->
        <AxTextArea x:Name="DetailsText" MinHeight="0" IsReadOnly="True" AcceptsReturn="True"
                    TextWrapping="Wrap" BorderThickness="0"
                    FontSize="{a:DynamicResource AxFontSizeSmall}"
                    a:AutomationProperties.Name="{Text problems.details}"/>
      </a:Border>

    </a:Grid>

  </a:DockPanel>

</AxUserControl>
