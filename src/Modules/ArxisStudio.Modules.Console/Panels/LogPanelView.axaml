<!--
    Панель журнала: полоса отбора, список записей и подробности выбранной.

    Полоса стоит первой строкой содержимого, а не в шапке панели: в доке студии
    шапка принадлежит группе вкладок — там живут вкладки соседних панелей и
    кнопки студии, — и делить её с ними панель не может.

    По умолчанию словарь студии: контрол без префикса — её контрол. Всё родное
    Avalonia пишется через a:.
-->
<AxUserControl xmlns="https://github.com/Arxis-Team/ArxisStudio"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:a="https://github.com/avaloniaui"
               xmlns:ax="https://github.com/Arxis-Team/ArxisStudio"
               xmlns:log="using:ArxisStudio.Modules.Console.Log"
               x:Class="ArxisStudio.Modules.Console.Panels.LogPanelView">

  <a:DockPanel>

    <a:Border a:DockPanel.Dock="Top"
              Padding="{a:DynamicResource AxToolBarPadding}">
      <a:DockPanel>

        <!--
            Счётчики слева — они же переключатели уровня, как в консоли Unity.
            Число всегда о всём журнале, а не о показанном: счётчик, падающий
            до нуля оттого, что уровень выключили, ничего не сообщает.
        -->
        <a:StackPanel a:DockPanel.Dock="Left" Orientation="Horizontal" Spacing="{a:DynamicResource AxSpaceHair}"
                      VerticalAlignment="Center">

          <AxToggleButton x:Name="Errors" Appearance="Subtle" Size="Compact"
                              a:ToolTip.Tip="{Text console.level.error}"
                              a:AutomationProperties.Name="{Text console.level.error}">
            <a:StackPanel Orientation="Horizontal" Spacing="{a:DynamicResource AxSpaceTight}">
              <AxIcon x:Name="ErrorIcon" Size="Small" Data="{x:Static ax:AxIcons.Error}"/>
              <a:TextBlock x:Name="ErrorCount" VerticalAlignment="Center"/>
            </a:StackPanel>
          </AxToggleButton>

          <AxToggleButton x:Name="Warnings" Appearance="Subtle" Size="Compact"
                              a:ToolTip.Tip="{Text console.level.warning}"
                              a:AutomationProperties.Name="{Text console.level.warning}">
            <a:StackPanel Orientation="Horizontal" Spacing="{a:DynamicResource AxSpaceTight}">
              <AxIcon x:Name="WarningIcon" Size="Small" Data="{x:Static ax:AxIcons.Warning}"/>
              <a:TextBlock x:Name="WarningCount" VerticalAlignment="Center"/>
            </a:StackPanel>
          </AxToggleButton>

          <AxToggleButton x:Name="Infos" Appearance="Subtle" Size="Compact"
                              a:ToolTip.Tip="{Text console.level.info}"
                              a:AutomationProperties.Name="{Text console.level.info}">
            <a:StackPanel Orientation="Horizontal" Spacing="{a:DynamicResource AxSpaceTight}">
              <AxIcon Size="Small" Data="{x:Static ax:AxIcons.Info}"/>
              <a:TextBlock x:Name="InfoCount" VerticalAlignment="Center"/>
            </a:StackPanel>
          </AxToggleButton>

          <AxToggleButton x:Name="Debugs" Appearance="Subtle" Size="Compact"
                              a:ToolTip.Tip="{Text console.level.debug}"
                              a:AutomationProperties.Name="{Text console.level.debug}">
            <a:StackPanel Orientation="Horizontal" Spacing="{a:DynamicResource AxSpaceTight}">
              <AxIcon Size="Small" Data="{x:Static ax:AxIcons.Debug}"/>
              <a:TextBlock x:Name="DebugCount" VerticalAlignment="Center"/>
            </a:StackPanel>
          </AxToggleButton>

          <AxDivider Orientation="Vertical" Classes="toolbar"/>
        </a:StackPanel>

        <!--
            Вид кнопок один: Toolbar делает кнопку квадратной по высоте строки, а
            тесный размер вместо него вернул бы минимальную ширину кнопки с
            текстом. Подпись у каждой двойная: подсказка под курсором и имя для
            средств доступности — значка средствам доступности мало.
        -->
        <a:StackPanel a:DockPanel.Dock="Right" Orientation="Horizontal" Spacing="{a:DynamicResource AxSpaceHair}"
                      VerticalAlignment="Center">

          <AxButton x:Name="Sources" Appearance="Toolbar"
                    a:ToolTip.Tip="{Text console.source}"
                    a:AutomationProperties.Name="{Text console.source}">
            <AxIcon Size="Small" Data="{x:Static ax:AxIcons.Filter}"/>
          </AxButton>

          <AxToggleButton x:Name="Collapse" Appearance="Toolbar"
                              a:ToolTip.Tip="{Text console.collapse}"
                              a:AutomationProperties.Name="{Text console.collapse}">
            <AxIcon Size="Small" Data="{x:Static ax:AxIcons.CollapseAll}"/>
          </AxToggleButton>

          <AxToggleButton x:Name="Autoscroll" Appearance="Toolbar"
                              a:ToolTip.Tip="{Text console.autoscroll}"
                              a:AutomationProperties.Name="{Text console.autoscroll}">
            <AxIcon Size="Small" Data="{x:Static ax:AxIcons.Download}"/>
          </AxToggleButton>

          <AxToggleButton x:Name="Details" Appearance="Toolbar"
                              a:ToolTip.Tip="{Text console.details}"
                              a:AutomationProperties.Name="{Text console.details}">
            <AxIcon Size="Small" Data="{x:Static ax:AxIcons.Split}"/>
          </AxToggleButton>

          <AxButton x:Name="Copy" Appearance="Toolbar"
                    a:ToolTip.Tip="{Text console.copy}"
                    a:AutomationProperties.Name="{Text console.copy}">
            <AxIcon Size="Small" Data="{x:Static ax:AxIcons.Copy}"/>
          </AxButton>

          <AxButton x:Name="Clear" Appearance="Toolbar"
                    a:ToolTip.Tip="{Text console.clear}"
                    a:AutomationProperties.Name="{Text console.clear}">
            <AxIcon Size="Small" Data="{x:Static ax:AxIcons.Trash}"/>
          </AxButton>

        </a:StackPanel>

        <AxSearchField x:Name="Query" Size="Compact"
                       PlaceholderText="{Text console.search}"
                       MaxWidth="360" HorizontalAlignment="Left" Margin="{a:DynamicResource AxSpaceSidesThickness}"
                       VerticalAlignment="Center"
                       a:AutomationProperties.Name="{Text console.search}"/>

      </a:DockPanel>
    </a:Border>

    <!--
        Линия под полосой — разделитель, а не нижняя рамка: пиксель устройства он меряет сам, а
        раскладочная единица при 150 % даёт два, и полоса обрастала кантом вдвое толще линий, на
        которых собран весь остальной хром студии.
    -->
    <AxDivider a:DockPanel.Dock="Top"/>


    <!--
        Список и подробности делят место долями. Вторая строка сначала нулевая:
        подробности показывает переключатель, и он же меняет её долю — скрытая
        строка ненулевой высоты оставляла бы под собой пустую полосу.
    -->
    <a:Grid x:Name="Body" RowDefinitions="2*,Auto,0">

    <!--
        Список и объяснение пустоты лежат рядом, а не подменяют друг друга:
        подмена значила бы, что список собирают заново при каждой очистке.
    -->
    <a:Panel a:Grid.Row="0">
        <AxListBox x:Name="Records" SelectionMode="Single">
          <AxListBox.ItemTemplate>
            <a:DataTemplate x:DataType="log:LogRow">

              <!--
                  Высота задана минимумом, а не числом: строка всегда однострочна
                  — длинное сообщение обрезается многоточием, — поэтому строки
                  одинаковы, и виртуализированный список оценивает длину
                  содержимого точно. Прибитая высота дала бы то же самое, но
                  обрезала бы текст, когда человек увеличил его вдвое.
              -->
              <a:Grid MinHeight="{a:DynamicResource AxRowHeight}"
                      ColumnDefinitions="Auto,Auto,Auto,*,Auto">

                <a:TextBlock a:Grid.Column="0" AxText.Role="Code" AxText.Tone="Secondary"
                             Text="{a:Binding Stamp}" IsVisible="{a:Binding HasStamp}"
                             VerticalAlignment="Center" Margin="{a:DynamicResource AxSpaceTrailingThickness}"/>

                <a:TextBlock a:Grid.Column="1" Text="{a:Binding Level}" MinWidth="52"
                             FontWeight="SemiBold" VerticalAlignment="Center" Margin="{a:DynamicResource AxSpaceTrailingThickness}"
                             AxText.Tone="{a:Binding LevelTone}"/>

                <a:TextBlock a:Grid.Column="2" AxText.Tone="Secondary" Text="{a:Binding Source}"
                             VerticalAlignment="Center" Margin="{a:DynamicResource AxSpaceTrailingThickness}"/>

                <a:TextBlock a:Grid.Column="3" Text="{a:Binding Text}"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                <AxBadge a:Grid.Column="4" Content="{a:Binding RepeatsText}"
                         IsVisible="{a:Binding IsRepeated}"
                         VerticalAlignment="Center" Margin="{a:DynamicResource AxSpaceLeadingThickness}"
                         a:ToolTip.Tip="{a:Binding RepeatsText}"/>

              </a:Grid>
            </a:DataTemplate>
          </AxListBox.ItemTemplate>
        </AxListBox>

        <a:TextBlock x:Name="Empty" AxText.Tone="Secondary" TextAlignment="Center"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </a:Panel>

      <!--
          Подробности занимают треть панели, а не заданное число пикселей:
          панель дока бывает невысокой, и полтораста пикселей съедали бы её
          целиком — список пропадал бы с глаз. Дальше долю правит человек:
          выше стоит AxSplitter, и прячется он вместе с подробностями —
          граница, которой не с чем граничить, ничего не разделяет.
      -->
      <AxSplitter x:Name="Handle" a:Grid.Row="1" Orientation="Horizontal" IsVisible="False"
                  a:AutomationProperties.Name="{Text console.details}"/>

      <!--
          Своей линии сверху у подробностей нет: прямо над ними стоит AxSplitter, и линию рисует
          он. Две линии в трёх пикселях друг от друга читались канавкой, и чем крупнее масштаб
          экрана, тем заметнее: рамка при 150 % толщиной в два пикселя, разделитель — в один.
      -->
      <a:Border x:Name="DetailsPane" a:Grid.Row="2" IsVisible="False">
        <!--
            Своего минимума высоты у поля здесь нет: многострочному полю его
            даёт тема — четыре строки, — а высоту подробностей решает граница,
            которую тянет человек. С минимумом поле переставало помещаться в
            отведённую долю и вылезало за нижний край панели.
        -->
        <AxTextArea x:Name="DetailsText" MinHeight="0" IsReadOnly="True" AcceptsReturn="True"
                    TextWrapping="NoWrap" BorderThickness="0"
                    FontFamily="{a:DynamicResource AxFontFamilyMono}"
                    FontSize="{a:DynamicResource AxFontSizeSmall}"
                    a:AutomationProperties.Name="{Text console.details}"/>
      </a:Border>

    </a:Grid>

  </a:DockPanel>

</AxUserControl>
