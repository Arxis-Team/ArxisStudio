{
  "id": "arxis.sample",
  "name": "%panel.sample%",
  "version": "2.0.0",
  "publisher": "Arxis",
  "description": "%module.sample.description%",
  "tags": [ "sample" ],
  "dependencies": [
    { "id": "arxis.projects", "min": "1.0", "optional": true }
  ],
  "contributions": {
    "commands": [
      { "id": "sample.about", "icon": "arxis:Info" },
      { "id": "sample.verbose", "icon": "arxis:Terminal" }
    ],
    "menus": [
      { "path": "%menu.tools%/%menu.sample%/%menu.sample.about%", "command": "sample.about" }
    ],
    "toolWindows": [
      { "id": "sample.panel", "title": "%panel.sample%", "icon": "arxis:Component", "placement": { "side": "left", "size": 0.22 } }
    ],
    "toolBar": [
      { "id": "sample.verbose", "kind": "button", "slot": "left", "command": "sample.verbose",
        "title": "%toolbar.sample.verbose%" }
    ]
  },
  "activation": [ "onStartup" ]
}
