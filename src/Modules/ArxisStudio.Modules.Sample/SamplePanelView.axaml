<!--
    Панель примера — разметкой, а не кодом: модуль живёт тем же контрактом,
    что и внешний плагин, и показывает, как этот контракт пишется.

    По умолчанию словарь студии: контрол без префикса — контрол студии. Всё
    родное Avalonia пишется через a: — и раскладка, и привязка, — так видно,
    чего в наборе Ax* ещё нет.

    Подписи — из словаря через {Text}, а не строками на месте: образец со
    вшитой строкой учил бы, что так и надо, а в английской студии панель
    говорила бы по-русски. Текст из словаря переводится вместе со студией, без
    перезагрузки панели.
-->
<AxUserControl xmlns="https://github.com/Arxis-Team/ArxisStudio"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:a="https://github.com/avaloniaui"
               xmlns:vm="using:ArxisStudio.Modules.Sample"
               x:Class="ArxisStudio.Modules.Sample.SamplePanelView"
               x:DataType="vm:SamplePanelModel">

  <a:StackPanel Spacing="{a:DynamicResource AxGapFormRow}" Margin="{a:DynamicResource AxSpaceWideThickness}" VerticalAlignment="Top">
    <a:TextBlock Text="{Text module.sample.heading}" TextWrapping="Wrap"/>
    <a:TextBlock Text="{Text module.sample.manifest}" TextWrapping="Wrap"/>
    <a:TextBlock Text="{Text module.sample.loadcontext}" TextWrapping="Wrap"/>

    <!--
        Проект: подпись из словаря, имя — из модели. Модель говорит, когда
        проект открыли или закрыли, и строка идёт за ним.

        Подпись и значение переносятся целиком, а не делят строку. В доке
        значению доставался остаток рядом с подписью, и в узкой панели «не
        открыт» рвалось по буквам в полоске шириной в две буквы, хотя под
        подписью помещалось целым. Значение длиннее всей ширины переносится по
        словам уже в ней.
    -->
    <a:WrapPanel>
      <a:TextBlock Text="{Text module.sample.project.label}"
                   Margin="{a:DynamicResource AxSpaceSnugTrailingThickness}"/>
      <a:TextBlock Text="{a:Binding ProjectName}" TextWrapping="Wrap" IsVisible="{a:Binding HasProject}"/>
      <a:TextBlock Classes="dim" Text="{Text module.sample.project.none}" TextWrapping="Wrap"
                   IsVisible="{a:Binding !HasProject}"/>
    </a:WrapPanel>

    <AxButton Content="{Text module.sample.log}" HorizontalAlignment="Left" Click="OnLogClick"/>
  </a:StackPanel>

</AxUserControl>
