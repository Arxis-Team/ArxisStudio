<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Пример встроенного модуля: панель, команда и служба — тем же контрактом,
        каким живёт внешний плагин. Ссылок ему хватает тех же, что и плагину:
        SDK и библиотека контролов. На саму студию модуль не ссылается —
        всё, что ему нужно, приходит службами контекста.
    -->
    <PropertyGroup>
        <RootNamespace>ArxisStudio.Modules.Sample</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../ArxisStudio.Sdk/ArxisStudio.Sdk.csproj"/>
        <ProjectReference Include="../../../external/ArxisStudio.Controls/src/ArxisStudio.Controls.csproj"/>
    </ItemGroup>

    <!--
        Манифест едет внутри сборки: своей папки у встроенного модуля нет, а
        формат тот же, что у внешнего плагина, — один разбор на оба случая.
    -->
    <ItemGroup>
        <EmbeddedResource Include="module.json"/>
    </ItemGroup>

</Project>
