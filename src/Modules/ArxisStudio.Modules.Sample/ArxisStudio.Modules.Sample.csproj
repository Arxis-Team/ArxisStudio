<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Пример встроенного модуля: панель, команда и служба — тем же контрактом,
        каким живёт внешний плагин. Ссылок ему хватает тех же, что и плагину:
        SDK, библиотека контролов и контракт соседа, у которого он берёт
        службу, — здесь службы проектов. На саму студию модуль не ссылается —
        всё, что ему нужно, приходит службами контекста.
    -->
    <PropertyGroup>
        <RootNamespace>ArxisStudio.Modules.Sample</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../ArxisStudio.Sdk/ArxisStudio.Sdk.csproj"/>
        <ProjectReference Include="../../../external/ArxisStudio.Controls/src/ArxisStudio.Controls.csproj"/>

        <!--
            Контракт соседа — только для компиляции: возит его владелец, модуль «Проекты», который
            объявил его в своём манифесте. Так же подключает чужой контракт и плагин, и правило это
            не вкусовое — контракт обязан быть одной сборкой на всех, иначе тип из второй копии
            окажется другим типом, и приведение упадёт у того, кто службу берёт.
        -->
        <ProjectReference Include="../ArxisStudio.Projects.Contracts/ArxisStudio.Projects.Contracts.csproj"
                          Private="false" ExcludeAssets="runtime"/>
    </ItemGroup>

    <!--
        Анализатор — отдельной строкой, как и у плагина: через цепочку
        ProjectReference анализаторы не передаются. Правила у модуля и у
        плагина одни, и проверяться они должны одинаково — иначе код,
        переносимый между режимами, менял бы смысл при переносе.
    -->
    <ItemGroup>
        <ProjectReference Include="../../ArxisStudio.Sdk.Analyzers/ArxisStudio.Sdk.Analyzers.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <!--
        Манифест — входом сборки: по нему ARX0002 сверяет %ключи% со словарём модуля.
        Сам словарь подаёт общий src/Modules/Directory.Build.targets, одним правилом на все модули.
    -->
    <ItemGroup>
        <AdditionalFiles Include="module.json"/>
    </ItemGroup>

</Project>
