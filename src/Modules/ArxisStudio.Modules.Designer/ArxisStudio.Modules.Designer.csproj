<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Дизайнер форм — встроенный модуль: тот же SDK-контракт, что у внешних
        плагинов, но прямые ссылки и основной контекст загрузки. Тяжёлые
        библиотеки — разметка, модель решения, канва — модулю можно, потому что
        он приезжает вместе со студией; внешнему плагину их бы пришлось везти
        с собой.
    -->
    <PropertyGroup>
        <RootNamespace>ArxisStudio.Modules.Designer</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
        <PackageReference Include="Avalonia.AvaloniaEdit"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../ArxisStudio.Sdk/ArxisStudio.Sdk.csproj"/>
        <ProjectReference Include="../../ArxisStudio.Extensibility/ArxisStudio.Extensibility.csproj"/>
        <ProjectReference Include="../../ArxisStudio.Shell/ArxisStudio.Shell.csproj"/>
        <ProjectReference Include="../../../external/ArxisStudio.Controls/src/ArxisStudio.Controls.csproj"/>
        <ProjectReference Include="../../../external/ArxisStudio.ProjectSystem/src/ArxisStudio.ProjectSystem.Markup.Xaml/ArxisStudio.ProjectSystem.Markup.Xaml.csproj"/>
        <ProjectReference Include="../../../external/ArxisStudio.Markup/src/ArxisStudio.Markup.Xaml.Design/ArxisStudio.Markup.Xaml.Design.csproj"/>
        <ProjectReference Include="../../../external/ArxisStudio.DesignEditor/src/ArxisStudio.DesignEditor.csproj"/>
    </ItemGroup>

    <!-- Манифест модуля живёт в сборке: своей папки у модуля нет. -->
    <ItemGroup>
        <EmbeddedResource Include="module.json"/>
    </ItemGroup>

    <!-- Внутренности документа читают тесты студии. -->
    <ItemGroup>
        <InternalsVisibleTo Include="ArxisStudio.Tests"/>
        <InternalsVisibleTo Include="ArxisStudio"/>
    </ItemGroup>

</Project>
