<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Дизайнер интерфейса: доска форм решения и живая вкладка формы. Формы — файлы .axaml открытого
        решения — стоят карточками на холсте ядра Surface: панорама, зум, сетка, выделение, тяга и отмена —
        его, а что лежит на холсте и где, решает модуль. Вкладка формы стоит на дизайнере Surface.UiDesigner
        и на службе XAML: живой документ, его корень и правка — её, а модуль переводит жесты холста в
        правку текста. Без службы вкладка показывает рамку формы, как прежде.

        Зависимости внутри модуля идут в одну сторону: Model (снимок → формы, раскладка, файл доски;
        без Avalonia) → Board (карточки, состояние доски, тема и органы холста, меню) → Panels (доска) и
        Documents (вкладка одной формы — редактор документов режима вкладок). Модель проверяется без окна,
        доска — без студии.
    -->
    <PropertyGroup>
        <RootNamespace>ArxisStudio.Modules.UiDesigner</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../ArxisStudio.Sdk/ArxisStudio.Sdk.csproj"/>
        <ProjectReference Include="../../../external/ArxisStudio.Controls/src/ArxisStudio.Controls.csproj"/>

        <!--
            Холст — свои сборки модуля: едут в его bin, как пакеты у терминала. Ядро держит доску,
            инструменты (ручки, привязка, направляющие) и дизайнер — вкладку формы. Редактор узлов не
            подключается: он не о формах. Avalonia.Skia, которую ядро тянет, студия везёт в lib/, и в
            папку модуля она не ложится.
        -->
        <ProjectReference Include="../../../external/ArxisStudio.Surface/src/Surface/ArxisStudio.Surface.csproj"/>
        <ProjectReference Include="../../../external/ArxisStudio.Surface/src/Surface.Editing/ArxisStudio.Surface.Editing.csproj"/>
        <ProjectReference Include="../../../external/ArxisStudio.Surface/src/Surface.UiDesigner/ArxisStudio.Surface.UiDesigner.csproj"/>

        <!--
            Контракт соседа — только для компиляции: возит его владелец, модуль «Проекты». Копия в
            своей папке дала бы вторую сборку того же контракта, и AXL1002 не дал бы собрать студию.
        -->
        <ProjectReference Include="../ArxisStudio.Projects.Contracts/ArxisStudio.Projects.Contracts.csproj"
                          Private="false" ExcludeAssets="runtime"/>
        <ProjectReference Include="../ArxisStudio.Xaml.Contracts/ArxisStudio.Xaml.Contracts.csproj"
                          Private="false" ExcludeAssets="runtime"/>
    </ItemGroup>

    <!--
        Анализатор — отдельной строкой, как и у плагина: через цепочку ProjectReference анализаторы
        не передаются.
    -->
    <ItemGroup>
        <ProjectReference Include="../../ArxisStudio.Sdk.Analyzers/ArxisStudio.Sdk.Analyzers.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <!-- Манифест — входом сборки: по нему ARX0002 сверяет %ключи% со словарём модуля. -->
    <ItemGroup>
        <AdditionalFiles Include="module.json"/>
    </ItemGroup>

    <!-- Тестам открыты модель и склейка доски: проверяется поведение, а не разметка. -->
    <ItemGroup>
        <InternalsVisibleTo Include="ArxisStudio.Tests"/>
    </ItemGroup>

</Project>
