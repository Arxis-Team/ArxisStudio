<!--
    Иерархия формы впереди: элементы её документа деревом, как Document Outline у Visual Studio и
    Hierarchy у Unity. Строка — тип, как его написал документ, и имя рядом вторичным тоном.

    Выбор у иерархии и холста один: щелчок по строке выбирает элемент на холсте и отмечает его в XAML, а
    выбранное на холсте выбирает строку и раскрывает дорогу к ней. Ctrl и Shift добавляют к выбору, как в
    списке. Delete убирает выбранное из документа, Ctrl+стрелка вверх и вниз переставляет среди соседей —
    клавиатурная дорога вместо тяги.
-->
<AxUserControl xmlns="https://github.com/Arxis-Team/ArxisStudio"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:a="https://github.com/avaloniaui"
               xmlns:w="using:ArxisStudio.Modules.UiDesigner.Workbench"
               x:Class="ArxisStudio.Modules.UiDesigner.Panels.HierarchyView">

  <a:Panel>

    <AxTreeView x:Name="Tree" SelectionMode="Multiple"
                a:AutomationProperties.Name="{Text panel.hierarchy}">
      <AxTreeView.Styles>
        <a:Style Selector="AxTreeViewItem" x:DataType="w:HierarchyNode">
          <a:Setter Property="IsExpanded" Value="{a:Binding IsExpanded, Mode=TwoWay}"/>
          <a:Setter Property="a:AutomationProperties.Name" Value="{a:Binding Label}"/>
        </a:Style>
      </AxTreeView.Styles>
      <AxTreeView.ItemTemplate>
        <a:TreeDataTemplate x:DataType="w:HierarchyNode" ItemsSource="{a:Binding Children}">
          <a:StackPanel Orientation="Horizontal" Spacing="{a:DynamicResource AxGapIconText}">
            <a:TextBlock Text="{a:Binding Type}"/>
            <a:TextBlock Text="{a:Binding Name}" IsVisible="{a:Binding HasName}" AxText.Tone="Secondary"/>
          </a:StackPanel>
        </a:TreeDataTemplate>
      </AxTreeView.ItemTemplate>
    </AxTreeView>

    <a:TextBlock x:Name="Empty" Text="{Text hierarchy.empty}" AxText.Tone="Secondary" TextWrapping="Wrap"
                 TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Margin="{a:DynamicResource AxSpaceWideThickness}"/>

  </a:Panel>

</AxUserControl>
