<!--
    Доска форм: полоса действий и холст дизайнера с формами решения — живыми, как во вкладке.

    Холст — дизайнер Surface.UiDesigner: форма на нём — элемент формы своего размера с именем над ним, и
    правят её прямо здесь — выбирают, двигают, тянут за ручки, удаляют, — как во вкладке; целиком форму
    берут за имя. Форма на виду встаёт живой, а пока не встала, вне вида и когда её держит вкладка, на её
    месте стоит снимок. Сама форма — данные, а не контейнер: место холст читает привязкой
    ItemLocationBinding.

    Тему дизайнера доска подключает своими ресурсами: контролы Surface носят свои ControlTheme, и найти
    их студия может только здесь. Кисти ядра доска заменяет токенами палитры кодом (CanvasLooks).

    Форма на холсте своей жизнью не живёт: кнопка формы не берёт нажатие, поле — каретку. Ввод ей гасит
    доска — тем же стилем, что вкладка.

    Над холстом, как у вкладки, — чип состояния типов проекта и баннеры: вопрос о чужой записи и одно
    сообщение, самое важное, о типах проекта и о форме, с которой работают.

    Состояния — решение не открыто, открывается, не открылось, форм нет — лежат поверх холста, а не
    подменяют его, как у окна проекта.

    Сцена — холст вместе с состояниями — цель перетаскивания студии: на неё несут файлы форм из окна
    проекта. Целью объявлена сцена, а не холст: над доской, где убрано всё, курсор стоит над надписью
    состояния, и холст под ней целью бы не нашёлся. Куда встанет несомое, показывают заготовки форм в
    слое над холстом; состояния на это время прячутся.
-->
<AxUserControl xmlns="https://github.com/Arxis-Team/ArxisStudio"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:a="https://github.com/avaloniaui"
               xmlns:ax="https://github.com/Arxis-Team/ArxisStudio"
               xmlns:s="https://github.com/Arxis-Team/ArxisStudio.Surface"
               xmlns:b="using:ArxisStudio.Modules.UiDesigner.Board"
               x:Class="ArxisStudio.Modules.UiDesigner.Panels.BoardView"
               x:DataType="b:BoardModel">

  <AxUserControl.Resources>
    <a:ResourceDictionary>
      <a:ResourceDictionary.MergedDictionaries>
        <a:ResourceInclude Source="avares://ArxisStudio.Surface.UiDesigner/Themes/UiDesignerTheme.axaml"/>
      </a:ResourceDictionary.MergedDictionaries>
    </a:ResourceDictionary>
  </AxUserControl.Resources>

  <AxUserControl.Styles>
    <!--
        Ввод форме гасится так же, как во вкладке: попадание и обход Tab — эта запись, программный фокус —
        сама доска. Выбирать это не мешает — ядро ищет выбранное по прямоугольникам.
    -->
    <a:Style Selector="s|UiDesignerFormItem /template/ a|Decorator#PART_FormHost">
      <a:Setter Property="IsHitTestVisible" Value="False"/>
      <a:Setter Property="a:KeyboardNavigation.TabNavigation" Value="None"/>
    </a:Style>

    <!--
        Заготовка — цель перетаскивания языком дизайн-системы: заливка сообщения и кольцо акцента, как у
        строки, в которую ляжет несомое. Снимок формы, если он есть, — поверх заливки.
    -->
    <a:Style Selector="a|Border.landing">
      <a:Setter Property="Background" Value="{a:DynamicResource AxInfoFillBrush}"/>
      <a:Setter Property="BorderBrush" Value="{a:DynamicResource AxAccentBrush}"/>
    </a:Style>
  </AxUserControl.Styles>

  <a:DockPanel>

    <!--
        Полоса: слева — чип состояния типов проекта, как у вкладки; справа — режим дизайнера и органы
        холста, как полоса вида Scene в Unity. Режим стоит первым и отделён чертой: он решает, как
        открываются формы, а кнопки за чертой работают с этим холстом.
    -->
    <a:Border a:DockPanel.Dock="Top" Padding="{a:DynamicResource AxToolBarPadding}">
      <a:Grid ColumnDefinitions="*,Auto">

        <a:StackPanel a:Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                      Spacing="{a:DynamicResource AxGapIconText}">
          <AxSpinner x:Name="Busy" IsVisible="False" VerticalAlignment="Center"/>
          <AxChip x:Name="State" IsVisible="False" VerticalAlignment="Center"/>
        </a:StackPanel>

        <a:StackPanel a:Grid.Column="1" Orientation="Horizontal" Spacing="{a:DynamicResource AxSpaceHair}"
                      HorizontalAlignment="Right" VerticalAlignment="Center">

          <AxSpinner IsVisible="{a:Binding IsLoading}" VerticalAlignment="Center"
                     a:ToolTip.Tip="{Text board.loading}"
                     a:AutomationProperties.Name="{Text board.loading}"/>

          <!--
              Режим — парой переключателей, как «редактор, предпросмотр» в Rider: видны оба режима и какой
              из них включён. Сегментный переключатель темы для полосы высок — он ростом с поле ввода.
          -->
          <AxToggleButton x:Name="BoardMode" Appearance="Toolbar"
                          a:ToolTip.Tip="{Text board.mode.board}"
                          a:AutomationProperties.Name="{Text board.mode.board}">
            <AxIcon Data="{x:Static ax:AxIcons.Dashboard}"/>
          </AxToggleButton>

          <AxToggleButton x:Name="TabsMode" Appearance="Toolbar"
                          a:ToolTip.Tip="{Text board.mode.tabs}"
                          a:AutomationProperties.Name="{Text board.mode.tabs}">
            <AxIcon Data="{x:Static ax:AxIcons.Tabs}"/>
          </AxToggleButton>

          <AxDivider Orientation="Vertical" Classes="toolbar"/>

          <AxButton x:Name="Fit" Appearance="Toolbar" IsEnabled="{a:Binding HasCards}"
                    a:ToolTip.Tip="{Text board.fit}"
                    a:AutomationProperties.Name="{Text board.fit}">
            <AxIcon Data="{x:Static ax:AxIcons.FitToScreen}"/>
          </AxButton>

          <!--
              Масштаб словами — он же кнопка «100 %», как в Figma и Unity. Не квадрат полосы: тот под
              одну иконку, и «100 %» в нём обрезалось бы до «1…».
          -->
          <AxButton x:Name="Actual" Appearance="Subtle" Size="Compact" VerticalAlignment="Center"
                    IsEnabled="{a:Binding HasCards}"
                    a:ToolTip.Tip="{Text board.actual}"
                    a:AutomationProperties.Name="{Text board.actual}"/>

          <AxButton x:Name="ArrangeAll" Appearance="Toolbar" IsEnabled="{a:Binding HasCards}"
                    a:ToolTip.Tip="{Text board.arrange}"
                    a:AutomationProperties.Name="{Text board.arrange}">
            <AxIcon Data="{x:Static ax:AxIcons.Grid}"/>
          </AxButton>

          <AxToggleButton x:Name="GridToggle" Appearance="Toolbar"
                          a:ToolTip.Tip="{Text board.grid}"
                          a:AutomationProperties.Name="{Text board.grid}">
            <AxIcon Data="{x:Static ax:AxIcons.GridSnap}"/>
          </AxToggleButton>

        </a:StackPanel>

      </a:Grid>
    </a:Border>

    <AxDivider a:DockPanel.Dock="Top"/>

    <a:StackPanel a:DockPanel.Dock="Top">

      <AxBanner x:Name="Conflict" Severity="Warning" IsVisible="False">
        <AxBanner.Actions>
          <a:StackPanel Orientation="Horizontal" Spacing="{a:DynamicResource AxSpaceHair}">
            <AxButton x:Name="TakeTheirs" Appearance="Subtle" Size="Compact" Content="{Text form.conflict.theirs}"/>
            <AxButton x:Name="KeepMine" Appearance="Subtle" Size="Compact" Content="{Text form.conflict.mine}"/>
          </a:StackPanel>
        </AxBanner.Actions>
        <a:TextBlock x:Name="ConflictText" TextWrapping="Wrap"/>
      </AxBanner>

      <AxBanner x:Name="Notice" Severity="Warning" IsVisible="False">
        <AxBanner.Actions>
          <AxButton x:Name="Rebuild" Appearance="Subtle" Size="Compact" Content="{Text form.rebuild}"
                    IsVisible="False"/>
        </AxBanner.Actions>
        <a:TextBlock x:Name="NoticeText" TextWrapping="Wrap"/>
      </AxBanner>

    </a:StackPanel>

    <a:Panel x:Name="Stage" StudioDragDrop.AllowDrop="True">

      <b:FormsSheet x:Name="Sheet"
                    ItemsSource="{a:Binding Cards}"
                    ItemLocationBinding="{a:Binding Location}"
                    SelectionMode="Multiple"
                    SimplifiedZoom="0"
                    Focusable="True"
                    IsVisible="{a:Binding IsReady}"
                    a:AutomationProperties.Name="{Text panel.board}"/>

      <a:Panel x:Name="States">

        <a:StackPanel IsVisible="{a:Binding IsClosed}" Spacing="{a:DynamicResource AxGapFormRow}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Margin="{a:DynamicResource AxSpaceWideThickness}">
          <a:TextBlock Text="{Text board.state.closed}" AxText.Tone="Secondary" HorizontalAlignment="Center"/>
          <a:TextBlock Text="{Text board.state.closed.hint}" AxText.Role="Small" AxText.Tone="Tertiary"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
        </a:StackPanel>

        <a:TextBlock IsVisible="{a:Binding IsNoService}" Text="{Text board.state.noService}"
                     AxText.Tone="Secondary" HorizontalAlignment="Center" VerticalAlignment="Center"
                     TextWrapping="Wrap" TextAlignment="Center" Margin="{a:DynamicResource AxSpaceWideThickness}"/>

        <a:StackPanel IsVisible="{a:Binding IsOpening}" Orientation="Horizontal" Spacing="{a:DynamicResource AxGapIconText}"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
          <AxSpinner VerticalAlignment="Center"/>
          <a:TextBlock Text="{a:Binding Opening}" AxText.Tone="Secondary" VerticalAlignment="Center"/>
        </a:StackPanel>

        <a:StackPanel IsVisible="{a:Binding IsFailed}" Spacing="{a:DynamicResource AxGapFormRow}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Margin="{a:DynamicResource AxSpaceWideThickness}">
          <a:TextBlock Text="{Text board.state.failed}" AxText.Tone="Secondary" HorizontalAlignment="Center"/>
          <a:TextBlock Text="{a:Binding Failure}" AxText.Role="Small" AxText.Tone="Error"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
        </a:StackPanel>

        <!-- Решение открыто, а форм нет: холст под надписью остаётся — на нём просто ничего не стоит. -->
        <a:StackPanel IsVisible="{a:Binding IsEmpty}" Spacing="{a:DynamicResource AxGapFormRow}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                      Margin="{a:DynamicResource AxSpaceWideThickness}">
          <a:TextBlock Text="{Text board.state.empty}" AxText.Tone="Secondary" HorizontalAlignment="Center"/>
          <a:TextBlock Text="{Text board.state.empty.hint}" AxText.Role="Small" AxText.Tone="Tertiary"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
        </a:StackPanel>

        <!--
            Все формы убраны: холст пуст не потому, что форм нет, — и сказать это надо прямо, а вернуть их
            одной кнопкой, не отправляя человека искать меню холста.
        -->
        <a:StackPanel IsVisible="{a:Binding IsAllRemoved}" Spacing="{a:DynamicResource AxGapFormRow}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Margin="{a:DynamicResource AxSpaceWideThickness}">
          <a:TextBlock Text="{Text board.state.allRemoved}" AxText.Tone="Secondary" HorizontalAlignment="Center"/>
          <a:TextBlock Text="{Text board.state.allRemoved.hint}" AxText.Role="Small" AxText.Tone="Tertiary"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
          <AxButton x:Name="ReturnAll" Content="{Text board.return.all}" HorizontalAlignment="Center"/>
        </a:StackPanel>

      </a:Panel>

      <!--
          Заготовки форм, пока над доской несут формы: в масштабе холста и там, куда они встанут. Мышь слой
          не ловит — иначе под курсором всегда была бы заготовка, а не доска.
      -->
      <a:Canvas x:Name="Preview" IsHitTestVisible="False" ClipToBounds="True"/>

    </a:Panel>

  </a:DockPanel>

</AxUserControl>
