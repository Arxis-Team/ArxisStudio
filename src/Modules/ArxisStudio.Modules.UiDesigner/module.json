{
  "id": "arxis.ui-designer",
  "name": "%module.uiDesigner%",
  "version": "0.3.0",
  "publisher": "Arxis",
  "description": "%module.uiDesigner.description%",
  "tags": [ "tools", "design" ],
  "dependencies": [
    { "id": "arxis.projects", "min": "1.6", "optional": true },
    { "id": "arxis.xaml", "min": "1.0", "optional": true }
  ],
  "contributions": {
    "commands": [
      { "id": "ui-designer.show", "title": "%command.board.show%", "icon": "arxis:Window" }
    ],
    "toolWindows": [
      { "id": "ui-designer.board", "title": "%panel.board%", "icon": "arxis:Window",
        "placement": { "side": "center" } }
    ],
    "settings": [
      { "key": "ui-designer.grid", "type": "bool", "scope": "user", "title": "%settings.board.grid%", "default": true },
      { "key": "ui-designer.tabs", "type": "bool", "scope": "user", "title": "%settings.board.tabs%", "default": true },
      { "key": "ui-designer.autoSave", "type": "bool", "scope": "user", "title": "%settings.form.autoSave%", "default": true },
      { "key": "ui-designer.view", "type": "string", "scope": "user", "title": "%settings.form.view%", "default": "split" },
      { "key": "ui-designer.previews", "type": "bool", "scope": "user", "title": "%settings.form.previews%", "default": true }
    ]
  },
  "activation": [ "onStartup" ]
}
