<!--
    Стили каркаса студии: тема StudioShell и сплиттеры зон. Подключается
    приложением после ArxisTheme:  <shell:ShellStyles/>
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ArxisStudio.Shell.ShellStyles"
        xmlns:sh="using:ArxisStudio.Shell">

  <Styles.Resources>
    <ResourceDictionary>

      <!--
          Раскладка: тулбар / [левая зона | центр (+нижняя зона) | правая зона] / статус-бар.
          Сплиттеры сидят в колонках и строках шириной 1px, а их хит-зона 7px
          нарисована поверх соседей (Grid не клипует детей) — линия остаётся
          однопиксельной, как в мокапе, но за неё можно взяться мышью.
      -->
      <ControlTheme x:Key="{x:Type sh:StudioShell}" TargetType="sh:StudioShell">
        <Setter Property="Background" Value="{DynamicResource AxBg1Brush}"/>
        <Setter Property="Template">
          <ControlTemplate>
            <DockPanel Background="{TemplateBinding Background}">
              <Border DockPanel.Dock="Top"
                      Background="{DynamicResource AxBg2Brush}"
                      BorderBrush="{DynamicResource AxBrdBrush}"
                      BorderThickness="0,0,0,1"
                      IsVisible="{TemplateBinding TopBar, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ContentPresenter Content="{TemplateBinding TopBar}"/>
              </Border>
              <Border DockPanel.Dock="Bottom"
                      Background="{DynamicResource AxBg2Brush}"
                      BorderBrush="{DynamicResource AxBrdBrush}"
                      BorderThickness="0,1,0,0"
                      IsVisible="{TemplateBinding StatusBar, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ContentPresenter Content="{TemplateBinding StatusBar}"/>
              </Border>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="262" MinWidth="180"/>
                  <ColumnDefinition Width="1"/>
                  <ColumnDefinition Width="*" MinWidth="320"/>
                  <ColumnDefinition Width="1"/>
                  <ColumnDefinition Width="302" MinWidth="220"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource AxBg2Brush}">
                  <ContentPresenter Content="{TemplateBinding LeftPane}"/>
                </Border>

                <Grid Grid.Column="2">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="200"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="212" MinHeight="100"/>
                  </Grid.RowDefinitions>
                  <ContentPresenter Grid.Row="0" Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"/>
                  <Border Grid.Row="2" Background="{DynamicResource AxBg2Brush}">
                    <ContentPresenter Content="{TemplateBinding BottomPane}"/>
                  </Border>
                  <GridSplitter Grid.Row="1" Classes="shell-h" ResizeDirection="Rows"/>
                </Grid>

                <Border Grid.Column="4" Background="{DynamicResource AxBg2Brush}">
                  <ContentPresenter Content="{TemplateBinding RightPane}"/>
                </Border>

                <GridSplitter Grid.Column="1" Classes="shell-v" ResizeDirection="Columns"/>
                <GridSplitter Grid.Column="3" Classes="shell-v" ResizeDirection="Columns"/>
              </Grid>
            </DockPanel>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

    </ResourceDictionary>
  </Styles.Resources>

  <!-- Сплиттер зон: линия 1px, хит-зона 7px поверх соседей. -->
  <Style Selector="GridSplitter.shell-v">
    <Setter Property="Width" Value="7"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent">
          <Border Width="1" Background="{DynamicResource AxBrdBrush}" HorizontalAlignment="Center"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="GridSplitter.shell-h">
    <Setter Property="Height" Value="7"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent">
          <Border Height="1" Background="{DynamicResource AxBrdBrush}" VerticalAlignment="Center"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- Заголовок tool window: 34px, жирный 12px, разделитель снизу. -->
  <Style Selector="Border.tool-window-header">
    <Setter Property="Height" Value="34"/>
    <Setter Property="Padding" Value="12,0,8,0"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AxBrdBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>
  <Style Selector="Border.tool-window-header TextBlock.title">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

</Styles>
