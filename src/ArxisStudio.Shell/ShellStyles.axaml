<!--
    Стили каркаса студии: тема StudioShell и общие мелочи экранов.
    Подключается приложением после ArxisTheme:  <shell:ShellStyles/>
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ArxisStudio.Shell.ShellStyles"
        xmlns:ax="https://github.com/Arxis-Team/ArxisStudio">

  <Styles.Resources>
    <ResourceDictionary>

      <!--
          Раскладка: тулбар / рабочая область / статус-бар. Середину каркас
          отдаёт целиком: что там за дерево доков и какой ширины его области,
          он не знает и знать не должен.
      -->
      <ControlTheme x:Key="{x:Type ax:StudioShell}" TargetType="ax:StudioShell">
        <Setter Property="Background" Value="{DynamicResource AxSurfaceBaseBrush}"/>
        <Setter Property="Template">
          <ControlTemplate>
            <DockPanel Background="{TemplateBinding Background}">
              <Border DockPanel.Dock="Top"
                      Background="{DynamicResource AxSurfacePanelBrush}"
                      BorderBrush="{DynamicResource AxStrokeSubtleBrush}"
                      BorderThickness="0,0,0,1"
                      IsVisible="{TemplateBinding TopBar, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ContentPresenter Content="{TemplateBinding TopBar}"/>
              </Border>
              <Border DockPanel.Dock="Bottom"
                      Background="{DynamicResource AxSurfacePanelBrush}"
                      BorderBrush="{DynamicResource AxStrokeSubtleBrush}"
                      BorderThickness="0,1,0,0"
                      IsVisible="{TemplateBinding StatusBar, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ContentPresenter Content="{TemplateBinding StatusBar}"/>
              </Border>
              <ContentPresenter Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"/>
            </DockPanel>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

    </ResourceDictionary>
  </Styles.Resources>

  <!-- Строка навигации: 30px, выбранная — заливка выделения и полужирный текст. -->
  <!--
      Значок у каждого окна студии — стилем, а не атрибутом в разметке окна.
      Окон много: заставка, приветствие, главное, настройки, оторванные панели,
      диалоги плагинов. Забытое окно показало бы в панели задач родовой значок
      .NET, а стиль не забывает никого — и окно плагина, о котором студия ничего
      не знает, тоже.
  -->
  <Style Selector=":is(Window)">
    <Setter Property="Icon" Value="avares://ArxisStudio.Shell/Assets/arxis.ico"/>
  </Style>

  <!--
      Подпись зависимости плагина: обычная — приглушённо, проблемная — цветом
      предупреждения для текста. Классом и стилем, а не преобразователем: тот
      брал кисть у темы один раз, в миг привязки, и после переключения темы чип
      оставался в прежней. Живой замер нашёл это как тёмный второстепенный
      на светлой плашке — 1,7:1. Стиль с динамическим ресурсом переключается
      сам.

      Предупреждение — AxWarningText, а не AxWarning: AxWarning — цвет заливки и
      значка, у текста своя пара, подобранная под порог.
  -->
  <Style Selector="ax|AxChip.dependency">
    <Setter Property="Foreground" Value="{DynamicResource AxTextSecondaryBrush}"/>
  </Style>
  <Style Selector="ax|AxChip.dependency.problem">
    <Setter Property="Foreground" Value="{DynamicResource AxWarningTextBrush}"/>
  </Style>

  <!--
      Пункт навигации Welcome: переключатель во всю ширину колонки, подпись слева.
      Шаблон свой — без кольца и рамки кнопки, — а включённость и наведение даёт тема
      переключателя.
  -->
  <Style Selector="ax|AxToggleButton.nav">
    <!-- Наименьшая: подпись растёт с кеглем темы, прибитая высота её срезала бы. -->
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Padding" Value="{DynamicResource AxSpaceWideSidesThickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadiusMedium}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource AxTextSecondaryBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSize}"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter x:Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          Padding="{TemplateBinding Padding}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ax|AxToggleButton.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AxHoverBrush}"/>
  </Style>
  <!--
      Выбранную строку тема переключателя кладёт на заливку выделения. Цвет подписи
      ставится здесь же, а не берётся у темы: стили приложения сильнее темы контрола,
      и второстепенный цвет строки выше перебил бы основной цвет включённой.
  -->
  <Style Selector="ax|AxToggleButton.nav:checked">
    <Setter Property="Foreground" Value="{DynamicResource AxTextPrimaryBrush}"/>
    <Setter Property="FontWeight" Value="Medium"/>
  </Style>

  <!--
      Разделитель полосы: 20 высотой и цветом нажатия, а не рамки, — так его
      рисует карточка «Toolbar», где он на ступень заметнее линий снаружи.
      Токена под эти двадцать в теме нет: число живёт в одной карточке.
  -->
  <Style Selector="ax|AxDivider.toolbar">
    <Setter Property="Height" Value="20"/>
    <Setter Property="Margin" Value="{DynamicResource AxSpaceHairSidesThickness}"/>
    <Setter Property="Fill" Value="{DynamicResource AxStrokeStrongBrush}"/>
  </Style>

  <!-- Кликабельная строка списка: подсветка под курсором. -->
  <Style Selector="Border.row">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Border.row:pointerover">
    <Setter Property="Background" Value="{DynamicResource AxSurfacePanelBrush}"/>
  </Style>

  <!--
      Строка в фокусе: по ней работают клавиши, и человек обязан видеть, на какой именно.
      Отдельно от подсветки под курсором — мышь и клавиатура могут указывать на разные строки.
  -->
  <Style Selector="Border.row:focus">
    <Setter Property="Background" Value="{DynamicResource AxSelectionActiveBrush}"/>
  </Style>

  <!--
      Строка настроек: 44 высотой. Разделители между строками ставит сама
      разметка — штатным AxDivider.
      Высота наименьшая: подпись и контрол в строке растут с кеглем темы.
  -->
  <Style Selector=":is(Panel).settings-row">
    <Setter Property="MinHeight" Value="44"/>
  </Style>
  <!--
      Подпись и контрол в строке настроек стоят по центру, а не тянутся во всю
      её высоту: строка 44, а поле, комбобокс и кнопка — свои 28 и 24. Ряд
      отдаёт частям всю высоту строки, и без этого комбобокс становился бы
      ростом со строку. Слева — чтобы контрол, перенесённый под подпись, стоял
      под ней, а не посреди строки: ширина у поля и комбобокса своя.
  -->
  <Style Selector=":is(Panel).settings-row > :is(Control)">
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>

  <!-- Ссылка и строка-ссылка. -->
  <Style Selector="TextBlock.link">
    <Setter Property="Foreground" Value="{DynamicResource AxLinkBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="TextBlock.link:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource AxLinkHoverBrush}"/>
  </Style>
  <Style Selector="Border.link-row">
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="Padding" Value="{DynamicResource AxSpaceWideSidesThickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadiusMedium}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Border.link-row:pointerover">
    <Setter Property="Background" Value="{DynamicResource AxHoverBrush}"/>
  </Style>

</Styles>
