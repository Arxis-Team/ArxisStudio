<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>ArxisStudio.Sdk</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <!--
        SDK — контракт, на который ссылаются плагины, поэтому здесь не должно
        появиться ни реализации студии, ни ссылок на её проекты. Библиотека
        контролов — исключение: интерфейс плагина строится только на Ax*, и
        ссылаться на неё плагин обязан в любом случае.
    -->
    <ItemGroup>
        <ProjectReference Include="../../external/ArxisStudio.Controls/src/ArxisStudio.Controls.csproj"/>
    </ItemGroup>

    <!--
        Анализатор едет вместе с SDK: правило «интерфейс плагина строится на
        Ax*» должно проверяться при сборке плагина, а не при взгляде на готовую
        панель. Сборкой он не является — плагину его не с чем связывать.
    -->
    <ItemGroup>
        <ProjectReference Include="../ArxisStudio.Sdk.Analyzers/ArxisStudio.Sdk.Analyzers.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

</Project>
