<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>ArxisStudio.Sdk</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <!--
        SDK — контракт, на который ссылаются плагины, поэтому здесь не должно
        появиться ни реализации студии, ни ссылок на её проекты. Библиотека
        контролов — исключение: интерфейс плагина строится только на Ax*, и
        ссылаться на неё плагин обязан в любом случае.
    -->
    <ItemGroup>
        <ProjectReference Include="../../external/ArxisStudio.Controls/src/ArxisStudio.Controls.csproj"/>
    </ItemGroup>

</Project>
