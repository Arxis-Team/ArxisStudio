<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Пример внешнего плагина: ссылается только на SDK, ничего не знает о
        самой студии и собирается в раскладку, которую студия умеет
        устанавливать, — plugin.json рядом с bin/.
    -->
    <PropertyGroup>
        <RootNamespace>Arxis.HelloPlugin</RootNamespace>
        <AssemblyName>Arxis.HelloPlugin</AssemblyName>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- Пример показывает готовый .axplugin, а не только папку. -->
        <AxPluginPack>true</AxPluginPack>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/ArxisStudio.Sdk/ArxisStudio.Sdk.csproj"/>
    </ItemGroup>

    <!--
        Анализатор SDK приходится подключать отдельно: через цепочку
        ProjectReference анализаторы не передаются — так умеют только пакеты.
        Плагину, поставленному пакетом SDK, эта строка не понадобится.
    -->
    <ItemGroup>
        <ProjectReference Include="../../src/ArxisStudio.Sdk.Analyzers/ArxisStudio.Sdk.Analyzers.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <!--
        Таргет упаковки тоже приходит вместе с SDK и тоже не передаётся через
        ProjectReference — импортируем строкой. С пакетом SDK он подхватится сам:
        оттого и лежит в папке build/.
    -->
    <Import Project="../../src/ArxisStudio.Sdk/build/ArxisStudio.Sdk.targets"/>

</Project>
