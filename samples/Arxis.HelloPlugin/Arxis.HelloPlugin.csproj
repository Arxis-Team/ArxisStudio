<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Пример внешнего плагина: ссылается только на SDK, ничего не знает о
        студии и собирается в раскладку, которую студия умеет устанавливать —
        plugin.json рядом с bin/.
    -->
    <PropertyGroup>
        <RootNamespace>Arxis.HelloPlugin</RootNamespace>
        <AssemblyName>Arxis.HelloPlugin</AssemblyName>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <OutputPath>$(MSBuildProjectDirectory)/package/bin/</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/ArxisStudio.Sdk/ArxisStudio.Sdk.csproj"/>
    </ItemGroup>

    <!--
        Анализатор SDK приходится подключать отдельно: через цепочку
        ProjectReference анализаторы не передаются — так умеют только пакеты.
        Плагину, поставленному пакетом SDK, эта строка не понадобится.
    -->
    <ItemGroup>
        <ProjectReference Include="../../src/ArxisStudio.Sdk.Analyzers/ArxisStudio.Sdk.Analyzers.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <!-- Манифест ложится рядом с bin/: package/ и есть папка плагина. -->
    <Target Name="CopyPluginManifest" AfterTargets="Build">
        <Copy SourceFiles="plugin.json" DestinationFolder="$(MSBuildProjectDirectory)/package/"/>
    </Target>

</Project>
